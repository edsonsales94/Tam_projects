User Function PLESTET5(aParam)
	Local aSay    := {}
	Local aButton := {}
	Local nOpc    := 0
	Local cPerg   := PADR("PLESTET5",Len(SX1->X1_GRUPO))
	Local cTitulo := "Gera etiquetas de lote"
	Local cDesc1  := "Essa rotina irá gerar as etiquetas de lote conforme "
	Local cDesc2  := "parâmetros informados pelo usuário referente a nota fiscal de entrada   "

	ValidPerg(cPerg)
	Pergunte(cPerg,.F.)

	If aParam == Nil
		aAdd( aSay, cDesc1 )
		aAdd( aSay, cDesc2 )

		aAdd( aButton, { 5, .T., {|x| Pergunte(cPerg)       }} )
		aAdd( aButton, { 1, .T., {|x| nOpc := 1, oDlg:End() }} )
		aAdd( aButton, { 2, .T., {|x| nOpc := 2, oDlg:End() }} )

		FormBatch( cTitulo, aSay, aButton )
	Else
		nOpc     := 1
		mv_par01 := aParam[1]
		mv_par02 := aParam[2]
		mv_par03 := aParam[3]
		mv_par04 := aParam[4]
		mv_par05 := aParam[5]
		mv_par06 := aParam[6]
		mv_par07 := aParam[7]
		mv_par08 := aParam[8]
		mv_par09 := aParam[9]
		mv_par10 := aParam[10]
		mv_par11 := aParam[11]
	Endif

	If nOpc == 1
		Processa( {|| FGeraEtiqueta() } , "Gerando etiquetas ")
		//Processa( {|| PrintLabel("00101001","111222333","1  ","PELMEX-PROD","TESTE DE ETIQUETA",2,3) } , "Gerando etiquetas ")
	Endif

Return

Static Function FGeraEtiqueta()
	Local nI, cQry
	Local cTable := getNextAlias()

	If mv_par07 == 1   // Se for impresso apartir da Nota Fiscal
		cQry := " SELECT SD1.*"
		cQry += " FROM "+RetSQLName("SD1")+" SD1"
		cQry += " WHERE SD1.D_E_L_E_T_ = ' '"
		cQry += " AND SD1.D1_FORNECE >= '"+mv_par01+"'"
		cQry += " AND SD1.D1_FORNECE <= '"+mv_par02+"'"
		cQry += " AND SD1.D1_DOC >= '"+mv_par03+"'"
		cQry += " AND SD1.D1_DOC <= '"+mv_par04+"'"
		cQry += " AND SD1.D1_SERIE >= '"+mv_par05+"'"
		cQry += " AND SD1.D1_SERIE <= '"+mv_par06+"'"
		cQry += " AND SD1.D1_ITEM >= '"+mv_par08+"'"
		cQry += " AND SD1.D1_ITEM <= '"+mv_par09+"'"
		cQry += " ORDER BY SD1.D1_FILIAL, SD1.D1_DOC, SD1.D1_SERIE, SD1.D1_FORNECE, SD1.D1_LOJA, SD1.D1_ITEM"
	Else
		cQry := "SELECT 1 AS D1_XCONVER, SZ6.Z6_LOTECTL AS D1_LOTECTL, SD1.D1_DOC, SD1.D1_SERIE, SD1.D1_COD, SD1.D1_PEDIDO, SD1.D1_DTDIGIT,"
		cQry += " SB1.B1_DESC AS D1_X_DESCR, SZ6.Z6_QUANT AS D1_QUANT"
		cQry += " FROM "+RetSQLName("SZ6")+" SZ6"
		cQry += " INNER JOIN "+RetSQLName("SD1")+" SD1 ON SD1.D_E_L_E_T_ = ' '"
		cQry += " AND SD1.D1_FILIAL = SZ6.Z6_FILIAL"
		cQry += " AND SD1.D1_DOC = SZ6.Z6_DOC"
		cQry += " AND SD1.D1_SERIE = SZ6.Z6_SERIE"
		cQry += " AND SD1.D1_FORNECE = SZ6.Z6_FORNECE"
		cQry += " AND SD1.D1_LOJA = SZ6.Z6_LOJA"
		cQry += " AND SD1.D1_ITEM = SZ6.Z6_ITEM"
		cQry += " AND SD1.D1_COD = SZ6.Z6_PRODUTO"
		cQry += " INNER JOIN "+RetSQLName("SB1")+" SB1 ON SB1.D_E_L_E_T_ = ' ' AND SB1.B1_COD = SZ6.Z6_PRODUTO"
		cQry += " WHERE SZ6.D_E_L_E_T_ = ' '"
		cQry += " AND SZ6.Z6_FORNECE >= '"+mv_par01+"'"
		cQry += " AND SZ6.Z6_FORNECE <= '"+mv_par02+"'"
		cQry += " AND SZ6.Z6_DOC >= '"+mv_par03+"'"
		cQry += " AND SZ6.Z6_DOC <= '"+mv_par04+"'"
		cQry += " AND SZ6.Z6_SERIE >= '"+mv_par05+"'"
		cQry += " AND SZ6.Z6_SERIE <= '"+mv_par06+"'"
		cQry += " AND SZ6.Z6_ITEM >= '"+mv_par08+"'"
		cQry += " AND SZ6.Z6_ITEM <= '"+mv_par09+"'"
		cQry += " AND SZ6.Z6_VOLUME >= '"+mv_par10+"'"
		cQry += " AND SZ6.Z6_VOLUME <= '"+mv_par11+"'"
		cQry += " ORDER BY SZ6.Z6_FILIAL, SZ6.Z6_DOC, SZ6.Z6_SERIE, SZ6.Z6_FORNECE, SZ6.Z6_LOJA, SZ6.Z6_ITEM"
	Endif

	Memowrite("Arlindo_etiquetas_",cQry)

	DbUseArea(.T.,"TOPCONN",TcGenQry(,,cQry),cTable,.T.,.T.)

	If (cTable)->(BOF() .And. EOF())
		Aviso("Etiquetas","Não foram encontrados itens nos parâmetros informados !",{"OK"})
	EndIf

	While !(cTable)->(Eof())

		(cTable)->(PrintLabel(AllTrim(D1_LOTECTL),D1_DOC,D1_SERIE,D1_COD,D1_X_DESCR,D1_QUANT,D1_PEDIDO,Dtoc(Stod(D1_DTDIGIT)),Eof()))

		(cTable)->(DbSkip())
	EndDo
	(cTable)->(DbCloseArea())

Return

Static Function PrintLabel(cLote,cNota,cSerie,cProduto,cDescri,nQuant,cPedido,cData,lEof)
	MsCbPrinter("Z4M","LPT1",,,.F.,,,,)
