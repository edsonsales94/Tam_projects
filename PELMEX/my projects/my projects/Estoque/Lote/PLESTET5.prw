	MsCbBegin(1,6)

	MSCBWRITE("CT~~CD,~CC^~CT~")
	MSCBWRITE("^XA~TA000~JSN^LT0^MNW^MTT^PON^PMN^LH0,0^JMA^PR2,2~SD30^JUS^LRN^CI0^XZ")

	If cEmpAnt == "10"    // Se a empresa for Pelmex
		MSCBWRITE("~DG000.GRF,05632,044,")
		MSCBWRITE(",::::::::::::::::::::::::J080H080H080808080N080R08080H080H080H080P08080P080,,J0QFH01FOFE00FF80M0202020202020H0PFE0S07,I01F7F7F7F7F7F8017O7E00FF80M035757575757540757N7I0780M01F80,J0QFE01FPF80FF80M03FPFC0FPF801FC0M03FC0,I01DODFE01DODF80FF80M05DPDC0DODF801FE0M07DC0,J0RF01FPF80FF80M03FPFC0FPF803FF0M0HFE0,I015775K57570157575H5755F00F780M0157I757J740575H575H5H78037780K0177E0,J0RF81FPF80FF80M03FPFC0FPF803FFC0K03FFE0,I01DPDF81DODE00FF80M05DFDFDHDIFDC0DODF003DFE0K07DDC0,J0HFNBHF81FOFE00FF80M03FPFC0FOFE001FHFL0IF80,I017780L0H701770P0F780M035C007FC007540750Q0F5F0J01F7F,J0HF80L0HF81FF0P0HF80M03FE007FC007FC0FF0N08007FFC0I03FFE,I01DD80L0DF01DF0P0FD80M05DC007DC005DC0DD0Q03DDC0I05DFC,J0HF80L0HF81FF0P0HF80M03FE007FC007FC0FF0Q01FHFJ0IF8,I01570M0H701570P0F780M015400754005540570R0H7F0H0175F0,J0HF80L0HF81FF80O0HF80M03FE007FC00FFC0FF80P08FHFC083FFE0,I01DD80L0FD01DD0P0HF80M05DC007DC005DC0DD0R03DDE007DFC0,J0HF80L0HF81FF0P0HF80M03FE007FC007FC0FF0R03FHFH0IF80,I017780L0F701770P0F780M035400774007540770S0F7F807F7,J0HF80L0HF81FF0P0HF80M03FE007FC007FC0FF0S0IFC0FFE,I01DF80L0HF01DF0P0FD80M05DC007DC005DC0DD0S03DFE01FC,J0RF81FOF800FF80M03FE007FC007FC0FOF80J03FHF01F8,I01575H575H57570157575H5757C00F780M015400754005740575H575H57C0J01F578070,J0RF81FOFE00FF80M03FE007FC007FC0FOFE0J08FHFC0E0,I01DDFDLDHF01DNDFE00FF80M05DC007DC005DC0DODE0K07DFC0,J0RF01FOFE00FF80M03FE007FC007FC0FPFL03FHF0,I0177F575757H7E01757M7E00F780M0354007740075407O7E0K01F5F8,J0QFE01FOFE00FF80M03FE007FC007FC0FOFE80K0IFC,I01DFOFH01DFDLDFC00FD80M05DC007DC005DC0DODC0L07DDE,J0HF80O01FOF800FF80M03FE007FC007FC0FOF80L0JF,I01570P01570P0F780M015400754005540570T01F55F,J0HF80O01FF80L0800FF80M03FE007FC00FFC0FF80L080K03FIFC0,I01DD80O01DD0P0HF80M05DC007DC005DC0DD0T07FFDDC0,J0HF80O01FF0P0HF80M03FE007FC007FC0FF0T0LF0,I01770P01770P0F780M035400774007540770S01F77F7F0,J0HF80O01FF0P0HF80M03FE007FC007FC0FF0S03FKFC,I01DD80O01DD0P0FD80M05DC007DC005DC0DF0S07DFC7DFC,J0HF80O01FF0P0HF80M03FE007FC007FC0FF0S0IFC3FHF,I01570P01570P0F580M015400754005740570R01D7701F57,J0HF80O01FF80L0800FF80K0803FE007FC007FC0FF80L080I07FHF08FHFC0,I01DD80O01DF0P0FD80M05DC007DC005DC0DF0R07DDC007DFC0,J0HF80O01FOFE00FNFE03FE007FC007FC0FPFI01FHFC003FHF0,I01750P01757M7F00F7M7F0354007740077C075F7L7F0H01F770H01F5F0,J0HF80O01FPF80FOF83FE007FC007FC0FPF8007FHFJ0IFC,I01DD80O01DODF80DNDF87FC007DC007FC0DODF800DFFC0I07FDC,J0HF80O01FPF80FOF87FE007FC007FC0FPF801FHF80I03FHF,I01770P015O5780F5M5783F4007FC0077C05O57803D770J01F5F,J0HF80O01FPF80FOF83FC003FC00FF80FPFH8IFE0J08FHFC0,I01FD80O01DODE00DNDE01F8001F0H01F00FDNDF01FHFC0K07DDC0,J0HA80P0PA800ANA80060I0A0I0A00AOAC03FHF80K03FFC0,iN07FHFM01F7C0,iM01FHFC0M0HFC0,iM03FHFC0M07F80,iM07FHFO03E,iL01F77E0,iL0BFHFC0,iL0FDFF,iK01FHFE,iK07F7FC,iK0JF8,iJ03FDFE0,iJ07FHFC0,iI017757,iI03FHFE80,iH01FFDFC,iH03FIF0,iH0IF7C0,080hX09FIF80,140hX07FDDF,3F80hV01FIFC,7FF0hV07F57F0,IFE80hS01FIFC0,JFE0hS07FIF80,KF80hQ03FIFE,F577FFC0hP07F75FC,MF80hN03FIFE8,JFHDHF80hL01FDDFFC0,3FMF80hK07FIFE,0FF55757FF80hI03F7557C,H0OFH8hG08FKF0,H01FFDIDIFC0h0HFHDHFC0,I01FNFE0gX03FJFE,J03FF7J7F7F0gV03F7I7FC,K03FOFH8gS09FKFE8,L07FHFHDKFE0gQ03FHFIDF80,M03FPFgP03FLFC,N07FHFH7I5H7HFgM07FHF577FF0,N087FQFE080g08FNF80,P07FHFIDNFg07FDFJFDFC,Q03FTFA0T03FOFE0,R07FF7F7757575F7FJFD80K017FJFI7577F7,S03FgXF8,T01FIFSDHFJDFDNDJF40,V0gUF8,W07FF75I5757H757H7K5757575H5H7FC0,Y0gPF8,g0JFDFDDFDFDNDIFDFIFC0,gH0gJFE0,gI01FHF7FF7H7F7I7F7FHF7FC,gL0BFUF8,gN01FLFDFIF8,,^XA")
	Else   // Se a empresa for Amazon Motion
		MSCBWRITE("^XA")
	Endif

	MSCBWRITE("^MMT")
	MSCBWRITE("^PW1181")
	MSCBWRITE("^LL0945")
	MSCBWRITE("^LS0")

	If cEmpAnt == "10"    // Se a empresa for Pelmex
		MSCBWRITE("^FT96,224^XG000.GRF,1,1^FS")
	Endif

	MSCBWRITE("^BY3,3,133^FT100,901^B3N,N,,N,N")
	MSCBWRITE("^FD"+cLote+"^FS")

	If cEmpAnt == "10"    // Se a empresa for Pelmex
		MSCBWRITE("^FT503,192^A0N,58,57^FH\^FDPELMEX DA AMAZONIA^FS")
	Else   // Se a empresa for Amazon Motion
		MSCBWRITE("^FT280,209^A0N,96,96^FH\^FDAMAZON MOTION^FS")
	Endif

	MSCBWRITE("^FT99,482^A0N,37,36^FH\^FDDESCRI\80\C7O:^FS")
	MSCBWRITE("^FT103,734^A0N,37,36^FH\^FDLOTE:^FS")
	MSCBWRITE("^FT95,430^A0N,37,36^FH\^FDCOD. PROD:^FS")
	MSCBWRITE("^FT98,316^A0N,37,36^FH\^FDNOTA:^FS")
	MSCBWRITE("^FT886,317^A0N,37,36^FH\^FDPEDIDO:^FS")
	MSCBWRITE("^FT586,317^A0N,37,36^FH\^FDDATA:^FS")
	MSCBWRITE("^FT386,316^A0N,37,36^FH\^FDSERIE:^FS")
	MSCBWRITE("^FO59,257^GB1113,0,12^FS")
	MSCBWRITE("^FO61,666^GB1113,0,12^FS")
	MSCBWRITE("^FO59,338^GB1113,0,12^FS")
	MSCBWRITE("^FO63,73^GB1113,0,11^FS")
	MSCBWRITE("^FO65,72^GB0,863,12^FS")
	MSCBWRITE("^FO1161,69^GB0,864,12^FS")
	MSCBWRITE("^FT1027,317^A0N,37,36^FH\^FD"+cPedido+"^FS")
	MSCBWRITE("^FO73,926^GB1099,0,11^FS")
	MSCBWRITE("^FT697,317^A0N,37,36^FH\^FD"+cData+"^FS")
	MSCBWRITE("^FT500,315^A0N,37,36^FH\^FD"+cSerie+"^FS")
	MSCBWRITE("^FT204,316^A0N,37,36^FH\^FD"+LTrim(Str(Val(cNota)))+"^FS")
	MSCBWRITE("^BY3,3,133^FT664,640^BCN,,N,N")
	MSCBWRITE("^FD>:"+LTrim(Str(nQuant,10,3))+"^FS")
	MSCBWRITE("^BY3,3,133^FT100,641^BCN,,N,N")
	MSCBWRITE("^FD>;"+RTrim(cProduto)+"^FS")
	MSCBWRITE("^FT875,430^A0N,37,33^FH\^FD"+LTrim(Transform(nQuant,"@E 9,999,999.999"))+"^FS")
	MSCBWRITE("^FT290,429^A0N,33,33^FH\^FD"+RTrim(cProduto)+"^FS")
	MSCBWRITE("^FT297,478^A0N,33,33^FH\^FD"+RTrim(cDescri)+"^FS")
	MSCBWRITE("^FT456,390^A0N,37,36^FH\^FDDADOS DO PRODUTO^FS")
	MSCBWRITE("^FT200,731^A0N,33,33^FH\^FD"+cLote+"^FS")
	MSCBWRITE("^FT786,430^A0N,37,36^FH\^FDQTD:^FS")

	If cEmpAnt == "10"    // Se a empresa for Pelmex
		MSCBWRITE("^LRY^FO86,113^GB360,0,118^FS^LRN")
		MSCBWRITE("^PQ1,0,1,Y^XZ")
		MSCBWRITE("^XA^ID000.GRF^FS^XZ")
	Else   // Se a empresa for Amazon Motion
		MSCBWRITE("^PQ1,0,1,Y^XZ")
	Endif

	MsCbEnd() //Finaliza a montagem da imagem
	MsCbClosePrinter()

	If !lEof
		Sleep(2000)  // Processa o tempo de espera (1 segundo)
	Endif

Return

Static Function AjustaCodigo(cCodigo)
	Local cRet := cCodigo

	If Len(cRet) > 8
		cRet := SubStr(cRet,1,8) + ">" + SubStr(cRet,9,Len(cRet))
	Endif

Return cRet

Static Function ValidPerg(cPerg)
	u_InPutSX1(cPerg,"01",PADR("Fornecedor De ",29)+"?","","","mv_ch1","C",06,0,0,"G","","SA2","","","mv_par01")
	u_InPutSX1(cPerg,"02",PADR("Fornecedor Ate",29)+"?","","","mv_ch2","C",06,0,0,"G","","SA2","","","mv_par02")
	u_InPutSX1(cPerg,"03",PADR("Nota De       ",29)+"?","","","mv_ch3","C",09,0,0,"G","","   ","","","mv_par03")
	u_InPutSX1(cPerg,"04",PADR("Nota Ate      ",29)+"?","","","mv_ch4","C",09,0,0,"G","","   ","","","mv_par04")
	u_InPutSX1(cPerg,"05",PADR("Série De      ",29)+"?","","","mv_ch5","C",03,0,0,"G","","   ","","","mv_par05")
	u_InPutSX1(cPerg,"06",PADR("Série Ate     ",29)+"?","","","mv_ch6","C",03,0,0,"G","","   ","","","mv_par06")
	u_InPutSX1(cPerg,"07",PADR("Origem        ",29)+"?","","","mv_ch7","N",01,0,0,"C","","   ","","","mv_par07","Nota Fiscal","","","","Lote Final")
	u_InPutSX1(cPerg,"08",PADR("Item De       ",29)+"?","","","mv_ch8","C",04,0,0,"G","","   ","","","mv_par08")
	u_InPutSX1(cPerg,"09",PADR("Item Ate      ",29)+"?","","","mv_ch9","C",04,0,0,"G","","   ","","","mv_par09")
	u_InPutSX1(cPerg,"10",PADR("Volume De     ",29)+"?","","","mv_cha","C",03,0,0,"G","","   ","","","mv_par10")
	u_InPutSX1(cPerg,"11",PADR("Volume Ate    ",29)+"?","","","mv_chb","C",03,0,0,"G","","   ","","","mv_par11")
Return