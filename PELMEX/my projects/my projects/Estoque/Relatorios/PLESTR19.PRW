ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/


User Function PLESTR19()
	Local oReport
	Local cQuery
	Local cAlias      := getNextAlias()      

	Private cPerg     := "PLESTR19"

	AjustaSX1(cPerg)
	Pergunte(cPerg,.F.)

	oReport := ReportDef(cAlias,cPerg)
	oReport:PrintDialog()
Return


Static Function ReportDef(cAlias,cPerg)
	Local oReport
	Local oSection
	Local oBreak
	Local aOrdem      := {"FILIAL"}

	oReport := TReport():New(cPerg,"Rel. Consumo Médio p/ Periodo",cPerg,{|oReport| PrintReport(oReport,cAlias)}, )
	oReport:SetPortrait()      
	oReport:SetEnvironment(2)      

	//Primeira seção
	oSection := TRSection():New(oReport,"Rel. Consumo Médio p/ Periodo",{"SB2"},aOrdem)  


	TRCell():New(oSection,"EMPRESA"				,"SB2","Empresa",,10)           
	TRCell():New(oSection,"CODIGO" 	   			,"SB2","Codigo",,25) 
	TRCell():New(oSection,"DESCRICAO"  			,"SB2","Descricao",,50)
	TRCell():New(oSection,"UM"    	   			,"SB1","UM","@!",5)
	TRCell():New(oSection,"PERIODO"    	        ,"SB2","Periodo (mes)","@E 999,999,999.999",)
	TRCell():New(oSection,"QTD_PERIODO"    	    ,"SB2","Consumo Periodo","@E 999,999,999.999",)
	TRCell():New(oSection,"MEDIA"    	        ,"SC2","Media","@E 999,999,999.999",)
	TRCell():New(oSection,"QTD_01"    			,"SB2","Estoque Arm01","@E 999,999,999.999",)
	TRCell():New(oSection,"QTD_10"    		    ,"SB2","Estoque Arm10","@E 999,999,999.999",)
	TRCell():New(oSection,"QTD_ESTOQUE"    		,"SB1","Qtd.Estoque","@E 999,999,999.999",)
	TRCell():New(oSection,"DISPONIBILIDADE_MES" ,"SB2","Disponibilidade (mes)","@E 999,999,999.999",10)
	TRCell():New(oSection,"CUSTO_MEDIO"         ,"SB9","Custo Medio","@E 999,999,999.999",)
	TRCell():New(oSection,"ULTIMA_ENTRADA"      ,"SB1","Custo Ultima Entrada","@E 999,999,999.999",)
	TRCell():New(oSection,"TOTAL"               ,"SB1","Total","@E 999,999,999.999",)
	TRCell():New(oSection,"DT_COMPRA"           ,"SB2","Ultima Entrada","@!",15)
	TRCell():New(oSection,"DESCGRUPO"			,"SBM","Grupo","@!",20)  
	//Totalizador                                                                                  
	//TRFunction():New(oSection:Cell("ETIQUETA"),"Etiqueta:","SUM",,,"@E 999,999,999,999",,.F.,.T.)

Return oReport


/*Inicia Logica Print Report */

Static Function PrintReport(oReport,cAlias)
	Local oSection  := oReport:Section(1)

	//if oReport:Section(1):GetOrder() == 1
	//	cOrdem := "A1_COD"
	//endif      


	oSection:BeginQuery()
	BeginSQL Alias cAlias
		%noparser%

SELECT *,CASE WHEN MEDIA = 0 THEN DATEDIFF(DAY,DT_COMPRA,CONVERT(VARCHAR,GETDATE(),103)) ELSE 0 END SEM_MOVIMENTACAO
FROM( 
		SELECT EMPRESA,CODIGO,DESCRICAO,UM,CAST(%Exp:MV_PAR03% AS INT) PERIODO,QTD_PERIODO,QTD_PERIODO/CAST(%Exp:MV_PAR03% AS INT) MEDIA,QTD_01,QTD_10, QTD_ESTOQUE,
			CASE WHEN (QTD_PERIODO / CAST(%Exp:MV_PAR03% AS INT)) > 0 THEN QTD_ESTOQUE / (QTD_PERIODO/CAST(%Exp:MV_PAR03% AS INT))) 
			ELSE 0 END DISPONIBILIDADE_MES,
			DESCGRUPO,
			ISNULL(B1_UPRC,0)ULTIMA_ENTRADA,ISNULL(B9_CM1,0)CUSTO_MEDIO,QTD_ESTOQUE * ISNULL(B9_CM1,0) TOTAL,
			CASE WHEN B1_UCOM IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(B1_UCOM AS DATE),103) END DT_COMPRA
	FROM(
		    SELECT EMPRESA,B1_GRUPO GRUPO,BM_DESC DESCGRUPO,B1_COD CODIGO,B1_DESC DESCRICAO,B1_UM UM,D3_LOCAL ARMAZEM,
			       CASE WHEN SUM(D3_QUANT) < 0 THEN 0 ELSE SUM(D3_QUANT) END QTD_PERIODO,
			       SB2.B2_QATU QTD_01,ISNULL(QTD_10,0)QTD_10,
			       SB2.B2_QATU + ISNULL(QTD_10,0) QTD_ESTOQUE,ISNULL(B1_UPRC,0)B1_UPRC,B9_CM1,B1_UCOM
		    FROM(
		           SELECT 'AMAZON' EMPRESA,D3_TM,B1_GRUPO,BM_DESC,B1_COD,B1_DESC,B1_UM,D3_LOCAL,
			              CASE WHEN SD3.D3_TM IN ('501','702') THEN SUM(D3_QUANT) ELSE SUM(D3_QUANT)*-1 END D3_QUANT,ISNULL(B1_UPRC,0)B1_UPRC,B1_UCOM
		           FROM SD3200 SD3 (NOLOCK)
		           INNER JOIN SB1200 SB1 (NOLOCK) ON SD3.D3_COD = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
		           INNER JOIN SBM200 SBM (NOLOCK) ON B1_GRUPO = BM_GRUPO AND SBM.D_E_L_E_T_ = ''
		           WHERE SD3.D_E_L_E_T_ = ''
		           AND SD3.D3_FILIAL = '01'
		           AND SD3.D3_TM IN ('101','501','202','702')
		           AND SD3.D3_LOCAL IN ('01')
		           AND SD3.D3_COD BETWEEN '' AND 'ZZZZZZ'
		           AND SD3.D3_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(CAST(%Exp:MV_PAR03% AS INT) AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
		           GROUP BY B1_GRUPO,BM_DESC,B1_COD,B1_DESC,B1_UM,D3_TM,D3_LOCAL,B1_UPRC,B1_UCOM
		    	)TB
		    LEFT JOIN SB2200 SB2 (NOLOCK) ON B2_FILIAL = '01' AND B1_COD = SB2.B2_COD AND D3_LOCAL = SB2.B2_LOCAL AND SB2.D_E_L_E_T_ = ''
		    LEFT JOIN (SELECT B2_FILIAL,B2_COD,B2_LOCAL,B2_QATU QTD_10
				       FROM SB2200 SB2 (NOLOCK)
				       WHERE SB2.D_E_L_E_T_ = ''
				       AND B2_FILIAL = '01'
				       AND B2_LOCAL = '10')SB21 ON B1_COD = SB21.B2_COD
			LEFT JOIN (SELECT B9_FILIAL,B9_COD,B9_CM1,B9_DATA
			           FROM SB9200 SB9 (NOLOCK)
					   WHERE SB9.D_E_L_E_T_ = ''
					   AND B9_LOCAL = '01'
					   AND B9_FILIAL = '01'
					   AND B9_DATA IN (SELECT MAX(B9_DATA)B9_DATA
			                          FROM SB9200 SB9 (NOLOCK)
					                  WHERE SB9.D_E_L_E_T_ = ''
					                  AND B9_LOCAL = '01'
					                  AND B9_FILIAL = '01')
					   )SB9 ON B1_COD = B9_COD
		    GROUP BY EMPRESA,B1_GRUPO,BM_DESC,B1_COD,B1_DESC,B1_UM,D3_LOCAL,SB2.B2_QATU,QTD_10,B1_UPRC,B1_UCOM,B9_CM1
		    UNION
		    SELECT EMPRESA,B1_GRUPO,BM_DESC DESCGRUPO,B1_COD,B1_DESC,B1_UM,D3_LOCAL,
			    CASE WHEN SUM(D3_QUANT) < 0 THEN 0 ELSE SUM(D3_QUANT) END QTD_PERIODO,
			    SB2.B2_QATU QTD_01,ISNULL(QTD_10,0)QTD_10,
			    SB2.B2_QATU + ISNULL(QTD_10,0) QTD_ESTOQUE,ISNULL(B1_UPRC,0)B1_UPRC,B9_CM1,B1_UCOM 
		    FROM(
		        SELECT 'PELMEX' EMPRESA,D3_TM,B1_GRUPO,BM_DESC,B1_COD,B1_DESC,B1_UM,D3_LOCAL,
			            CASE WHEN SD3.D3_TM IN ('501','702') THEN SUM(D3_QUANT) ELSE SUM(D3_QUANT)*-1 END D3_QUANT,ISNULL(B1_UPRC,0)B1_UPRC,B1_UCOM
		        FROM SD3100 SD3 (NOLOCK)
		        INNER JOIN SB1100 SB1 (NOLOCK) ON SD3.D3_COD = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
		        INNER JOIN SBM100 SBM (NOLOCK) ON B1_GRUPO = BM_GRUPO AND SBM.D_E_L_E_T_ = ''
		        WHERE SD3.D_E_L_E_T_ = ''
		        AND SD3.D3_FILIAL = '01'
		        AND SD3.D3_TM IN ('101','501','202','702')
		        AND SD3.D3_LOCAL IN ('01')
		        AND SD3.D3_COD BETWEEN '' AND 'ZZZZZZ'
		        //AND B1_DESC NOT LIKE 'ART%'
		        AND B1_DESC NOT LIKE 'SUP%'
		        AND B1_DESC NOT LIKE 'BL%'
		        //AND B1_DESC NOT LIKE 'ATR%'
		        AND B1_DESC NOT LIKE 'SISTEMA DE %'
		        AND SD3.D3_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(CAST(%Exp:MV_PAR03% AS INT) AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
		        GROUP BY B1_GRUPO,BM_DESC,B1_COD,B1_DESC,B1_UM,D3_TM,D3_LOCAL,B1_UPRC,B1_UCOM
		    )TB
		    LEFT JOIN SB2100 SB2 (NOLOCK) ON B2_FILIAL = '01' AND B1_COD = SB2.B2_COD AND D3_LOCAL = SB2.B2_LOCAL AND SB2.D_E_L_E_T_ = ''
		    LEFT JOIN (SELECT B2_FILIAL,B2_COD,B2_LOCAL,B2_QATU QTD_10
				       FROM SB2100 SB2 (NOLOCK)
				       WHERE SB2.D_E_L_E_T_ = ''
				       AND B2_FILIAL = '01'
				       AND B2_COD NOT LIKE 'MOD%'
				       AND B2_LOCAL = '10')SB21 ON B1_COD = SB21.B2_COD
		    LEFT JOIN (SELECT B9_FILIAL,B9_COD,B9_CM1,B9_DATA
			           FROM SB9200 SB9 (NOLOCK)
					   WHERE SB9.D_E_L_E_T_ = ''
					   AND B9_LOCAL = '01'
					   AND B9_FILIAL = '01'
					   AND B9_DATA IN (SELECT MAX(B9_DATA)B9_DATA
			                          FROM SB9200 SB9 (NOLOCK)
					                  WHERE SB9.D_E_L_E_T_ = ''
					                  AND B9_LOCAL = '01'
					                  AND B9_FILIAL = '01')
					   )SB9 ON B1_COD = B9_COD
		    GROUP BY EMPRESA,B1_GRUPO,BM_DESC,B1_COD,B1_DESC,B1_UM,D3_LOCAL,SB2.B2_QATU,QTD_10,B1_UPRC,B1_UCOM,B9_CM1
		)TB1
	UNION
	SELECT 'PELMEX' EMPRESA,SB2.B2_COD,B1_DESC,B1_UM,CAST(%Exp:MV_PAR03% AS INT) PERIODO, 0 QTD_PERIODO,0 MEDIA,B2_QATU,
			ISNULL(QTD_10,0)QTD_10,
			B2_QATU+ISNULL(QTD_10,0) QTD_ESTOQUE,
			(B2_QATU+ISNULL(QTD_10,0))/CAST(%Exp:MV_PAR03% AS INT) DISPONIBILIDADE_MES,BM_DESC,
			ISNULL(B1_UPRC,0)B1_UPRC,ISNULL(B9_CM1)B9_CM1,(B2_QATU+ISNULL(QTD_10,0))*ISNULL(B9_CM1,0) TOTAL, 
			CASE WHEN B1_UCOM IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(B1_UCOM AS DATE),103) END B1_UCOM
	FROM SB2100 SB2 (NOLOCK)
	INNER JOIN SB1100 SB1 (NOLOCK) ON B2_COD = B1_COD AND SB1.D_E_L_E_T_ = ''
	INNER JOIN SBM100 SBM (NOLOCK) ON B1_GRUPO = BM_GRUPO AND SBM.D_E_L_E_T_ = ''
	LEFT JOIN (SELECT B2_COD,B2_LOCAL,B2_QATU QTD_10
				FROM SB2100 SB2
				WHERE SB2.D_E_L_E_T_ = ''
				AND B2_FILIAL = '01'
				AND B2_LOCAL = '10'
				AND B2_COD NOT LIKE 'MOD%'
				)SB21 ON SB2.B2_FILIAL = '01' AND SB2.B2_COD = SB21.B2_COD
	LEFT JOIN (SELECT B9_FILIAL,B9_COD,B9_CM1,B9_DATA
			    FROM SB9200 SB9 (NOLOCK)
				WHERE SB9.D_E_L_E_T_ = ''
				AND B9_LOCAL = '01'
				AND B9_FILIAL = '01'
				AND B9_DATA IN (SELECT MAX(B9_DATA)B9_DATA
			                    FROM SB9200 SB9 (NOLOCK)
					            WHERE SB9.D_E_L_E_T_ = ''
					            AND B9_LOCAL = '01'
					            AND B9_FILIAL = '01')
				)SB9 ON B1_COD = B9_COD
	WHERE SB2.D_E_L_E_T_ = ''
	AND SB2.B2_COD NOT IN (SELECT D3_COD 
						    FROM SD3100 SD3 (NOLOCK)
							WHERE SD3.D_E_L_E_T_ = ''
							AND SD3.D3_FILIAL = '01'
							AND SD3.D3_TM IN ('101','501','202','702')
							AND SD3.D3_LOCAL IN ('01')
							AND SD3.D3_COD BETWEEN '' AND 'ZZZZZZ'
							//AND B1_DESC NOT LIKE 'ART%'
							AND B1_DESC NOT LIKE 'SUP%'
							AND B1_DESC NOT LIKE 'BL%'
							//AND B1_DESC NOT LIKE 'ATR%'
							AND B1_DESC NOT LIKE 'SISTEMA DE %'
							AND SD3.D3_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(CAST(%Exp:MV_PAR03% AS INT) AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
							GROUP BY D3_COD)
	AND SB2.B2_COD NOT LIKE 'MOD%'
	AND B1_TIPO IN ('MN','MI')
	//AND B1_DESC NOT LIKE 'ART%'
	//AND B1_DESC NOT LIKE 'ATR%'
	AND B1_DESC NOT LIKE 'SUP%'
	AND SB2.B2_FILIAL = '01'
	AND SB2.B2_LOCAL = '01'
	AND SB2.B2_QATU > 0
	GROUP BY SB2.B2_COD,B1_DESC,B1_UM,SB2.B2_QATU,QTD_10,BM_DESC,B1_UPRC,B1_UCOM,B9_CM1
	UNION
	SELECT 'AMAZON' EMPRESA,SB2.B2_COD,B1_DESC,B1_UM,CAST(%Exp:MV_PAR03% AS INT) PERIODO, 0 QTD_PERIODO,0 MEDIA,B2_QATU,
		   ISNULL(QTD_10,0)QTD_10,
		   B2_QATU+ISNULL(QTD_10,0) QTD_ESTOQUE,
		  (B2_QATU+ISNULL(QTD_10,0))/CAST(%Exp:MV_PAR03% AS INT) DISPONIBILIDADE_MES,BM_DESC,
		  ISNULL(B1_UPRC,0)B1_UPRC,ISNULL(B9_CM1,0)B9_CM1,(B2_QATU+ISNULL(QTD_10,0))*ISNULL(B9_CM1,0) TOTAL,
		  CASE WHEN B1_UCOM IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(B1_UCOM AS DATE),103) END B1_UCOM
	FROM SB2200 SB2 (NOLOCK)
	INNER JOIN SB1200 SB1 (NOLOCK) ON B2_COD = B1_COD AND SB1.D_E_L_E_T_ = ''
	INNER JOIN SBM200 SBM (NOLOCK) ON B1_GRUPO = BM_GRUPO AND SBM.D_E_L_E_T_ = ''
	LEFT JOIN (SELECT B2_COD,B2_LOCAL,B2_QATU QTD_10
			   FROM SB2200 SB2
			   WHERE SB2.D_E_L_E_T_ = ''
			   AND B2_FILIAL = '01'
			   AND B2_LOCAL = '10'
			   AND B2_COD NOT LIKE 'MOD%'
			   )SB21 ON SB2.B2_FILIAL = '01' AND SB2.B2_COD = SB21.B2_COD
	LEFT JOIN (SELECT B9_FILIAL,B9_COD,B9_CM1,B9_DATA
			    FROM SB9200 SB9 (NOLOCK)
				WHERE SB9.D_E_L_E_T_ = ''
				AND B9_LOCAL = '01'
				AND B9_FILIAL = '01'
				AND B9_DATA IN (SELECT MAX(B9_DATA)B9_DATA
			                    FROM SB9200 SB9 (NOLOCK)
					            WHERE SB9.D_E_L_E_T_ = ''
					            AND B9_LOCAL = '01'
					            AND B9_FILIAL = '01')
				)SB9 ON B1_COD = B9_COD
	WHERE SB2.D_E_L_E_T_ = ''
	AND SB2.B2_COD NOT IN (SELECT D3_COD 
						   FROM SD3200 SD3 (NOLOCK)
						   WHERE SD3.D_E_L_E_T_ = ''
						   AND SD3.D3_FILIAL = '01'
						   AND SD3.D3_TM IN ('101','501','202','702')
						   AND SD3.D3_LOCAL IN ('01')
						   AND SD3.D3_COD BETWEEN '' AND 'ZZZZZZ'
						   //AND B1_DESC NOT LIKE 'ART%'
						   AND B1_DESC NOT LIKE 'SUP%'
						   AND B1_DESC NOT LIKE 'BL%'
						   //AND B1_DESC NOT LIKE 'ATR%'
						   AND B1_DESC NOT LIKE 'SISTEMA DE %'
						   AND SD3.D3_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(CAST(%Exp:MV_PAR03% AS INT) AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
						   GROUP BY D3_COD)
	AND SB2.B2_COD NOT LIKE 'MOD%'
	AND B1_TIPO IN ('MN','MI')
	//AND B1_DESC NOT LIKE 'ART%'
	//AND B1_DESC NOT LIKE 'ATR%'
	AND B1_DESC NOT LIKE 'SUP%'
	AND SB2.B2_FILIAL = '01'
	AND SB2.B2_LOCAL = '01'
	AND SB2.B2_QATU > 0
	GROUP BY SB2.B2_COD,B1_DESC,B1_UM,SB2.B2_QATU,QTD_10,BM_DESC,B1_UPRC,B1_UCOM,B9_CM1
	UNION
	SELECT EMPRESA,D3_COD,B1_DESC,B1_UM,PERIODO,SUM(D3_QUANT)QTD_PERIODO,SUM(D3_QUANT)/PERIODO MEDIA,QTD_01,QTD_10,QTD_ESTOQUE,
		CASE WHEN (SUM(D3_QUANT) / PERIODO) > 0 THEN QTD_ESTOQUE / (SUM(D3_QUANT)/PERIODO) ELSE 0 END DISPONIBILIDADE,BM_DESC,
		ULTIMA_ENTRADA,ISNULL(CUSTO_MEDIO,0)CUSTO_MEDIO,QTD_ESTOQUE * ISNULL(CUSTO_MEDIO,0) TOTAL,DT_COMPRA
	FROM(
	SELECT 'PELMEX' EMPRESA,D3_COD,B1_DESC,B1_UM,CAST(%Exp:MV_PAR03% AS INT) PERIODO,D3_TM,
		CASE WHEN SD3.D3_TM IN ('499') THEN D3_QUANT ELSE D3_QUANT*-1 END D3_QUANT,0 MEDIA,B2_QATU QTD_01,0 QTD_10,B2_QATU QTD_ESTOQUE,0 DISPONIBILIDADE_MES,
		BM_DESC,ISNULL(B1_UPRC,0) ULTIMA_ENTRADA,ISNULL(B9_CM1,0) CUSTO_MEDIO,0 TOTAL,
		CASE WHEN B1_UCOM IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(B1_UCOM AS DATE),103) END DT_COMPRA
	FROM SD3100 SD3 (NOLOCK)
	INNER JOIN SB1100 SB1 (NOLOCK) ON D3_COD = B1_COD AND SB1.D_E_L_E_T_ = ''
	INNER JOIN SBM100 SBM (NOLOCK) ON B1_GRUPO = BM_GRUPO AND SBM.D_E_L_E_T_ = ''
	LEFT JOIN SB2100 SB2 (NOLOCK) ON D3_FILIAL = B2_FILIAL AND D3_COD = B2_COD AND B2_LOCAL = '02' AND SB2.D_E_L_E_T_ = ''
	LEFT JOIN ( SELECT B9_FILIAL,B9_COD,B9_CM1,B9_DATA
				FROM SB9100 SB9 (NOLOCK)
				WHERE SB9.D_E_L_E_T_ = ''
				AND B9_LOCAL = '02'
				AND B9_FILIAL = '01'
				AND B9_DATA IN (SELECT MAX(B9_DATA)B9_DATA
								FROM SB9100 SB9 (NOLOCK)
								WHERE SB9.D_E_L_E_T_ = ''
								AND B9_LOCAL = '02'
								AND B9_FILIAL = '01')
				)SB9 ON B1_COD = B9_COD
	WHERE SD3.D_E_L_E_T_ = ''
	AND D3_FILIAL = '01'
	AND D3_LOCAL = '02'
	AND D3_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(CAST(%Exp:MV_PAR03% AS INT) AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
	)TB
	GROUP BY EMPRESA,D3_COD,B1_DESC,B1_UM,BM_DESC,PERIODO,QTD_01,QTD_10,QTD_ESTOQUE,ULTIMA_ENTRADA,CUSTO_MEDIO,DT_COMPRA,TOTAL
	UNION
	SELECT EMPRESA,D3_COD,B1_DESC,B1_UM,PERIODO,SUM(D3_QUANT)QTD_PERIODO,SUM(D3_QUANT)/PERIODO MEDIA,QTD_01,QTD_10,QTD_ESTOQUE,
		CASE WHEN (SUM(D3_QUANT) / PERIODO) > 0 THEN QTD_ESTOQUE / (SUM(D3_QUANT)/PERIODO) ELSE 0 END DISPONIBILIDADE,BM_DESC,
		ULTIMA_ENTRADA,ISNULL(CUSTO_MEDIO,0)CUSTO_MEDIO,QTD_ESTOQUE * ISNULL(CUSTO_MEDIO,0) TOTAL,DT_COMPRA
	FROM(
	SELECT 'AMAZON' EMPRESA,D3_COD,B1_DESC,B1_UM,CAST(%Exp:MV_PAR03% AS INT) PERIODO,D3_TM,
		CASE WHEN SD3.D3_TM IN ('499') THEN D3_QUANT ELSE D3_QUANT*-1 END D3_QUANT,0 MEDIA,B2_QATU QTD_01,0 QTD_10,B2_QATU QTD_ESTOQUE,0 DISPONIBILIDADE_MES,
		BM_DESC,ISNULL(B1_UPRC,0) ULTIMA_ENTRADA,ISNULL(B9_CM1,0) CUSTO_MEDIO,0 TOTAL,
		CASE WHEN B1_UCOM IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(B1_UCOM AS DATE),103) END DT_COMPRA
	FROM SD3200 SD3 (NOLOCK)
	INNER JOIN SB1200 SB1 (NOLOCK) ON D3_COD = B1_COD AND SB1.D_E_L_E_T_ = ''
	INNER JOIN SBM200 SBM (NOLOCK) ON B1_GRUPO = BM_GRUPO AND SBM.D_E_L_E_T_ = ''
	LEFT JOIN SB2200 SB2 (NOLOCK) ON D3_FILIAL = B2_FILIAL AND D3_COD = B2_COD AND B2_LOCAL = '02' AND SB2.D_E_L_E_T_ = ''
	LEFT JOIN ( 
				SELECT B9_FILIAL,B9_COD,B9_CM1,B9_DATA
				FROM SB9200 SB9 (NOLOCK)
				WHERE SB9.D_E_L_E_T_ = ''
				AND B9_LOCAL = '02'
				AND B9_FILIAL = '01'
				AND B9_DATA IN (SELECT MAX(B9_DATA)B9_DATA
								FROM SB9200 SB9 (NOLOCK)
								WHERE SB9.D_E_L_E_T_ = ''
								AND B9_LOCAL = '02'
								AND B9_FILIAL = '01')
				)SB9 ON B1_COD = B9_COD
	WHERE SD3.D_E_L_E_T_ = ''
	AND D3_FILIAL = '01'
	AND D3_LOCAL = '02'
	AND D3_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(CAST(%Exp:MV_PAR03% AS INT) AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
	)TB
	GROUP BY EMPRESA,D3_COD,B1_DESC,B1_UM,BM_DESC,PERIODO,QTD_01,QTD_10,QTD_ESTOQUE,ULTIMA_ENTRADA,CUSTO_MEDIO,DT_COMPRA,TOTAL
)TB2
WHERE CODIGO BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
ORDER BY 1,12,3
		


	EndSQL 


	oSection:EndQuery() 
	oSection:SetParentQuery()
	oSection:Print()	 
Return


Static Function AjustaSX1(cPerg)

	u_InPutSX1(cPerg,"01",PADR("De Produto:" ,20)+"?","","","mv_ch1","C",15,0,0,"G","","","SB1","","mv_par01") 
	u_InPutSX1(cPerg,"02",PADR("Ate Produto:",20)+"?","","","mv_ch2","C",15,0,0,"G","","","SB1","","mv_par02")
	u_InPutSX1(cPerg,"03",PADR("Periodo:"    ,20)+"?","","","mv_ch3","C",2,0,0,"G","","","","","mv_par03")
Return
