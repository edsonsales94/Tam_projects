user function VERICEP()
	Local cCep := M->A1_CEP

	IF  cCep == "69000000" .or. len(cCep)<8
		MsgInfo("O CEP "+cCep+" não é permitido ","ALERTA DE PENALIDADE: CEP INVALIDO")  
	endif       

return cCep 

