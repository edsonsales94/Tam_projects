user function vericd(_cproduto,item)
	local lret := .T.
	local _ctes := ""
	local nLinha := ""
	local _cfil := XFILIAL("SC6")
	nLinha := VAL(item)

	_ctes :=aCols[nLinha,ASCAN(aHeader,{|x| ALLTRIM(x[2]) == "C6_TES" })]
	if (_cfil= '01')

		cCod := aCols[nLinha,ASCAN(aHeader,{|x| ALLTRIM(x[2]) == "C6_PRODUTO" })]
		_nPreco := U_PLFATE07(_cfil,_cproduto,nlinha)
	endif

Return _cproduto

User Function PLFATE07(_cfil,_cproduto,nlinha)

	//Local aArea       := GetArea()
	Local cQuery      := ""
	Local nRecCount   := 0
	Local nSaldo := 0
	If _cfil <> "" //Fa็o a consulta para pegar as informa็๕es
		cQuery := "SELECT B2_FILIAL,B2_COD,B2_LOCAL,B2_QATU-B2_RESERVA B2_QATU "
		cQuery += " FROM "+RetSQLName("SB2")+" "
		cQuery += " WHERE B2_FILIAL = '01' "
		cQuery += " AND B2_LOCAL = '15' "
		cQuery += " AND B2_COD = '"+_cproduto+"' "

		//Se o alias estiver aberto, irei fechar, isso ajuda a evitar erros
		If Select("TRBSE1") <> 0
			DbSelectArea("TRBSE1")
			TRBSE1->(DbCloseArea())
		EndIf

		//crio o novo alias
		TCQUERY cQuery NEW ALIAS "TRBSE1"

		dbSelectArea("TRBSE1")
		TRBSE1->(dbGoTop())

		nSaldo = TRBSE1->B2_QATU

		If (nSaldo > 0)
			MSGINFO("Existe este produto no Deposito, por favor confirme o local de retirada"+Chr(13)+Chr(10)+"Armazem 15 - Deposito "+Chr(13)+Chr(10)+"Saldo:"+STR(nSaldo)+"")
		EndIf
	EndIf

Return (nSaldo)

