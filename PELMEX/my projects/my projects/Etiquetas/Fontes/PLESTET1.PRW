		ElseIf (Etq->C2_QUANT - Etq->C2_YSLDIMP)> nQuant//mv_par02 > nQuant
			Aviso("Atenção","Quantidade solicitada é maior que o saldo de "+StrZero(nQuant,3)+" etiquetas!", {"Ok"})
			lOk := .F.
		EndIf
