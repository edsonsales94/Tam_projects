#Include "rwmake.ch"
#INCLUDE "topconn.ch"

#DEFINE LINHAY "linhavertical"
#DEFINE LINHAX "linhahorizontal"

/*___________________________________________________________________________________
¦ Função    ¦ PLESTET1   ¦ Autor ¦ Diego Rafael             ¦ Data ¦ 06/05/2010     ¦
+-----------+------------+-------+--------------------------+------+----------------+
¦ Descriçäo ¦ Impressão da Etiqueta da Pelmex sem logotipo						    ¦
¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯*/
User Function PLESTET2()
	//04990401001
	Private oDlg1
	private cPerg := Padr("PLESTT",Len(SX1->X1_GRUPO))

	ValidPerg(cPerg)

	Pergunte(cPerg,.F.)

	@ 96,042 TO 323,505 DIALOG oDlg1 TITLE "Geração de Etiquetas"
	@ 08,010 TO 84,222
	@ 23,014 SAY "Esta rotina irá imprimir as informações das "
	@ 33,014 SAY "etiquetas da Pelmex."
	@ 91,139 BMPBUTTON TYPE 5 ACTION Pergunte(cPerg,.T.)
	@ 91,168 BMPBUTTON TYPE 1 ACTION PLESTT02A()
	@ 91,196 BMPBUTTON TYPE 2 ACTION Close(oDlg1)

	ACTIVATE DIALOG oDlg1 centered

Return Nil
/*_______________________________________________________________________________
¦ Função    ¦ ETQHPEL1a  ¦ Autor ¦ Ulisses Junior           ¦ Data ¦ 08/04/2008 ¦
+-----------+------------+-------+--------------------------+------+------------+
¦ Descriçäo ¦ Distribuição das tarefas          							  ¦
¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯*/
Static Function PLESTT02A()

	Private nCntVol := 1

	Close(oDlg1)

	MsgRun("Preparando Ambiente...","Aguarde...",{|| PLESTT02B() })
	MsgRun("Imprimindo Etiquetas...","Aguarde...",{|| PLESTT02C() })

Return Nil
/*________________________________________________________________________________
¦ Função    ¦ EtqPel01b  ¦ Autor   | Ulisses Junior          ¦ Data ¦ 08/04/2008 ¦
+-----------+------------+---------+-------------------------+------+------------+
¦ Descriçäo ¦ Montagem da query para leitura das OP's abertas            		 ¦
¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯*/
Static Function PLESTT02B()

	Local cQuery := ""
	Local aArqTmp := {}
	Local cArqTmp

	cQuery := " SELECT C2_NUM+C2_ITEM+C2_SEQUEN AS C2_OP, C2_PRODUTO, B1_DESC, "
	cQuery += "	B1_CODBAR, B1_COR, C2_QUANT, C2_YSLDIMP, C2_DATRF "
	cQuery += "	FROM "	+ RetSQLName("SC2") + " SC2"
	cQuery += "	 , "	+ RetSQLName("SB1") + " SB1"
	cQuery += "	WHERE SC2.D_E_L_E_T_ = ''
	cQuery += "	AND C2_FILIAL  = '" + SC2->(xFilial("SC2")) + "'"
	cQuery += "	AND C2_NUM+C2_ITEM+C2_SEQUEN = '" + Mv_Par01 + "'"
	cQuery += "	AND C2_PRODUTO = B1_COD"
	cQuery += "	AND SB1.D_E_L_E_T_ = ''"
	cQuery += "	AND B1_FILIAL = '" + SB1->(xFilial("SB1")) + "'"
	cQuery += "	ORDER BY C2_NUM,C2_ITEM,C2_SEQUEN,C2_PRODUTO"
	Memowrit("ETQPEL.SQL",cQuery)

	dbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), "ETQ", .T., .T.)

Return Nil

