	"J03FMF03FJFC2FJFC0FIFE0F83F0787FLFI07FLF0,J03FMF03FJFC1FJFC0FIFE0F83F0787FLFI07FLF0,"+;
	"J03FMF8BFJFC1FJFC0FIFE8F83F0F8FMF800FMF0,J03FMF03FJFC1FJFC0FIFE0F83F0787FKFE0H05FLF0,"+;
