	"J03FMF03FJFC002007E0H021E0F83F078020H07F01F807FKF0,J03FMF03FJFC0J01C0J0E0F83F0780J07C01FC01FKF0,"+;
	"J0BFMF83FJFC0H0801C80H08E0F83F0F8008003807FC03FKF0,J03FMF03FJFC0K0C0J0C0F81F0780J03007FF00FKF0,"+;
	"J03FMF03FJFC0J03C0J061FC1F0F80J0300BFF00FKF0,J03FMF83FJFC0K0C0J0C0F83F0780J0700FHF80FKF0,"+;
	"J03FMF87FJFC0J03E0J0F0FCFE9F80J0C01FHF80FKF0,J03FhGFC07FHFC07FJF0,J03FhGF807FHFE07FJF0,"+;
	"J03FhFD00FJF0FKF0,J03FhGFH0KF8FKF0,J03FhF801FQF0,J03FhFC03FQF0,J03FgYFE807FQF0,J03FhF80FRF0,"+;
	"J03FgYFE007FQF0,J03FgYFH03FRF0,J03FgXFD003FRF0,J0BFgYFH0TF0,J03FgXFC00FSF0,J03FgWFE003FSF0,"+;
	"J03FgXFH02FSF0,J03FKF8FgPF8007FSF0,J03FKF81FgNFE001FTF0,J03FKF01BFgMF8003FTF0,J03FKFH03FgMF8003FTF0,"+;
