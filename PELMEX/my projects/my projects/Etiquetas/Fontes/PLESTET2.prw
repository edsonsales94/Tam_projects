	"J03FhUF0,::::::::::::J03FgHF1FIFD020H03FMFBFJF1FKF0,J03FMFL07C0J01C0FIFE0K0780J0707FIF0BFJF0,"+;
	"J0BFMF8008003C0H0801C8FIFE0080H0F80080078FIFE0FKF0,J03FMFL01C0J01C0FIFE0K0780J0301FHFA03FJF0,"+;
