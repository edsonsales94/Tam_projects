	"J03FNFC0J03FUF80I0YF0,J03FNFE0J02FUFJ01FXF0,J03FOFE0K043FPF20I02FYF0,J03FQFL018ABFJF9C80J0gGF0,"+;
	"J03FQF80M01FJF90K01FgF0,J03FQFA80N09E80M03FgF0,J03FRF80X01FgGF0,J03FSF80080H080H080H08001FgHF0,J03FSFHE80S0H3gIF0,"+;
	"J03FUFE0S0gKF0,J03FVFS01FgJF0,J03FVFHDC0N0BFgKF0,J03FYF80K08FgMF0,J03FYF27FFCFF9FgMF0,J03FhUF0,J0BFhUF0,J03FhUF0,"+;
	":::::::J03FhTFE0,::J02FhTFE0,J03FhTFE0,K0hUFE0,K07FhSFC0,J08FhTFE0,K07FhSFC0,K07FhSF,K07FhSF80,L0hT8,,"+;
	"::::::::::~DG002.GRF,02944,092,nYF8,:::::::,:::::::::::::::::::::::"
	*/
	While !ETQ->(EOF())           

		SB1->(dbSeek(xFilial("SB1")+Etq->C2_PRODUTO))
		cSeqB1 := Soma1(SB1->B1_CHASSIS,6)
		RecLock("SB1",.F.)
		//SB1->B1_CHASSIS := cSeqB1
		SB1->(MsUnlock())
		cCodBar := Etq->C2_OP + " " +  (Etq->C2_PRODUTO) + " " + (cSeqB1)
		//cCodBar := "123456789"
		aComp := {}
		if Len(Alltrim(SB1->B1_XCOMP)) <> 0 
			aAdd(aComp,SB1->B1_XCOMP)
		EndIf
		if Len(Alltrim(SB1->B1_XCOMP1)) <> 0 
			aAdd(aComp,SB1->B1_XCOMP1)
		EndIf
		if Len(Alltrim(SB1->B1_XCOMP2)) <> 0 
			aAdd(aComp,SB1->B1_XCOMP2)
		EndIf
		if Len(Alltrim(SB1->B1_XCOMP3)) <> 0 
			aAdd(aComp,SB1->B1_XCOMP3)
		EndIf
		For nX := 1 to mv_par02
			nMargX     := 2
			nMargY     := 0
			/*
			SB1->(dbSeek(xFilial("SB1")+Etq->C2_PRODUTO))
			cSeqB1 := Soma1(SB1->B1_CHASSIS,6)
			RecLock("SB1",.F.)
			SB1->B1_CHASSIS := cSeqB1
			SB1->(MsUnlock())
			*/	

			//		MSCBWRITE("^XA~TA0~JSO^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD0^JUS^LRN^CI0^XZ"+cLogo+"^XA^LL0799^PW1200")		

			//MSCBWRITE("^XA~TA000~JSN^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD10^JUS^LRN^CI0^XZ"+cLogo+"^XA^LL1200^PW1200") //Alterado 12/06/08 		

			// 1o. Quadro
			//                Coordenadas           Formato Fonte         Texto



			nMargY :=  10 //nMargY  +1
			nMargX :=  05	//nMargx  +1

			//MSCBSAY(nMargX , nMargY + 05 ,"INDUSTRIA BRASILEIRA                 CNPJ:  10.755.005/0001-88" ,"N", "0", "30,28")

			MsCbPrinter("Z4M","LPT1",,,.F.,,,,)
			MsCbChkStatus(.F.)

			MsCbBegin( 1, 6)

			//		MSCBWRITE("^XA~TA0~JSO^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD0^JUS^LRN^CI0^XZ"+cLogo+"^XA^LL0799^PW1200")		

			//MSCBWRITE("^XA~TA000~JSN^LT0^MMT^MNW^MTT^PON^PMN^LH0,0^JMA^PR4,4^MD10^JUS^LRN^CI0^XZ"+cLogo+"^XA^LL1200^PW1200") //Alterado 12/06/08 		

			// 1o. Quadro
			//                Coordenadas           Formato Fonte         Texto

			//		MSCBWRITE("^FT" + "00,192"   + "^XG" + "001.GRF,"+ "1,1" + "^FS")	//Logo
			//		MSCBWRITE("^BY" + "5,2,151" + "^FT" + "412,167" + "^BEN,,Y,N")		//Codigo EAN   5
			//		MSCBWRITE("^FD" +  AllTrim(Etq->B1_CODBAR) + "^FS")		   		    //Codigo EAN
			MSCBWRITE("^FT" + "32,090"  + "^A0N," + "40,38" + " ^FH\^FD" + 'PROBEL' + "^FS")
			MSCBWRITE("^FT" + "32,140"  + "^A0N," + "40,38" + " ^FH\^FD" +  "CNPJ:" +;
			Transform(SM0->M0_CGC,"@R 99.999.999/9999-99") + " IND.BRASILEIRA" + "^FS")

			MsCbLineH(05,19,200,3,'B')
			/*
			MSCBWRITE("^FT" + "32,175"   + "^XG" + "002.GRF,"+ "1,1" + "^FS")	//LINHA
			MSCBWRITE("^FT" + "82,175"   + "^XG" + "002.GRF,"+ "1,1" + "^FS")	//LINHA

			MSCBWRITE("^FT" + "32,325"   + "^XG" + "002.GRF,"+ "1,1" + "^FS")	//LINHA
			MSCBWRITE("^FT" + "82,325"   + "^XG" + "002.GRF,"+ "1,1" + "^FS")	//LINHA
			*/
			MsCbLineH(05,38,100,3,'B')
			MsCbLineV(100,38,200,3,'B')
			MsCbLineV(137,38,200,3,'B')

			MSCBWRITE("^FT" + "32,190"   + "^A0N," + "40,38"         + "^FH\^FD" + "PRODUTO : " + PADR(SB1->B1_DESC,30) +  "^FS")
			MSCBWRITE("^FT" + "32,230"   + "^A0N," + "40,38"         + "^FH\^FD" + "REFERENCIA : " + PADR(SB1->B1_COD,30) +  "^FS")
			MSCBWRITE("^FT" + "32,280"   + "^A0N," + "40,38"         + "^FH\^FD" + "DIMENSAO : "  + "^FS")
			MSCBWRITE("^FT" + "282,280"  + "^A0N," + "60,58"         + "^FH\^FD" + "138x188x036"  + "^FS")

			//MSCBWRITE("^BY" + "2,4,240"  + "^FT"   + "1050,1100"        + " ^BCB,,Y,N")
			MSCBWRITE("^BY" + "2,4,200"  + "^FT"   + "850,320"        + " ^BCR,,Y,N")
			//MSCBWRITE("^FD" + Etq->C2_OP + "  "     + Etq->C2_PRODUTO +" "+ cSeqB1 + "^FS")
			MSCBWRITE("^FD" + Etq->C2_OP + " " + Etq->C2_PRODUTO + " " + cSeqB1 + "^FS") //ALTERADO POR LUIZ - ESPACOS ENTRE CARACTERES 

			MSCBWRITE("^FT" + "32,346"   + "^A0N," + "40,38"         + "^FH\^FD" + "COMPOSICAO DO TECIDO: "  + "^FS")
			nLin := 386
			if !EMPTY(SB1->B1_XCOMP) //Len(Alltrim(SB1->B1_XCOMP)) <> 0 
				MSCBWRITE("^FT" + "32," + Alltrim(Str(nLin)) + "^A0N," + "20,18" + "^FH\^FD" + SB1->B1_XCOMP + "^FS")
				nLin += 20
			EndIf
			if !EMPTY(SB1->B1_XCOMP1) //Len(Alltrim(SB1->B1_XCOMP1)) <> 0 
				MSCBWRITE("^FT" + "32," + Alltrim(Str(nLin)) + "^A0N," + "20,18" + "^FH\^FD" + SB1->B1_XCOMP1 + "^FS")
				nLin += 20
			EndIf
			if !EMPTY(SB1->B1_XCOMP2) //Len(Alltrim(SB1->B1_XCOMP2)) <> 0
				MSCBWRITE("^FT" + "32," + Alltrim(Str(nLin)) + "^A0N," + "20,18" + "^FH\^FD" + SB1->B1_XCOMP2 + "^FS")
				nLin += 20
			EndIf
			if !EMPTY(SB1->B1_XCOMP3) //Len(Alltrim(SB1->B1_XCOMP3)) <> 0 
				MSCBWRITE("^FT" + "32," + Alltrim(Str(nLin)) + "^A0N," + "20,18" + "^FH\^FD" + SB1->B1_XCOMP3 + "^FS")
				nLin += 20
			EndIf

			MsCbLineH(05,79,100,3,'B')

			MSCBWRITE("^FT" + "32,676"   + "^A0N," + "40,38"         + "^FH\^FD" + "CUIDADOS PARA CONSERVACAO: "  + "^FS")
			MSCBWRITE("^FT" + "32,716"   + "^A0N," + "20,18"         + "^FH\^FD" + "NAO LAVAR   " + "^FS")
			MSCBWRITE("^FT" + "32,736"   + "^A0N," + "20,18"         + "^FH\^FD" + "NAO USAR ALVEJANTE A BASE DE CLORO" + "^FS")
			MSCBWRITE("^FT" + "32,756"   + "^A0N," + "20,18"         + "^FH\^FD" + "NAO SECAR EM MAQUINAS TAMBOR ROTATIVO" + "^FS")
			MSCBWRITE("^FT" + "32,776"   + "^A0N," + "20,18"         + "^FH\^FD" + "NAO PASSAR A FERRO OU USAR VAPORIZACAO" + "^FS")
			MSCBWRITE("^FT" + "32,796"   + "^A0N," + "20,18"         + "^FH\^FD" + "NAO LIMPAR A SECO, NAO USAR SOLVENTE" + "^FS")

			MSCBWRITE("^FT" + "32,986"   + "^A0N," + "40,38"         + "^FH\^FD" + "Data Fab.: " + DTOC(dDataBase)  + "^FS")
			MSCBWRITE("^FT" + "32,1026"   + "^A0N," + "40,38"         + "^FH\^FD" + "Carga :               "  + "^FS")

			MsCbLineH(05,118,100,3,'B') 
			/*
			MSCBWRITE("^FT" + "32,650"   + "^A0N," + "28,60"         + "^FH\^FD" + "EXPEDICAO" + "^FS")
			//		MSCBWRITE("^BY" + "3,3,200"  + "^FT"   + "32,874"        + "^BCN,,Y,N") --> EAN 128
			MSCBWRITE("^BY" + "2,3,200"  + "^FT"   + "32,874"        + "^B3N,N,,Y,N")// CODE 39
			MSCBWRITE("^FD" + Etq->C2_PRODUTO + Etq->B1_COR + cSeqB1 + "^FS") //ALTERADO POR LUIZ - ESPACOS ENTRE CARACTERES

			//		MSCBWRITE("^FT" + "32,953" + "^A0N," + "28,45" + "^FH\^FD" + cNome +"^FS")
			//		MSCBWRITE("^FT" + "31,993" + "^A0N," + "28,45" + "^FH\^FD" + cSite +"^FS")
			*/		

			MsCbEnd()

			MsCbClosePrinter()
			/*		
			SC2->(dbSeek(xFilial("SC2")+Etq->C2_OP+Etq->C2_PRODUTO))
			RecLock("SC2",.F.)
			SC2->C2_YSLDIMP := SC2->C2_YSLDIMP + 1
			SC2->(MsUnlock())
			*/
		Next nX
		ETQ->(dbSkip())
	EndDo	
	ETQ->(dbCloseArea())
Return .T.

/*_______________________________________________________________________________
¦ Função    ¦ ValidPerg  ¦ Autor ¦ Ulysses Ribeiro          ¦ Data ¦ 23/11/2006 ¦
+-----------+------------+-------+--------------------------+------+------------+
¦ Descriçäo ¦ Criação das Perguntas SX1													  ¦
¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯¯*/

Static Function ValidPerg(cPerg)

	u_InPutSX1(cPerg,"01","OP		: ","", "", "mv_ch1","C",11,0,0,"G","","","","","mv_par01")
	u_InPutSX1(cPerg,"02","Etiquetas: ","", "", "mv_ch2","N",02,0,0,"G","","","","","mv_par02")

Return Nil
