		_cAviso    := STRTRAN(_cAviso,"²","\FD")
		_cAviso    := STRTRAN(_cAviso,"³","\FC")

		For I := 1 To 6 Step 1
			cLinhaAviso[I]  := SubStr(_cAviso,nP1,AT(cPesq1,_cAviso)-1)
			nP1 := AT(cPesq1,_cAviso) + 1
			_cAviso := SubStr(_cAviso,nP1)
