	_cModelo := Etq->B1_XMODELO

	//MsCbPrinter("ZM400","LPT1",,,.F.,,,,)\\

	If (AllTrim(Etq->B1_AVISO) == "") .and. (AllTrim(Etq->B1_XETIQUE) == "")
