					MSCBWRITE("^FD>:"+AllTrim(Etq->B1_COD)+"^FS")
				else
					MSCBWRITE("^FD>:"+AllTrim(Etq->B1_CODBAR)+"^FS")
				endIf
				MSCBWRITE("^FT643,1124^A0B,50,52^FH\^FD"+AllTrim(Etq->B1_DESC)+"^FS")
				MSCBWRITE("^FT542,971^A0B,50,52^FH\^FD"+AllTrim(Etq->B1_COD)+"^FS")
				MSCBWRITE("^FT805,1122^A0B,58,62^FH\^FDMedidas: "+AllTrim(Etq->B1_XACL)+"^FS")
				If(AllTrim(Etq->B1_X_DTOP))== ""
					MSCBWRITE("^FT891,1120^A0B,67,62^FH\^FDData de Fabrica\87\C6o: "+DtoC(StoD(Etq->C2_EMISSAO))+"^FS")
				else
					MSCBWRITE("^FT891,1120^A0B,67,62^FH\^FDData de Fabrica\87\C6o: "+DtoC(StoD(Etq->B1_X_DTOP))+"^FS")
				endif
				MSCBWRITE("^FT1347,660^A0B,50,50^FH\^FDFEITO NO BRASIL^FS")
				MSCBWRITE("^FT727,1123^A0B,67,64^FH\^FDOP:"+AllTrim(cCodBarProd)+"^FS")
				MSCBWRITE("^FT1020,635^BQN,2,9")
				IF AllTrim(Etq->B1_XURL) == ""
					MSCBWRITE("^FH\^FDLA,WWW.PELMEX.COM.BR^FS")
				ELSE
					MSCBWRITE("^FH\^FDLA,"+AllTrim(Etq->B1_XURL)+"^FS")
				ENDIF
