User Function PLCOMR14()
	Local oReport
	Local cQuery
	Local cAlias      := getNextAlias()      

	Private cPerg     := "PLCOMR14"

	AjustaSX1(cPerg)
	Pergunte(cPerg,.F.)

	oReport := ReportDef(cAlias,cPerg)
	oReport:PrintDialog()
Return


Static Function ReportDef(cAlias,cPerg)
	Local oReport
	Local oSection
	Local oBreak
	Local aOrdem      := {"FILIAL"}

	oReport := TReport():New(cPerg,"Rel. Ranking de Fornecedores",cPerg,{|oReport| PrintReport(oReport,cAlias)}, )
	oReport:SetPortrait()      
	oReport:SetEnvironment(2)      

	//Primeira se็ใo
	oSection := TRSection():New(oReport,"Rel. Ranking de Fornecedores",{"SC7"},aOrdem)  
	
	
	TRCell():New(oSection,"EMPRESA"	  		            ,"SC7","EMPRESA","@!",6)
	TRCell():New(oSection,"D4_COD"	   	                ,"SD4","CODIGO","@!",20)
	TRCell():New(oSection,"B1_DESC"	   	                ,"SB1","DESCRICAO","@!",30)
	TRCell():New(oSection,"B1_UM"	   		            ,"SB1","UM","@!",3) 
    TRCell():New(oSection,"QTDM1"  		                ,"SC7","QTD ULTIMO ENTRADA","@E 999,999,999.999.99")
    TRCell():New(oSection,"VM1"  		                ,"SC7","VALOR ULTIMA ENTRADA","@E 999,999,999.999.99")
	TRCell():New(oSection,"DT1"	   	                    ,"SC7","DATA ULTIMA ENTRADA","@!",10)
    TRCell():New(oSection,"QTDM2"  		                ,"SC7","QTD PENULTIMA ENTRADA","@E 999,999,999.999.99")
	TRCell():New(oSection,"VM2"  		                ,"SC7","VALOR PENULTIMA ENTRADA","@E 999,999,999.999.99")
	TRCell():New(oSection,"DT2"	   	                    ,"SC7","DATA PENULTIMA ENTRADA","@!",10)
    TRCell():New(oSection,"QTDM3"  		                ,"SC7","QTD ANTEPENULTIMA ENTRADA","@E 999,999,999.999.99")
    TRCell():New(oSection,"VM3"  		                ,"SC7","VALOR ANTEPENULTIMA ENTRADA","@E 999,999,999.999.99")
    TRCell():New(oSection,"DT3"	   	                    ,"SC7","DATA ANTEPENULIMA ENTRADA","@!",10)
    TRCell():New(oSection,"QTD_CONSUMIDA"  		        ,"SC7","QTD CONSUMIDA NO PERIODO","@E 999,999,999.999.99")
    TRCell():New(oSection,"CONSUMO_MEDIO"  		        ,"SC7","CONSUMO_MEDIO","@E 999,999,999.999.99")
    TRCell():New(oSection,"QTD_ATUAL"  		            ,"SC7","SALDO ATUAL","@E 999,999,999.999.99")
    TRCell():New(oSection,"QTD_FINAL_QTD_TRANSITO"  	,"SC7","QTD ATUAL + QTD TRANSITO","@E 999,999,999.999.99")
    TRCell():New(oSection,"COBERTURA_MEDIA"  	        ,"SC7","COBERTURA MEDIA SALDO ATUAL","@E 999,999,999.999.99")
    TRCell():New(oSection,"COBERTURA_MEDIA_TRANSITO"  	,"SC7","COBERTURA MEDIA SALDO ATUAL + TRANSITO","@E 999,999,999.999.99")
    TRCell():New(oSection,"B1_EMIN" 		            ,"SB1","PONTO DE PEDIDO","@E 999,999,999.999.99")
    TRCell():New(oSection,"QTDB"                    ,"SC7","QTD BASE PEDIDO","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO"  		        ,"SC7","VALOR PEDIDO","@E 999,999,999.999.99")
    TRCell():New(oSection,"B1_UPRC"	                    ,"SB1","ULTIMO PRECO ENTRADA","@E 999,999,999.999.99")
    TRCell():New(oSection,"VARIACAOPRECO" 		        ,"SC7","VARIACAO DE PRECO","@E 999,999,999.999.99")
    TRCell():New(oSection,"TBA"	   	            ,"SC7","TOTAL BASE PEDIDO","@E 999,999,999.999.99")
    TRCell():New(oSection,"DT_COMPRA1"	   	            ,"SC7","DT COMPRA1","@!",10)
    TRCell():New(oSection,"DT_COMPRA2"	   	            ,"SC7","DT COMPRA2","@!",10)
    TRCell():New(oSection,"DT_COMPRA3"	   	            ,"SC7","DT COMPRA3","@!",10)
    TRCell():New(oSection,"DT_COMPRA4"	    	        ,"SC7","DT COMPRA4","@!",10)
    TRCell():New(oSection,"DT_COMPRA5"	   	            ,"SC7","DT COMPRA5","@!",10)
    TRCell():New(oSection,"DT_COMPRA6"	   	            ,"SC7","DT COMPRA6","@!",10)
    TRCell():New(oSection,"QTDP1"       		        ,"SC7","QTD PEDIDO1","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO1"  		        ,"SC7","VAL PEDIDO1","@E 999,999,999.999.99")
    TRCell():New(oSection,"B1_UPRC"  		            ,"SB1","ULTIMO PRECO ENTRADA","@E 999,999,999.999.99")
    TRCell():New(oSection,"VARIACAOPRECO1"  		    ,"SC7","VARIACAO PRECO1","@E 999,999,999.999.99")
    TRCell():New(oSection,"TP1"  		        ,"SC7","TOTAL PEDIDO1","@E 999,999,999.999.99")
    TRCell():New(oSection,"DATPRF1"  		            ,"SC7","DATA ENTREGA PEDIDO1","@!",10)
    TRCell():New(oSection,"QTDP2"  		        ,"SC7","QTD PEDIDO2","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO2"  		        ,"SC7","VAL PEDIDO2","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO1"  		        ,"SC7","VAL PEDIDO1","@E 999,999,999.999.99")
    TRCell():New(oSection,"VARIACAOPRECO2"  		    ,"SC7","VARIACAO PRECO2","@E 999,999,999.999.99")
    TRCell():New(oSection,"TP2"  		        ,"SC7","TOTAL PEDIDO2","@E 999,999,999.999.99")
    TRCell():New(oSection,"DATPRF2"  		            ,"SC7","DATA ENTREGA PEDIDO2","@!",10)
    TRCell():New(oSection,"QTDP3"  		        ,"SC7","QTD PEDIDO3","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO3"  		        ,"SC7","VAL PEDIDO3","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO2"  		        ,"SC7","VAL PEDIDO2","@E 999,999,999.999.99")
    TRCell():New(oSection,"VARIACAOPRECO3"  		    ,"SC7","VARIACAO PRECO3","@E 999,999,999.999.99")
    TRCell():New(oSection,"TP3"  		        ,"SC7","TOTAL PEDIDO3","@E 999,999,999.999.99")
    TRCell():New(oSection,"DATPRF3"  		            ,"SC7","DATA ENTREGA PEDIDO3","@!",10)
    TRCell():New(oSection,"QTDP4"  		        ,"SC7","QTD PEDIDO4","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO4"  		        ,"SC7","VAL PEDIDO4","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO3"  		        ,"SC7","VAL PEDIDO3","@E 999,999,999.999.99")
    TRCell():New(oSection,"VARIACAOPRECO4"  		    ,"SC7","VARIACAO PRECO4","@E 999,999,999.999.99")
    TRCell():New(oSection,"TP4"  		        ,"SC7","TOTAL PEDIDO4","@E 999,999,999.999.99")
    TRCell():New(oSection,"DATPRF4"  		            ,"SC7","DATA ENTREGA PEDIDO4","@!",10)
    TRCell():New(oSection,"QTDP5"  		        ,"SC7","QTD PEDIDO5","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO4"  		        ,"SC7","VAL PEDIDO4","@E 999,999,999.999.99")
    TRCell():New(oSection,"VARIACAOPRECO5"  		    ,"SC7","VARIACAO PRECO5","@E 999,999,999.999.99")
    TRCell():New(oSection,"TP5"  		        ,"SC7","TOTAL PEDIDO5","@E 999,999,999.999.99")
    TRCell():New(oSection,"DATPRF5"  		            ,"SC7","DATA ENTREGA PEDIDO5","@!",10)
    TRCell():New(oSection,"QTDP6"  		        ,"SC7","QTD PEDIDO6","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO6"  		        ,"SC7","VAL PEDIDO6","@E 999,999,999.999.99")
    TRCell():New(oSection,"VALPEDIDO5"  		        ,"SC7","VAL PEDIDO5","@E 999,999,999.999.99")
    TRCell():New(oSection,"VARIACAOPRECO6"  		    ,"SC7","VARIACAO PRECO6","@E 999,999,999.999.99")
    TRCell():New(oSection,"TP6"  		        ,"SC7","TOTAL PEDIDO6","@E 999,999,999.999.99")
    TRCell():New(oSection,"DATPRF6"  		            ,"SC7","DATA ENTREGA PEDIDO6","@!",10)

	
	//Totalizador                                                                                  
	//TRFunction():New(oSection:Cell("ETIQUETA"),"Etiqueta:","SUM",,,"@E 999,999,999,999",,.F.,.T.)

Return oReport


/*Inicia Logica Print Report */

Static Function PrintReport(oReport,cAlias)
	Local oSection  := oReport:Section(1)

	//if oReport:Section(1):GetOrder() == 1
	//	cOrdem := "A1_COD"
	//endif      

//inicia o Sql
	oSection:BeginQuery()
	BeginSQL Alias cAlias
		%noparser%



SELECT EMPRESA,D4_COD,B1_DESC,B1_UM,
       QTDM1,VM1,DT1,QTDM2,VM2,DT2,QTDM3,VM3,DT3,
	   QTD_CONSUMIDA,CONSUMO_MEDIO,QTD_ATUAL,QTD_TRANSITO,QTD_FINAL_QTD_TRANSITO,
	   COBERTURA_MEDIA,COBERTURA_MEDIA_TRANSITO,B1_EMIN,
       CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONSUMO_MEDIO ELSE 0 END QTDB,
	   VALPEDIDO,B1_UPRC,
	   CASE WHEN (B1_UPRC > 0 AND VALPEDIDO > 0) THEN CASE WHEN VALPEDIDO < B1_UPRC THEN (100-((VALPEDIDO * 100) / B1_UPRC))*-1 ELSE (100-((VALPEDIDO * 100)/B1_UPRC))*-1 END ELSE 0 END VARIACAOPRECO,
       CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CASE WHEN VALPEDIDO > 0 THEN CONSUMO_MEDIO * VALPEDIDO ELSE CONSUMO_MEDIO * B1_UPRC END ELSE 0 END TBA,
       CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT), GETDATE ())-7,103) ELSE '' END DT_COMPRA1,
	   CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT)+1, GETDATE ())-7,103) ELSE '' END DT_COMPRA2,
	   CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT)+2, GETDATE ())-7,103) ELSE '' END DT_COMPRA3,
	   CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT)+3, GETDATE ())-7,103) ELSE '' END DT_COMPRA4,
	   CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT)+4, GETDATE ())-7,103) ELSE '' END DT_COMPRA5,
	   CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT)+5, GETDATE ())-7,103) ELSE '' END DT_COMPRA6,
	   QTDP1,VALPEDIDO1,B1_UPRC,
	   CASE WHEN (B1_UPRC > 0 AND VALPEDIDO1 > 0) THEN CASE WHEN VALPEDIDO1 < B1_UPRC THEN (100 - ((VALPEDIDO1 * 100) / B1_UPRC)) *-1 ELSE (100 - ((VALPEDIDO1 * 100) / B1_UPRC)) *-1 END ELSE 0 END VARIACAOPRECO1,
	   QTDP1 * VALPEDIDO1 TP1,DATPRF1,
	   QTDP2,VALPEDIDO2,VALPEDIDO1,
	   CASE WHEN (VALPEDIDO1 > 0 AND VALPEDIDO2 > 0) THEN CASE WHEN VALPEDIDO2 < VALPEDIDO1 THEN (100 - ((VALPEDIDO2 * 100) / VALPEDIDO1)) *-1 ELSE (100 - ((VALPEDIDO2 * 100) / VALPEDIDO1)) *-1 END ELSE 0 END VARIACAOPRECO2,
	   QTDP2 * VALPEDIDO2 TP2,DATPRF2,
	   QTDP3,VALPEDIDO3,VALPEDIDO2,
	   CASE WHEN (VALPEDIDO2 > 0 AND VALPEDIDO3 > 0) THEN CASE WHEN VALPEDIDO3 < VALPEDIDO2 THEN (100 - ((VALPEDIDO3 * 100) / VALPEDIDO2)) *-1 ELSE (100 - ((VALPEDIDO3 * 100) / VALPEDIDO2)) *-1 END ELSE 0 END VARIACAOPRECO3,
	   QTDP3 * VALPEDIDO3 TP3,DATPRF3,
	   QTDP4,VALPEDIDO4,VALPEDIDO3,
	   CASE WHEN (VALPEDIDO3 > 0 AND VALPEDIDO4 > 0) THEN CASE WHEN VALPEDIDO4 < VALPEDIDO3 THEN (100 - ((VALPEDIDO4 * 100) / VALPEDIDO3)) *-1 ELSE (100 - ((VALPEDIDO4 * 100) / VALPEDIDO3)) *-1 END ELSE 0 END VARIACAOPRECO4,
	   QTDP4 * VALPEDIDO4 TP4,DATPRF4,
	   QTDP5,VALPEDIDO5,VALPEDIDO4,
	   CASE WHEN (VALPEDIDO4 > 0 AND VALPEDIDO5 > 0) THEN CASE WHEN VALPEDIDO5 < VALPEDIDO4 THEN (100 - ((VALPEDIDO5 * 100) / VALPEDIDO4)) *-1 ELSE (100 - ((VALPEDIDO5 * 100) / VALPEDIDO4)) *-1 END ELSE 0 END VARIACAOPRECO5,
	   QTDP5 * VALPEDIDO5 TP5,DATPRF5,
	   QTDP6,VALPEDIDO6,VALPEDIDO5,
	   CASE WHEN (VALPEDIDO5 > 0 AND VALPEDIDO6 > 0) THEN CASE WHEN VALPEDIDO6 < VALPEDIDO5 THEN (100 - ((VALPEDIDO6 * 100) / VALPEDIDO5)) *-1 ELSE (100 - ((VALPEDIDO6 * 100) / VALPEDIDO5)) *-1 END ELSE 0 END VARIACAOPRECO6,
	   QTDP6 * VALPEDIDO6 TP6,DATPRF6
FROM(
SELECT 'PELMEX' EMPRESA,D4_COD,B1_DESC,B1_UM,
       ISNULL(QTDM1,0)QTDM1,ISNULL(V1,0)VM1,
       CASE WHEN DT1 IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(DT1 AS DATE),103) END DT1,
	   ISNULL(QTDM2,0)QTDM2,ISNULL(V2,0)VM2,
       CASE WHEN DT2 IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(DT2 AS DATE),103) END DT2,
	   ISNULL(QTDM3,0)QTDM3,ISNULL(V3,0)VM3,
       CASE WHEN DT3 IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(DT3 AS DATE),103) END DT3,
	   B1_UPRC,B1_EMIN,
	   SUM(D4_QTDEORI)QTD_CONSUMIDA,
	   SUM(D4_QTDEORI) / (DATEDIFF(MONTH,%Exp:MV_PAR01%,%Exp:MV_PAR02%)+1) CONSUMO_MEDIO,
	   ISNULL(QTD_01,0) + ISNULL(QTD_10,0)QTD_ATUAL,
	   ISNULL(QTD_PEDIDO,0)QTD_TRANSITO,
	   ISNULL(VAL_PEDIDO,0)VALPEDIDO,
	   ISNULL(QTD_01,0) + ISNULL(QTD_10,0) + ISNULL(QTD_PEDIDO,0)QTD_FINAL_QTD_TRANSITO,
	   (ISNULL(QTD_01,0) + ISNULL(QTD_10,0)) / (SUM(D4_QTDEORI) / (DATEDIFF(MONTH,%Exp:MV_PAR01%,%Exp:MV_PAR02%)+1)) COBERTURA_MEDIA,
	   (ISNULL(QTD_01,0) + ISNULL(QTD_10,0) + ISNULL(QTD_PEDIDO,0)) / (SUM(D4_QTDEORI) / (DATEDIFF(MONTH,%Exp:MV_PAR01%,%Exp:MV_PAR02%)+1)) COBERTURA_MEDIA_TRANSITO,
	   ISNULL(QTD_PEDIDO1,0) QTDP1,ISNULL(VAL_PEDIDO1,0) VALPEDIDO1,ISNULL(DATPRF1,'') DATPRF1,
	   ISNULL(QTD_PEDIDO2,0) QTDP2,ISNULL(VAL_PEDIDO2,0) VALPEDIDO2,ISNULL(DATPRF2,'') DATPRF2,
	   ISNULL(QTD_PEDIDO3,0) QTDP3,ISNULL(VAL_PEDIDO3,0) VALPEDIDO3,ISNULL(DATPRF3,'') DATPRF3,
	   ISNULL(QTD_PEDIDO4,0) QTDP4,ISNULL(VAL_PEDIDO4,0) VALPEDIDO4,ISNULL(DATPRF4,'') DATPRF4,
	   ISNULL(QTD_PEDIDO5,0) QTDP5,ISNULL(VAL_PEDIDO5,0) VALPEDIDO5,ISNULL(DATPRF5,'') DATPRF5,
	   ISNULL(QTD_PEDIDO6,0) QTDP6,ISNULL(VAL_PEDIDO6,0) VALPEDIDO6,ISNULL(DATPRF6,'') DATPRF6
FROM(
SELECT D4_FILIAL,D4_DATA,D4_OP,D4_TRT,D4_COD,B1_DESC,B1_UM,D4_QTDEORI,D4_QUANT,B1_UPRC,B1_EMIN
FROM SD4100 SD4
INNER JOIN SB1100 SB1 ON D4_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
WHERE SD4.D_E_L_E_T_ = ''
AND D4_COD NOT LIKE 'MOD%'
AND D4_FILIAL = '01'
AND D4_LOCAL = '10'
AND D4_DATA BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
)TB
LEFT JOIN (SELECT B9_FILIAL,B9_COD,B9_QINI QTD_INI,B9_DATA DT_INI
           FROM SB9100 SB9
		   WHERE SB9.D_E_L_E_T_ = ''
		   AND B9_FILIAL = '01'
		   AND B9_LOCAL = '01'
		   AND B9_DATA IN (SELECT MAX(B9_DATA)B9_DATA
		                   FROM SB9100 SB9
						   WHERE SB9.D_E_L_E_T_ = ''))SB9 ON D4_FILIAL = B9_FILIAL AND D4_COD = B9_COD
LEFT JOIN (SELECT D1_FILIAL FIL1,D1_COD COD1,SUM(D1_QUANT)QTDM1,AVG(D1_VUNIT) V1,MAX(D1_DTDIGIT)DT1
           FROM(
		   SELECT D1_FILIAL,D1_DOC,D1_SERIE,D1_DTDIGIT,D1_COD,D1_QUANT,D1_VUNIT,D1_FORNECE,D1_LOJA
           FROM SD1100 SD1
		   INNER JOIN SB1100 SB1 ON D1_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
		   WHERE SD1.D_E_L_E_T_ = ''
		   AND D1_FILIAL = '01'
		   AND D1_TIPO = 'N'
		   AND D1_LOCAL = '01'
		   AND B1_TIPO IN ('MN','MI','MA','MC')
		   AND D1_DTDIGIT BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -1, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -1, GETDATE ()),112),1,6)+'31'
		   )TB
		   GROUP BY D1_FILIAL,D1_COD)SD11 ON D4_FILIAL = FIL1 AND D4_COD = COD1
LEFT JOIN (SELECT D1_FILIAL FIL2,D1_COD COD2,SUM(D1_QUANT)QTDM2,AVG(D1_VUNIT) V2,MAX(D1_DTDIGIT)DT2
           FROM(
		   SELECT D1_FILIAL,D1_DOC,D1_SERIE,D1_DTDIGIT,D1_COD,D1_QUANT,D1_VUNIT,D1_FORNECE,D1_LOJA
           FROM SD1100 SD1
		   INNER JOIN SB1100 SB1 ON D1_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
		   WHERE SD1.D_E_L_E_T_ = ''
		   AND D1_TIPO = 'N'
		   AND D1_FILIAL = '01'
		   AND D1_LOCAL = '01'
		   AND B1_TIPO IN ('MN','MI','MA','MC')
		   AND D1_DTDIGIT BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -2, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -2, GETDATE ()),112),1,6)+'31'
		   )TB
		   GROUP BY D1_FILIAL,D1_COD)SD12 ON D4_FILIAL = FIL2 AND D4_COD = COD2
LEFT JOIN (SELECT D1_FILIAL FIL3,D1_COD COD3,SUM(D1_QUANT)QTDM3,AVG(D1_VUNIT)V3,MAX(D1_DTDIGIT)DT3
           FROM(
		   SELECT D1_FILIAL,D1_DOC,D1_SERIE,D1_DTDIGIT,D1_COD,D1_QUANT,D1_VUNIT,D1_FORNECE,D1_LOJA
           FROM SD1100 SD1
		   INNER JOIN SB1100 SB1 ON D1_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
		   WHERE SD1.D_E_L_E_T_ = ''
		   AND D1_FILIAL = '01'
		   AND D1_TIPO = 'N'
		   AND D1_LOCAL = '01'
		   AND B1_TIPO IN ('MN','MI','MA','MC')
		   AND D1_DTDIGIT BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -3, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -3, GETDATE ()),112),1,6)+'31'
		   )TB
		   GROUP BY D1_FILIAL,D1_COD)SD13 ON D4_FILIAL = FIL3 AND D4_COD = COD3
LEFT JOIN (SELECT SB2.B2_FILIAL,SB2.B2_COD,SB2.B2_QATU QTD_01
           FROM SB2100 SB2
		   INNER JOIN SB1100 SB1 ON B2_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
		   WHERE SB2.D_E_L_E_T_ = ''
		   AND B2_FILIAL = '01'
		   AND B2_LOCAL = '01'
		   AND B1_TIPO IN ('MN','MI','MA','MC'))SB2 ON D4_FILIAL = SB2.B2_FILIAL AND D4_COD = SB2.B2_COD
LEFT JOIN (SELECT SB21.B2_FILIAL,SB21.B2_COD,SB21.B2_QATU QTD_10
           FROM SB2100 SB21
		   INNER JOIN SB1100 SB1 ON B2_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
		   WHERE SB21.D_E_L_E_T_ = ''
		   AND B2_FILIAL = '01'
		   AND B2_LOCAL = '10'
		   AND B1_TIPO IN ('MN','MI','MA','MC'))SB21 ON D4_FILIAL = SB21.B2_FILIAL AND D4_COD = SB21.B2_COD
LEFT JOIN ( SELECT C7_FILIAL,C7_PRODUTO,MAX(C7_EMISSAO)C7_EMISSAO,SUM(C7_QUANT)-SUM(C7_QUJE)QTD_PEDIDO,AVG(C7_PRECO)VAL_PEDIDO
            FROM(
            SELECT C7_FILIAL,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)C7_DATPRF,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)C7_EMISSAO,C7_NUM,C7_ITEM,C7_PRODUTO,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT,C7_PRECO,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7100 SC7 (NOLOCK)
			INNER JOIN SB1100 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2100 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_EMISSAO >= '20240101'	  
		    )TB
			GROUP BY C7_FILIAL,C7_PRODUTO)SC7 ON D4_FILIAL = C7_FILIAL AND D4_COD = C7_PRODUTO
LEFT JOIN ( SELECT FILIAL1,PRODUTO1,MAX(DATPRF1) DATPRF1,(SUM(QTDC1) - SUM(C7_QUJE)) QTD_PEDIDO1,AVG(PRECO1) VAL_PEDIDO1
            FROM(
            SELECT C7_FILIAL FILIAL1,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF1,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO1,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO1,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC1,C7_PRECO PRECO1,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7100 SC7 (NOLOCK)
			INNER JOIN SB1100 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2100 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,GETDATE (),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,GETDATE (),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL1,PRODUTO1)SC71 ON D4_FILIAL = FILIAL1 AND D4_COD = PRODUTO1
LEFT JOIN ( SELECT FILIAL2,PRODUTO2,MAX(DATPRF2)DATPRF2,SUM(QTDC2)-SUM(C7_QUJE)QTD_PEDIDO2,AVG(PRECO2)VAL_PEDIDO2
            FROM(
            SELECT C7_FILIAL FILIAL2,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF2,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO1,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO2,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC2,C7_PRECO PRECO2,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7100 SC7 (NOLOCK)
			INNER JOIN SB1100 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2100 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 1, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 1, GETDATE ()),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL2,PRODUTO2)SC72 ON D4_FILIAL = FILIAL2 AND D4_COD = PRODUTO2
LEFT JOIN ( SELECT FILIAL3,PRODUTO3,MAX(DATPRF3)DATPRF3,SUM(QTDC3)-SUM(C7_QUJE)QTD_PEDIDO3,AVG(PRECO3)VAL_PEDIDO3
            FROM(
            SELECT C7_FILIAL FILIAL3,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF3,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO3,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO3,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC3,C7_PRECO PRECO3,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7100 SC7 (NOLOCK)
			INNER JOIN SB1100 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2100 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 2, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 2, GETDATE ()),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL3,PRODUTO3)SC73 ON D4_FILIAL = FILIAL3 AND D4_COD = PRODUTO3
LEFT JOIN ( SELECT FILIAL4,PRODUTO4,MAX(DATPRF4)DATPRF4,SUM(QTDC4)-SUM(C7_QUJE)QTD_PEDIDO4,AVG(PRECO4)VAL_PEDIDO4
            FROM(
            SELECT C7_FILIAL FILIAL4,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF4,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO1,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO4,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC4,C7_PRECO PRECO4,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7100 SC7 (NOLOCK)
			INNER JOIN SB1100 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2100 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 3, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 3, GETDATE ()),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL4,PRODUTO4)SC74 ON D4_FILIAL = FILIAL4 AND D4_COD = PRODUTO4
LEFT JOIN ( SELECT FILIAL5,PRODUTO5,MAX(DATPRF5)DATPRF5,SUM(QTDC5)-SUM(C7_QUJE)QTD_PEDIDO5,AVG(PRECO5)VAL_PEDIDO5
            FROM(
            SELECT C7_FILIAL FILIAL5,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF5,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO1,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO5,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC5,C7_PRECO PRECO5,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7100 SC7 (NOLOCK)
			INNER JOIN SB1100 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2100 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 4, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 4, GETDATE ()),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL5,PRODUTO5)SC75 ON D4_FILIAL = FILIAL5 AND D4_COD = PRODUTO5
LEFT JOIN ( SELECT FILIAL6,PRODUTO6,MAX(DATPRF6)DATPRF6,SUM(QTDC6)-SUM(C7_QUJE)QTD_PEDIDO6,AVG(PRECO6)VAL_PEDIDO6
            FROM(
            SELECT C7_FILIAL FILIAL6,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF6,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO1,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO6,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC6,C7_PRECO PRECO6,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7100 SC7 (NOLOCK)
			INNER JOIN SB1100 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2100 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 5, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 5, GETDATE ()),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL6,PRODUTO6)SC76 ON D4_FILIAL = FILIAL6 AND D4_COD = PRODUTO6
GROUP BY D4_FILIAL,D4_COD,B1_DESC,B1_UM,B1_UPRC,B1_EMIN,QTD_INI,DT_INI,QTDM1,V1,DT1,QTDM2,V2,DT2,QTDM3,V3,DT3,QTD_01,QTD_10,QTD_PEDIDO,VAL_PEDIDO,
         QTD_PEDIDO1,VAL_PEDIDO1,DATPRF1,QTD_PEDIDO2,VAL_PEDIDO2,DATPRF2,QTD_PEDIDO3,VAL_PEDIDO3,DATPRF3,QTD_PEDIDO4,VAL_PEDIDO4,DATPRF4,
		 QTD_PEDIDO5,VAL_PEDIDO5,DATPRF5,QTD_PEDIDO6,VAL_PEDIDO6,DATPRF6
)TB1
UNION
SELECT EMPRESA,D4_COD,B1_DESC,B1_UM,
       QTDM1,VM1,DT1,QTDM2,VM2,DT2,QTDM3,VM3,DT3,
	   QTD_CONSUMIDA,CONSUMO_MEDIO,QTD_ATUAL,QTD_TRANSITO,QTD_FINAL_QTD_TRANSITO,
	   COBERTURA_MEDIA,COBERTURA_MEDIA_TRANSITO,B1_EMIN,
       CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONSUMO_MEDIO ELSE 0 END QTDB,
	   VALPEDIDO,B1_UPRC,
	   CASE WHEN (B1_UPRC > 0 AND VALPEDIDO > 0) THEN CASE WHEN VALPEDIDO < B1_UPRC THEN (100-((VALPEDIDO * 100) / B1_UPRC))*-1 ELSE (100-((VALPEDIDO * 100)/B1_UPRC))*-1 END ELSE 0 END VARIACAOPRECO,
       CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CASE WHEN VALPEDIDO > 0 THEN CONSUMO_MEDIO * VALPEDIDO ELSE CONSUMO_MEDIO * B1_UPRC END ELSE 0 END TBA,
       CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT), GETDATE ())-7,103) ELSE '' END DT_COMPRA1,
	   CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT)+1, GETDATE ())-7,103) ELSE '' END DT_COMPRA2,
	   CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT)+2, GETDATE ())-7,103) ELSE '' END DT_COMPRA3,
	   CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT)+3, GETDATE ())-7,103) ELSE '' END DT_COMPRA4,
	   CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT)+4, GETDATE ())-7,103) ELSE '' END DT_COMPRA5,
	   CASE WHEN COBERTURA_MEDIA_TRANSITO <= 6 THEN CONVERT(VARCHAR,DATEADD (m, CAST(COBERTURA_MEDIA_TRANSITO AS INT)+5, GETDATE ())-7,103) ELSE '' END DT_COMPRA6,
	   QTDP1,VALPEDIDO1,B1_UPRC,
	   CASE WHEN (B1_UPRC > 0 AND VALPEDIDO1 > 0) THEN CASE WHEN VALPEDIDO1 < B1_UPRC THEN (100 - ((VALPEDIDO1 * 100) / B1_UPRC)) *-1 ELSE (100 - ((VALPEDIDO1 * 100) / B1_UPRC)) *-1 END ELSE 0 END VARIACAOPRECO1,
	   QTDP1 * VALPEDIDO1 TP1,DATPRF1,
	   QTDP2,VALPEDIDO2,VALPEDIDO1,
	   CASE WHEN (VALPEDIDO1 > 0 AND VALPEDIDO2 > 0) THEN CASE WHEN VALPEDIDO2 < VALPEDIDO1 THEN (100 - ((VALPEDIDO2 * 100) / VALPEDIDO1)) *-1 ELSE (100 - ((VALPEDIDO2 * 100) / VALPEDIDO1)) *-1 END ELSE 0 END VARIACAOPRECO2,
	   QTDP2 * VALPEDIDO2 TP2,DATPRF2,
	   QTDP3,VALPEDIDO3,VALPEDIDO2,
	   CASE WHEN (VALPEDIDO2 > 0 AND VALPEDIDO3 > 0) THEN CASE WHEN VALPEDIDO3 < VALPEDIDO2 THEN (100 - ((VALPEDIDO3 * 100) / VALPEDIDO2)) *-1 ELSE (100 - ((VALPEDIDO3 * 100) / VALPEDIDO2)) *-1 END ELSE 0 END VARIACAOPRECO3,
	   QTDP3 * VALPEDIDO3 TP3,DATPRF3,
	   QTDP4,VALPEDIDO4,VALPEDIDO3,
	   CASE WHEN (VALPEDIDO3 > 0 AND VALPEDIDO4 > 0) THEN CASE WHEN VALPEDIDO4 < VALPEDIDO3 THEN (100 - ((VALPEDIDO4 * 100) / VALPEDIDO3)) *-1 ELSE (100 - ((VALPEDIDO4 * 100) / VALPEDIDO3)) *-1 END ELSE 0 END VARIACAOPRECO4,
	   QTDP4 * VALPEDIDO4 TP4,DATPRF4,
	   QTDP5,VALPEDIDO5,VALPEDIDO4,
	   CASE WHEN (VALPEDIDO4 > 0 AND VALPEDIDO5 > 0) THEN CASE WHEN VALPEDIDO5 < VALPEDIDO4 THEN (100 - ((VALPEDIDO5 * 100) / VALPEDIDO4)) *-1 ELSE (100 - ((VALPEDIDO5 * 100) / VALPEDIDO4)) *-1 END ELSE 0 END VARIACAOPRECO5,
	   QTDP5 * VALPEDIDO5 TP5,DATPRF5,
	   QTDP6,VALPEDIDO6,VALPEDIDO5,
	   CASE WHEN (VALPEDIDO5 > 0 AND VALPEDIDO6 > 0) THEN CASE WHEN VALPEDIDO6 < VALPEDIDO5 THEN (100 - ((VALPEDIDO6 * 100) / VALPEDIDO5)) *-1 ELSE (100 - ((VALPEDIDO6 * 100) / VALPEDIDO5)) *-1 END ELSE 0 END VARIACAOPRECO6,
	   QTDP6 * VALPEDIDO6 TP6,DATPRF6
FROM(
SELECT 'AMAZON' EMPRESA,D4_COD,B1_DESC,B1_UM,
       ISNULL(QTDM1,0)QTDM1,ISNULL(V1,0)VM1,
       CASE WHEN DT1 IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(DT1 AS DATE),103) END DT1,
	   ISNULL(QTDM2,0)QTDM2,ISNULL(V2,0)VM2,
       CASE WHEN DT2 IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(DT2 AS DATE),103) END DT2,
	   ISNULL(QTDM3,0)QTDM3,ISNULL(V3,0)VM3,
       CASE WHEN DT3 IS NULL THEN '' ELSE CONVERT(VARCHAR,CAST(DT3 AS DATE),103) END DT3,
	   B1_UPRC,B1_EMIN,
	   SUM(D4_QTDEORI)QTD_CONSUMIDA,
	   SUM(D4_QTDEORI) / (DATEDIFF(MONTH,%Exp:MV_PAR01%,%Exp:MV_PAR02%)+1) CONSUMO_MEDIO,
	   ISNULL(QTD_01,0) + ISNULL(QTD_10,0)QTD_ATUAL,
	   ISNULL(QTD_PEDIDO,0)QTD_TRANSITO,
	   ISNULL(VAL_PEDIDO,0)VALPEDIDO,
	   ISNULL(QTD_01,0) + ISNULL(QTD_10,0) + ISNULL(QTD_PEDIDO,0)QTD_FINAL_QTD_TRANSITO,
	   (ISNULL(QTD_01,0) + ISNULL(QTD_10,0)) / (SUM(D4_QTDEORI) / (DATEDIFF(MONTH,%Exp:MV_PAR01%,%Exp:MV_PAR02%)+1)) COBERTURA_MEDIA,
	   (ISNULL(QTD_01,0) + ISNULL(QTD_10,0) + ISNULL(QTD_PEDIDO,0)) / (SUM(D4_QTDEORI) / (DATEDIFF(MONTH,%Exp:MV_PAR01%,%Exp:MV_PAR02%)+1)) COBERTURA_MEDIA_TRANSITO,
	   ISNULL(QTD_PEDIDO1,0) QTDP1,ISNULL(VAL_PEDIDO1,0) VALPEDIDO1,ISNULL(DATPRF1,'') DATPRF1,
	   ISNULL(QTD_PEDIDO2,0) QTDP2,ISNULL(VAL_PEDIDO2,0) VALPEDIDO2,ISNULL(DATPRF2,'') DATPRF2,
	   ISNULL(QTD_PEDIDO3,0) QTDP3,ISNULL(VAL_PEDIDO3,0) VALPEDIDO3,ISNULL(DATPRF3,'') DATPRF3,
	   ISNULL(QTD_PEDIDO4,0) QTDP4,ISNULL(VAL_PEDIDO4,0) VALPEDIDO4,ISNULL(DATPRF4,'') DATPRF4,
	   ISNULL(QTD_PEDIDO5,0) QTDP5,ISNULL(VAL_PEDIDO5,0) VALPEDIDO5,ISNULL(DATPRF5,'') DATPRF5,
	   ISNULL(QTD_PEDIDO6,0) QTDP6,ISNULL(VAL_PEDIDO6,0) VALPEDIDO6,ISNULL(DATPRF6,'') DATPRF6
FROM(
SELECT D4_FILIAL,D4_DATA,D4_OP,D4_TRT,D4_COD,B1_DESC,B1_UM,D4_QTDEORI,D4_QUANT,B1_UPRC,B1_EMIN
FROM SD4200 SD4
INNER JOIN SB1200 SB1 ON D4_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
WHERE SD4.D_E_L_E_T_ = ''
AND D4_FILIAL = '01'
AND D4_LOCAL = '10'
AND D4_DATA BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
)TB
LEFT JOIN (SELECT B9_FILIAL,B9_COD,B9_QINI QTD_INI,B9_DATA DT_INI
           FROM SB9200 SB9
		   WHERE SB9.D_E_L_E_T_ = ''
		   AND B9_FILIAL = '01'
		   AND B9_LOCAL = '01'
		   AND B9_DATA IN (SELECT MAX(B9_DATA)B9_DATA
		                   FROM SB9200 SB9
						   WHERE SB9.D_E_L_E_T_ = ''))SB9 ON D4_FILIAL = B9_FILIAL AND D4_COD = B9_COD
LEFT JOIN (SELECT D1_FILIAL FIL1,D1_COD COD1,SUM(D1_QUANT)QTDM1,AVG(D1_VUNIT) V1,MAX(D1_DTDIGIT)DT1
           FROM(
		   SELECT D1_FILIAL,D1_DOC,D1_SERIE,D1_DTDIGIT,D1_COD,D1_QUANT,D1_VUNIT,D1_FORNECE,D1_LOJA
           FROM SD1200 SD1
		   INNER JOIN SB1200 SB1 ON D1_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
		   WHERE SD1.D_E_L_E_T_ = ''
		   AND D1_FILIAL = '01'
		   AND D1_TIPO = 'N'
		   AND D1_LOCAL = '01'
		   AND B1_TIPO IN ('MN','MI','MA','MC')
		   AND D1_DTDIGIT BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -1, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -1, GETDATE ()),112),1,6)+'31'
		   )TB
		   GROUP BY D1_FILIAL,D1_COD)SD11 ON D4_FILIAL = FIL1 AND D4_COD = COD1
LEFT JOIN (SELECT D1_FILIAL FIL2,D1_COD COD2,SUM(D1_QUANT)QTDM2,AVG(D1_VUNIT) V2,MAX(D1_DTDIGIT)DT2
           FROM(
		   SELECT D1_FILIAL,D1_DOC,D1_SERIE,D1_DTDIGIT,D1_COD,D1_QUANT,D1_VUNIT,D1_FORNECE,D1_LOJA
           FROM SD1200 SD1
		   INNER JOIN SB1200 SB1 ON D1_COD = B1_COD AND B1_MSBLQL != '1'  AND SB1.D_E_L_E_T_ = ''
		   WHERE SD1.D_E_L_E_T_ = ''
		   AND D1_TIPO = 'N'
		   AND D1_FILIAL = '01'
		   AND D1_LOCAL = '01'
		   AND B1_TIPO IN ('MN','MI','MA','MC')
		   AND D1_DTDIGIT BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -2, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -2, GETDATE ()),112),1,6)+'31'
		   )TB
		   GROUP BY D1_FILIAL,D1_COD)SD12 ON D4_FILIAL = FIL2 AND D4_COD = COD2
LEFT JOIN (SELECT D1_FILIAL FIL3,D1_COD COD3,SUM(D1_QUANT)QTDM3,AVG(D1_VUNIT)V3,MAX(D1_DTDIGIT)DT3
           FROM(
		   SELECT D1_FILIAL,D1_DOC,D1_SERIE,D1_DTDIGIT,D1_COD,D1_QUANT,D1_VUNIT,D1_FORNECE,D1_LOJA
           FROM SD1200 SD1
		   INNER JOIN SB1200 SB1 ON D1_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
		   WHERE SD1.D_E_L_E_T_ = ''
		   AND D1_FILIAL = '01'
		   AND D1_TIPO = 'N'
		   AND D1_LOCAL = '01'
		   AND B1_TIPO IN ('MN','MI','MA','MC')
		   AND D1_DTDIGIT BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -3, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, -3, GETDATE ()),112),1,6)+'31'
		   )TB
		   GROUP BY D1_FILIAL,D1_COD)SD13 ON D4_FILIAL = FIL3 AND D4_COD = COD3
LEFT JOIN (SELECT SB2.B2_FILIAL,SB2.B2_COD,SB2.B2_QATU QTD_01
           FROM SB2200 SB2
		   INNER JOIN SB1200 SB1 ON B2_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
		   WHERE SB2.D_E_L_E_T_ = ''
		   AND B2_FILIAL = '01'
		   AND B2_LOCAL = '01'
		   AND B1_TIPO IN ('MN','MI','MA','MC'))SB2 ON D4_FILIAL = SB2.B2_FILIAL AND D4_COD = SB2.B2_COD
LEFT JOIN (SELECT SB21.B2_FILIAL,SB21.B2_COD,SB21.B2_QATU QTD_10
           FROM SB2200 SB21
		   INNER JOIN SB1200 SB1 ON B2_COD = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
		   WHERE SB21.D_E_L_E_T_ = ''
		   AND B2_FILIAL = '01'
		   AND B2_LOCAL = '10'
		   AND B1_TIPO IN ('MN','MI','MA','MC'))SB21 ON D4_FILIAL = SB21.B2_FILIAL AND D4_COD = SB21.B2_COD
LEFT JOIN ( SELECT C7_FILIAL,C7_PRODUTO,MAX(C7_EMISSAO)C7_EMISSAO,(SUM(C7_QUANT)-SUM(C7_QUJE)) QTD_PEDIDO,AVG(C7_PRECO)VAL_PEDIDO
            FROM(
            SELECT C7_FILIAL,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)C7_EMISSAO,C7_NUM,C7_ITEM,C7_PRODUTO,C7_DESCRI,C7_UM,C7_PRECO C7_LOCAL,C7_QUANT,C7_PRECO,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7200 SC7 (NOLOCK)
			INNER JOIN SB1200 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2200 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_EMISSAO >= '20240101'	  
		    )TB
			GROUP BY C7_FILIAL,C7_PRODUTO)SC7 ON D4_FILIAL = C7_FILIAL AND D4_COD = C7_PRODUTO
LEFT JOIN ( SELECT FILIAL1,PRODUTO1,MAX(DATPRF1)DATPRF1,(SUM(QTDC1)-SUM(C7_QUJE)) QTD_PEDIDO1,AVG(PRECO1) VAL_PEDIDO1
            FROM(
            SELECT C7_FILIAL FILIAL1,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF1,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO1,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO1,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC1,C7_PRECO PRECO1,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7200 SC7 (NOLOCK)
			INNER JOIN SB1200 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2200 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,GETDATE (),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,GETDATE (),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL1,PRODUTO1)SC71 ON D4_FILIAL = FILIAL1 AND D4_COD = PRODUTO1
LEFT JOIN ( SELECT FILIAL2,PRODUTO2,MAX(DATPRF2)DATPRF2,(SUM(QTDC2)-SUM(C7_QUJE)) QTD_PEDIDO2,AVG(PRECO2) VAL_PEDIDO2
            FROM(
            SELECT C7_FILIAL FILIAL2,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF2,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO1,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO2,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC2,C7_PRECO PRECO2,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7200 SC7 (NOLOCK)
			INNER JOIN SB1200 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2200 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 1, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 1, GETDATE ()),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL2,PRODUTO2)SC72 ON D4_FILIAL = FILIAL2 AND D4_COD = PRODUTO2
LEFT JOIN ( SELECT FILIAL3,PRODUTO3,MAX(DATPRF3)DATPRF3,(SUM(QTDC3)-SUM(C7_QUJE)) QTD_PEDIDO3,AVG(PRECO3) VAL_PEDIDO3
            FROM(
            SELECT C7_FILIAL FILIAL3,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF3,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO3,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO3,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC3,C7_PRECO PRECO3,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7200 SC7 (NOLOCK)
			INNER JOIN SB1200 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2200 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 2, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 2, GETDATE ()),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL3,PRODUTO3)SC73 ON D4_FILIAL = FILIAL3 AND D4_COD = PRODUTO3
LEFT JOIN ( SELECT FILIAL4,PRODUTO4,MAX(DATPRF4)DATPRF4,(SUM(QTDC4)-SUM(C7_QUJE)) QTD_PEDIDO4,AVG(PRECO4) VAL_PEDIDO4
            FROM(
            SELECT C7_FILIAL FILIAL4,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF4,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO1,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO4,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC4,C7_PRECO PRECO4,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7200 SC7 (NOLOCK)
			INNER JOIN SB1200 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2200 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 3, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 3, GETDATE ()),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL4,PRODUTO4)SC74 ON D4_FILIAL = FILIAL4 AND D4_COD = PRODUTO4
LEFT JOIN ( SELECT FILIAL5,PRODUTO5,MAX(DATPRF5)DATPRF5,(SUM(QTDC5)-SUM(C7_QUJE)) QTD_PEDIDO5,AVG(PRECO5) VAL_PEDIDO5
            FROM(
            SELECT C7_FILIAL FILIAL5,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF5,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO1,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO5,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC5,C7_PRECO PRECO5,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7200 SC7 (NOLOCK)
			INNER JOIN SB1200 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2200 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 4, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 4, GETDATE ()),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL5,PRODUTO5)SC75 ON D4_FILIAL = FILIAL5 AND D4_COD = PRODUTO5
LEFT JOIN ( SELECT FILIAL6,PRODUTO6,MAX(DATPRF6)DATPRF6,(SUM(QTDC6)-SUM(C7_QUJE)) QTD_PEDIDO6,AVG(PRECO6) VAL_PEDIDO6
            FROM(
            SELECT C7_FILIAL FILIAL6,CONVERT(VARCHAR,CAST(C7_DATPRF AS DATE),103)DATPRF6,CONVERT(VARCHAR,CAST(C7_EMISSAO AS DATE),103)EMISSAO1,
			       C7_NUM,C7_ITEM,C7_PRODUTO PRODUTO6,C7_DESCRI,C7_UM,C7_LOCAL,C7_QUANT QTDC6,C7_PRECO PRECO6,C7_QUJE,A2_COD,A2_LOJA,A2_NOME 
			FROM SC7200 SC7 (NOLOCK)
			INNER JOIN SB1200 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND B1_MSBLQL != '1' AND SB1.D_E_L_E_T_ = ''
			INNER JOIN SA2200 SA2 (NOLOCK) ON C7_FORNECE = A2_COD AND C7_LOJA = A2_LOJA AND SA2.D_E_L_E_T_ = ''
			WHERE SC7.D_E_L_E_T_ = ''
			AND B1_MSBLQL != '1'
			AND C7_FILIAL = '01'
			AND C7_LOCAL = '01'
			AND C7_RESIDUO = ''
			AND C7_QUANT > C7_QUJE
			AND B1_TIPO IN ('MN','MI','MA','MC')
			AND C7_DATPRF BETWEEN SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 5, GETDATE ()),112),1,6)+'01' AND SUBSTRING(CONVERT(VARCHAR,DATEADD (m, 5, GETDATE ()),112),1,6)+'31'	  
		    )TB
			GROUP BY FILIAL6,PRODUTO6)SC76 ON D4_FILIAL = FILIAL6 AND D4_COD = PRODUTO6
GROUP BY D4_FILIAL,D4_COD,B1_DESC,B1_UM,B1_UPRC,B1_EMIN,QTD_INI,DT_INI,QTDM1,V1,DT1,QTDM2,V2,DT2,QTDM3,V3,DT3,QTD_01,QTD_10,QTD_PEDIDO,VAL_PEDIDO,
         QTD_PEDIDO1,VAL_PEDIDO1,DATPRF1,QTD_PEDIDO2,VAL_PEDIDO2,DATPRF2,QTD_PEDIDO3,VAL_PEDIDO3,DATPRF3,QTD_PEDIDO4,VAL_PEDIDO4,DATPRF4,
		 QTD_PEDIDO5,VAL_PEDIDO5,DATPRF5,QTD_PEDIDO6,VAL_PEDIDO6,DATPRF6
)TB1
ORDER BY 1,B1_DESC

				
	EndSQL 


	oSection:EndQuery() 
	oSection:SetParentQuery()
	oSection:Print()	 
Return


Static Function AjustaSX1(cPerg)

	u_InPutSX1(cPerg,"01",PADR("De Data:" ,20)+"?","","","mv_ch1","D",10,0,0,"G","","","","","mv_par01") // Inicio de Data
	u_InPutSX1(cPerg,"02",PADR("Ate Data:",20)+"?","","","mv_ch2","D",10,0,0,"G","","","","","mv_par02") // Fim de Data
	//u_InPutSX1(cPerg,"03",PADR("Periodo :"   ,20)+"?","","","mv_ch3","C",2,0,0,"G","","","","","mv_par03")   
	//u_InPutSX1(cPerg,"04",PADR("Ate Pedido:",20)+"?","","","mv_ch4","C",10,0,0,"G","","","","","mv_par04")
	

Return
