User Function PLCOMR10()
	Local oReport
	Local cQuery
	Local cAlias      := getNextAlias()      

	Private cPerg     := "PLCOMR10"

	AjustaSX1(cPerg)
	Pergunte(cPerg,.F.)

	oReport := ReportDef(cAlias,cPerg)
	oReport:PrintDialog()
Return


Static Function ReportDef(cAlias,cPerg)
	Local oReport
	Local oSection
	Local oBreak
	Local aOrdem      := {"FILIAL"}

	oReport := TReport():New(cPerg,"Consumo M้dio por Periodo",cPerg,{|oReport| PrintReport(oReport,cAlias)}, )
	oReport:SetPortrait()      
	oReport:SetEnvironment(2)      

	//Primeira se็ใo
	oSection := TRSection():New(oReport,"Consumo M้dio por Periodo",{"SD1"},aOrdem)  
	
	
	TRCell():New(oSection,"EMPRESA"	  		,"SB1","EMPRESA","@!",6)
	TRCell():New(oSection,"CODIGO"	    	,"SB1","CODIGO PROD","@!",15)
	TRCell():New(oSection,"DESCRICAO"	    ,"SB1","DESC PROD","@!",30)   
	TRCell():New(oSection,"B1_UM"		    ,"SB1","UM","@!",3)         
	TRCell():New(oSection,"P_MES"  	 	    ,"SC2","P_MES","@!",3) 
	TRCell():New(oSection,"MEDIA_MES"   	,"SD1","MษDIA MสS","@E 999,999,999.999")
	TRCell():New(oSection,"TOTAL_PERIODO"   ,"SD3","TOTAL PERIODO","@E 999,999,999.999")
	TRCell():New(oSection,"PEDIDO_COMPRA"  	,"SC7","PEDIDO COMPRA","@E 999,999,999.999")
	TRCell():New(oSection,"TOTAL_ESTOQUE"	,"SB2","ESTOQUE","@E 999,999,999.999")
	
	//Totalizador                                                                                  
	//TRFunction():New(oSection:Cell("ETIQUETA"),"Etiqueta:","SUM",,,"@E 999,999,999,999",,.F.,.T.)

Return oReport


/*Inicia Logica Print Report */

Static Function PrintReport(oReport,cAlias)
	Local oSection  := oReport:Section(1)

	//if oReport:Section(1):GetOrder() == 1
	//	cOrdem := "A1_COD"
	//endif      

//inicia o Sql
	oSection:BeginQuery()
	BeginSQL Alias cAlias
		%noparser%

	SELECT EMPRESA,B1_COD CODIGO,B1_DESC DESCRICAO,B1_UM UM,CAST(%Exp:MV_PAR03% AS INT) P_MES,
       CASE WHEN SUM(MEDIA) < 0 THEN 0 ELSE SUM(MEDIA) END MEDIA_MES,
     CASE WHEN SUM(D3_QUANT) < 0 THEN 0 ELSE SUM(D3_QUANT) END TOTAL_PERIODO,ISNULL(TOTAL_COMPRA,0)PEDIDO_COMPRA,ISNULL(TOTAL_ESTOQUE,0)TOTAL_ESTOQUE
     FROM(
		SELECT TB1.EMPRESA,TB1.B1_COD,TB1.B1_DESC,TB1.B1_UM,TB1.MEDIA,TB1.D3_QUANT
		FROM(
			SELECT 'PELMEX' EMPRESA,B1_COD,B1_DESC,B1_UM,(SUM(D3_QUANT)/CAST(%Exp:MV_PAR03% AS INT))MEDIA,SUM(D3_QUANT)D3_QUANT
			FROM(
				SELECT D3_TM,B1_COD,B1_DESC,B1_UM,CASE WHEN SD3.D3_TM = '501' THEN SUM(D3_QUANT) ELSE SUM(D3_QUANT)*-1 END D3_QUANT,D3_LOCAL
				FROM SD3100 SD3 (NOLOCK)
				INNER JOIN SB1100 SB1 (NOLOCK) ON SD3.D3_COD = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
				WHERE SD3.D_E_L_E_T_ = ''
				AND SD3.D3_FILIAL = '01'
				AND SD3.D3_COD NOT LIKE '050%'
				AND SD3.D3_COD NOT LIKE 'SUP%'
				AND SD3.D3_TM IN ('101','501')
				AND SD3.D3_LOCAL IN ('01')
				AND SD3.D3_COD BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
				AND SD3.D3_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(%Exp:MV_PAR03% AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
				GROUP BY B1_COD,B1_DESC,B1_UM,D3_TM,D3_LOCAL
			)TB
		GROUP BY B1_COD,B1_DESC,B1_UM

		UNION

		SELECT 'AMAZON' EMPRESA,B1_COD,B1_DESC,B1_UM,(SUM(D3_QUANT)/CAST(%Exp:MV_PAR03% AS INT))MEDIA,SUM(D3_QUANT)D3_QUANT
		FROM(
			SELECT D3_TM,B1_COD,B1_DESC,B1_UM,CASE WHEN SD3.D3_TM = '501' THEN SUM(D3_QUANT) ELSE SUM(D3_QUANT)*-1 END D3_QUANT,D3_LOCAL
			FROM SD3200 SD3 (NOLOCK)
			INNER JOIN SB1200 SB1 (NOLOCK) ON SD3.D3_COD = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
			WHERE SD3.D_E_L_E_T_ = ''
			AND SD3.D3_FILIAL = '01'
			AND SD3.D3_TM IN ('101','501')
			AND SD3.D3_LOCAL IN ('01')
			AND SD3.D3_COD BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
			AND SD3.D3_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(%Exp:MV_PAR03% AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
			GROUP BY B1_COD,B1_DESC,B1_UM,D3_TM,D3_LOCAL
		)TB
		GROUP BY B1_COD,B1_DESC,B1_UM
		)TB1
		LEFT JOIN (
		SELECT 'PELMEX' EMPRESA,SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM,(SUM(G1_TOTAL)/CAST(%Exp:MV_PAR03% AS INT))MEDIA,SUM(G1_TOTAL)G1_TOTAL
		FROM(
			SELECT C6_PRODUTO,SUM(C6_QTDVEN)C6_QTDVEN,SG1.G1_COMP,SG1.G1_QUANT,SUM(C6_QTDVEN)*SG1.G1_QUANT G1_TOTAL
			FROM SC6100 SC6 (NOLOCK)
			INNER JOIN SC5100 SC5 (NOLOCK) ON C6_FILIAL = C5_FILIAL AND C6_NUM = C5_NUM AND SC5.D_E_L_E_T_ = ''
			INNER JOIN SG1100 SG1 (NOLOCK) ON C6_PRODUTO = SG1.G1_COD AND SG1.D_E_L_E_T_ = '' AND SG1.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG1.G1_COMP NOT LIKE 'MOD%'
			WHERE SC6.D_E_L_E_T_ = ''
			AND C5_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(%Exp:MV_PAR03% AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
			AND G1_COMP NOT LIKE '050%'
			AND G1_COMP NOT LIKE 'SUP%'
			AND G1_COMP BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
			GROUP BY C6_PRODUTO,SG1.G1_COMP,SG1.G1_QUANT
			)TB
		INNER JOIN SB1100 SB1 (NOLOCK) ON G1_COMP = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
		GROUP BY SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM

		UNION

		SELECT 'AMAZON' EMPRESA,SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM,(SUM(G1_TOTAL)/CAST(%Exp:MV_PAR03% AS INT))MEDIA,SUM(G1_TOTAL)G1_TOTAL
		FROM(
			SELECT C6_PRODUTO,SUM(C6_QTDVEN)C6_QTDVEN,SG12.G1_COMP,SG12.G1_QUANT,SUM(C6_QTDVEN)*SG12.G1_QUANT G1_TOTAL
			FROM SC6100 SC6 (NOLOCK)
			INNER JOIN SC5100 SC5 (NOLOCK) ON C6_FILIAL = C5_FILIAL AND C6_NUM = C5_NUM AND SC5.D_E_L_E_T_ = ''
			INNER JOIN SG1100 SG1 (NOLOCK) ON C6_PRODUTO = SG1.G1_COD AND SG1.D_E_L_E_T_ = '' AND SG1.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG1.G1_COMP NOT LIKE 'MOD%'
			INNER JOIN SG1200 SG12 (NOLOCK) ON SG1.G1_COMP = SG12.G1_COD AND SG12.D_E_L_E_T_ = '' AND SG12.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG12.G1_COMP NOT LIKE 'MOD%'
			WHERE SC6.D_E_L_E_T_ = ''
			AND SG12.G1_COMP NOT LIKE 'BL%'
			AND C5_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(%Exp:MV_PAR03% AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
			AND SG12.G1_COMP BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
			GROUP BY C6_PRODUTO,SG12.G1_COMP,SG12.G1_QUANT
		)TB
		INNER JOIN SB1200 SB1 (NOLOCK) ON G1_COMP = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
		GROUP BY SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM

		UNION

		SELECT 'AMAZON' EMPRESA,SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM,(SUM(G1_TOTAL)/CAST(%Exp:MV_PAR03% AS INT))MEDIA,SUM(G1_TOTAL)G1_TOTAL
		FROM(
			SELECT C6_PRODUTO,SUM(C6_QTDVEN)C6_QTDVEN,SG13.G1_COMP,SG13.G1_QUANT,SUM(C6_QTDVEN)*SG13.G1_QUANT G1_TOTAL
			FROM SC6100 SC6 (NOLOCK)
			INNER JOIN SC5100 SC5 (NOLOCK) ON C6_FILIAL = C5_FILIAL AND C6_NUM = C5_NUM AND SC5.D_E_L_E_T_ = ''
			INNER JOIN SG1100 SG1 (NOLOCK) ON C6_PRODUTO = SG1.G1_COD AND SG1.D_E_L_E_T_ = '' AND SG1.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG1.G1_COMP NOT LIKE 'MOD%'
			INNER JOIN SG1200 SG12 (NOLOCK) ON SG1.G1_COMP = SG12.G1_COD AND SG12.D_E_L_E_T_ = '' AND SG12.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG12.G1_COMP NOT LIKE 'MOD%'
			INNER JOIN SG1200 SG13 (NOLOCK) ON SG12.G1_COMP = SG13.G1_COD AND SG13.D_E_L_E_T_ = '' AND SG13.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG13.G1_COMP NOT LIKE 'MOD%'
			WHERE SC6.D_E_L_E_T_ = ''
			AND C5_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(%Exp:MV_PAR03% AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
			AND SG12.G1_COMP BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
			GROUP BY C6_PRODUTO,SG13.G1_COMP,SG13.G1_QUANT
		)TB
		INNER JOIN SB1200 SB1 (NOLOCK) ON G1_COMP = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
		GROUP BY SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM
		)TB2 ON TB1.B1_COD = TB2.B1_COD
		WHERE TB2.B1_COD IS NULL

		UNION

		SELECT 'PELMEX' EMPRESA,SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM,(SUM(G1_TOTAL)/CAST(%Exp:MV_PAR03% AS INT))MEDIA,SUM(G1_TOTAL)G1_TOTAL
		FROM(
			SELECT C6_PRODUTO,SUM(C6_QTDVEN)C6_QTDVEN,SG1.G1_COMP,SG1.G1_QUANT,SUM(C6_QTDVEN)*SG1.G1_QUANT G1_TOTAL
			FROM SC6100 SC6 (NOLOCK)
			INNER JOIN SC5100 SC5 (NOLOCK) ON C6_FILIAL = C5_FILIAL AND C6_NUM = C5_NUM AND SC5.D_E_L_E_T_ = ''
			INNER JOIN SG1100 SG1 (NOLOCK) ON C6_PRODUTO = SG1.G1_COD AND SG1.D_E_L_E_T_ = '' AND SG1.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG1.G1_COMP NOT LIKE 'MOD%'
			WHERE SC6.D_E_L_E_T_ = ''
			AND C5_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(%Exp:MV_PAR03% AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
			AND G1_COMP NOT LIKE '050%'
			AND G1_COMP NOT LIKE 'SUP%'
			AND G1_COMP BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
			GROUP BY C6_PRODUTO,SG1.G1_COMP,SG1.G1_QUANT
		)TB
		INNER JOIN SB1100 SB1 (NOLOCK) ON G1_COMP = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
		GROUP BY SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM

		UNION

		SELECT 'AMAZON' EMPRESA,SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM,(SUM(G1_TOTAL)/CAST(%Exp:MV_PAR03% AS INT))MEDIA,SUM(G1_TOTAL)G1_TOTAL
		FROM(
			SELECT C6_PRODUTO,SUM(C6_QTDVEN)C6_QTDVEN,SG12.G1_COMP,SG12.G1_QUANT,SUM(C6_QTDVEN)*SG12.G1_QUANT G1_TOTAL
			FROM SC6100 SC6 (NOLOCK)
			INNER JOIN SC5100 SC5 (NOLOCK) ON C6_FILIAL = C5_FILIAL AND C6_NUM = C5_NUM AND SC5.D_E_L_E_T_ = ''
			INNER JOIN SG1100 SG1 (NOLOCK) ON C6_PRODUTO = SG1.G1_COD AND SG1.D_E_L_E_T_ = '' AND SG1.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG1.G1_COMP NOT LIKE 'MOD%'
			INNER JOIN SG1200 SG12 (NOLOCK) ON SG1.G1_COMP = SG12.G1_COD AND SG12.D_E_L_E_T_ = '' AND SG12.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG12.G1_COMP NOT LIKE 'MOD%'
			WHERE SC6.D_E_L_E_T_ = ''
			AND SG12.G1_COMP NOT LIKE 'BL%'
			AND C5_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, -CAST(%Exp:MV_PAR03% AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
			AND SG12.G1_COMP BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
			GROUP BY C6_PRODUTO,SG12.G1_COMP,SG12.G1_QUANT
		)TB
		INNER JOIN SB1200 SB1 (NOLOCK) ON G1_COMP = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
		GROUP BY SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM

		UNION

		SELECT 'AMAZON' EMPRESA,SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM,(SUM(G1_TOTAL)/CAST(%Exp:MV_PAR03% AS INT))MEDIA,SUM(G1_TOTAL)G1_TOTAL
		FROM(
			SELECT C6_PRODUTO,SUM(C6_QTDVEN)C6_QTDVEN,SG13.G1_COMP,SG13.G1_QUANT,SUM(C6_QTDVEN)*SG13.G1_QUANT G1_TOTAL
			FROM SC6100 SC6 (NOLOCK)
			INNER JOIN SC5100 SC5 (NOLOCK) ON C6_FILIAL = C5_FILIAL AND C6_NUM = C5_NUM AND SC5.D_E_L_E_T_ = ''
			INNER JOIN SG1100 SG1 (NOLOCK) ON C6_PRODUTO = SG1.G1_COD AND SG1.D_E_L_E_T_ = '' AND SG1.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG1.G1_COMP NOT LIKE 'MOD%'
			INNER JOIN SG1200 SG12 (NOLOCK) ON SG1.G1_COMP = SG12.G1_COD AND SG12.D_E_L_E_T_ = '' AND SG12.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG12.G1_COMP NOT LIKE 'MOD%'
			INNER JOIN SG1200 SG13 (NOLOCK) ON SG12.G1_COMP = SG13.G1_COD AND SG13.D_E_L_E_T_ = '' AND SG13.G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG13.G1_COMP NOT LIKE 'MOD%'
			WHERE SC6.D_E_L_E_T_ = ''
			AND C5_EMISSAO BETWEEN CONVERT(VARCHAR,DATEADD (m, - CAST(%Exp:MV_PAR03% AS INT), GETDATE ()),112) AND CONVERT(VARCHAR,GETDATE(),112)
			AND SG12.G1_COMP BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
			GROUP BY C6_PRODUTO,SG13.G1_COMP,SG13.G1_QUANT
		)TB
		INNER JOIN SB1200 SB1 (NOLOCK) ON G1_COMP = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
		GROUP BY SB1.B1_COD,SB1.B1_DESC,SB1.B1_UM
		)TB4
		LEFT JOIN (SELECT 'PELMEX' C7_EMPRESA,C7_PRODUTO,SUM(C7_QUANT)-SUM(C7_QUJE)TOTAL_COMPRA
				   FROM SC7100 SC7 (NOLOCK)
				   INNER JOIN SB1100 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND SB1.D_E_L_E_T_ = ''
				   WHERE SC7.D_E_L_E_T_ = ''
				   AND C7_FILIAL = '01'
				   AND SB1.B1_TIPO NOT IN ('PA')
				   AND C7_QUANT > C7_QUJE
				   GROUP BY C7_PRODUTO
				   UNION
				   SELECT 'AMAZON' C7_EMPRESA,C7_PRODUTO,SUM(C7_QUANT)-SUM(C7_QUJE)TOTAL_COMPRA
					   FROM SC7200 SC7 (NOLOCK)
				   INNER JOIN SB1200 SB1 (NOLOCK) ON C7_PRODUTO = B1_COD AND SB1.D_E_L_E_T_ = ''
				   WHERE SC7.D_E_L_E_T_ = ''
				   AND C7_FILIAL = '01'
				   AND SB1.B1_TIPO NOT IN ('PA')
				   AND C7_QUANT > C7_QUJE
				   GROUP BY C7_PRODUTO)SC7 ON  C7_EMPRESA = EMPRESA AND C7_PRODUTO = TB4.B1_COD
		LEFT JOIN (SELECT 'PELMEX' B2_EMPRESA,B2_COD,B2_QATU TOTAL_ESTOQUE
				   FROM SB2100 SB2 (NOLOCK)
				   INNER JOIN SB1100 SB1 (NOLOCK) ON B2_COD = B1_COD AND SB1.D_E_L_E_T_ = ''
				   WHERE SB2.D_E_L_E_T_ = ''
				   AND B2_FILIAL = '01'
				   AND B2_LOCAL = '01'
				   GROUP BY B2_COD,B2_QATU
				   UNION
				   SELECT 'AMAZON' B2_EMPRESA,B2_COD,B2_QATU TOTAL_ESTOQUE
					   FROM SB2200 SB2 (NOLOCK)
				   INNER JOIN SB1200 SB1 (NOLOCK) ON B2_COD = B1_COD AND SB1.D_E_L_E_T_ = ''
				   WHERE SB2.D_E_L_E_T_ = ''
				   AND B2_FILIAL = '01'
				   AND B2_LOCAL = '01'
				   GROUP BY B2_COD,B2_QATU)SB2 ON B2_EMPRESA = EMPRESA AND B2_COD = TB4.B1_COD
WHERE TB4.B1_COD NOT LIKE 'CED%'
AND TB4.B1_DESC NOT LIKE 'ART%'
AND TB4.B1_COD NOT LIKE 'LAM%'
AND TB4.B1_COD NOT LIKE 'BL%'
AND TB4.B1_DESC NOT LIKE 'FAI%'
AND TB4.B1_COD NOT LIKE 'DFLOC%'
AND TB4.B1_COD NOT LIKE 'LONG%'
AND TB4.B1_COD NOT LIKE 'CAP%'
AND TB4.B1_DESC NOT LIKE 'MOLEJO%'
		
GROUP BY EMPRESA,B1_COD,B1_DESC,B1_UM,TOTAL_COMPRA,TOTAL_ESTOQUE
ORDER BY 1,3
		
	
	EndSQL 


	oSection:EndQuery() 
	oSection:SetParentQuery()
	oSection:Print()	 
Return


Static Function AjustaSX1(cPerg)

	u_InPutSX1(cPerg,"01",PADR("De Produto:" ,20)+"?","","","mv_ch1","C",15,0,0,"G","","","SB1","","mv_par01") // Inicio de produto
	u_InPutSX1(cPerg,"02",PADR("Ate Produto:",20)+"?","","","mv_ch2","C",15,0,0,"G","","","SB1","","mv_par02") // Fim de Produto
