User Function PLPROR27()
	Local oReport
	Local cQuery
	Local cAlias      := getNextAlias()      

	Private cPerg     := "PLPROR27"

	AjustaSX1(cPerg)
	Pergunte(cPerg,.F.)

	oReport := ReportDef(cAlias,cPerg)
	oReport:PrintDialog()
Return


Static Function ReportDef(cAlias,cPerg)
	Local oReport
	Local oSection
	Local oBreak
	Local aOrdem      := {"FILIAL"}

	oReport := TReport():New(cPerg,"Rel. Bipagem de Colagem",cPerg,{|oReport| PrintReport(oReport,cAlias)}, )
	oReport:SetPortrait()      
	oReport:SetEnvironment(2)      

	//Primeira se็ใo
	oSection := TRSection():New(oReport,"Rel. Bipagem de Colagem",{"SC2"},aOrdem) 


    TRCell():New(oSection,"RFID"   	     ,"CLC","RFID","@!",15)
	TRCell():New(oSection,"COD"		      ,"CLC","PRODUTO","@!",15)
	TRCell():New(oSection,"DESCRI"		     ,"CLC","DESCRICAO","@!",30)
    TRCell():New(oSection,"QNT"		   ,"CLC","QTD","@@E 999,999,999.999",)  
	TRCell():New(oSection,"PONTOS"		    ,"CLC","PONTOS","@@E 999,999,999.999",)
    TRCell():New(oSection,"MESA"	     ,"CLC","MESA","@!",3)    
	TRCell():New(oSection,"MAT1"			    ,"CLC","MAT1","@!",5)
	TRCell():New(oSection,"MAT2"        ,"CLC","MAT2","@!",5)
	TRCell():New(oSection,"DATA" 	,"CLC","DATA","@!",10) 
	TRCell():New(oSection,"HORA"	,"CLC","HORA","@!",10) 
	//TRCell():New(oSection,"CARGA"  			,"SC2","CARGA","@!",12)
	//TRCell():New(oSection,"CLIENTE"     	,"SC2","CLIENTE","@!",30) 
	
    
	
	//Totalizador                                                                                  
	//TRFunction():New(oSection:Cell("PED_QUANT"),"Total Etiqueta:","SUM",,,"@E 999,999,999.999",,.F.,.T.)

Return oReport


/*Inicia Logica Print Report */

Static Function PrintReport(oReport,cAlias)
	Local oSection  := oReport:Section(1)

	//if oReport:Section(1):GetOrder() == 1
	//	cOrdem := "A1_COD"
	//endif      


	oSection:BeginQuery()
	BeginSQL Alias cAlias
		%noparser%


SELECT CLC_CPRODUC RFID, CLC_COD COD, CLC_DESCRI DESCRI, CLC_QUANT QNT, CLC_PONTOS PONTOS, CLC_ANTENA MESA, CLC_USERINC MAT1, CLC_USERINC2 MAT2, CLC_DATINC DATA, CLC_HORINC HORA
FROM CLC
WHERE CONVERT(VARCHAR,CAST (CLC_DATINC AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
ORDER BY CLC_HORINC


		EndSQL 


	oSection:EndQuery() 
	oSection:SetParentQuery()
	oSection:Print()	 
Return


Static Function AjustaSX1(cPerg)

	
	u_InPutSX1(cPerg,"01",PADR("DT Bipagem:",20)+"?","","","mv_ch1","D",10,0,0,"G","","","","","mv_par01") 
	u_InPutSX1(cPerg,"02",PADR("DT Fim Bipagem:",20)+"?","","","mv_ch2","D",10,0,0,"G","","","","","mv_par02")
	//u_InPutSX1(cPerg,"03",PADR("De Componente:" ,20)+"?","","","mv_ch3","C",15,0,0,"G","","","","","mv_par03") 
	//u_InPutSX1(cPerg,"04",PADR("Ate Componente:",20)+"?","","","mv_ch4","C",15,0,0,"G","","","","","mv_par04")
	
	
	
Return
