User Function PLPROR30()
	Local oReport
	Local cQuery
	Local cAlias      := getNextAlias()      

	Private cPerg     := "PLPROR30"

	AjustaSX1(cPerg)
	Pergunte(cPerg,.F.)

	oReport := ReportDef(cAlias,cPerg)
	oReport:PrintDialog()
Return


Static Function ReportDef(cAlias,cPerg)
	Local oReport
	Local oSection
	Local oBreak
	Local aOrdem      := {"FILIAL"}

	oReport := TReport():New(cPerg,"Rel. Bipagem de Faixa",cPerg,{|oReport| PrintReport(oReport,cAlias)}, )
	oReport:SetPortrait()      
	oReport:SetEnvironment(2)      

	//Primeira se็ใo
	oSection := TRSection():New(oReport,"Rel. Bipagem de Faixa",{"SC2"},aOrdem) 


    TRCell():New(oSection,"RFID"   	     ,"CLE","RFID","@!",15)
	TRCell():New(oSection,"COD"		      ,"CLE","PRODUTO","@!",15)
	TRCell():New(oSection,"DESCRI"		     ,"CLE","DESCRICAO","@!",30)
    TRCell():New(oSection,"QNT"		   ,"CLE","QTD","@@E 999,999,999.999",)  
	TRCell():New(oSection,"PONTOS"		    ,"CLE","PONTOS","@@E 999,999,999.999",)
    TRCell():New(oSection,"MESA"	     ,"CLE","MESA","@!",3)    
	TRCell():New(oSection,"MAT"			    ,"CLE","MAT1","@!",5)
	TRCell():New(oSection,"DATA" 	,"CLE","DATA","@!",10) 
	TRCell():New(oSection,"HORA"	,"CLE","HORA","@!",10) 
	//TRCell():New(oSection,"CARGA"  			,"SC2","CARGA","@!",12)
	//TRCell():New(oSection,"CLIENTE"     	,"SC2","CLIENTE","@!",30) 
	
    
	
	//Totalizador                                                                                  
	//TRFunction():New(oSection:Cell("PED_QUANT"),"Total Etiqueta:","SUM",,,"@E 999,999,999.999",,.F.,.T.)

Return oReport


/*Inicia Logica Print Report */

Static Function PrintReport(oReport,cAlias)
	Local oSection  := oReport:Section(1)

	//if oReport:Section(1):GetOrder() == 1
	//	cOrdem := "A1_COD"
	//endif      


	oSection:BeginQuery()
	BeginSQL Alias cAlias
		%noparser%


SELECT CLE_CPRODUC RFID, CLE_COD COD, CLE_DESCRI DESCRI, CLE_QUANT QNT, CLE_PONTOS PONTOS, CLE_ANTENA MESA, CLE_USERINC MAT, CLE_DATINC DATA, CLE_HORINC HORA
FROM CLE
WHERE CONVERT(VARCHAR,CAST (CLE_DATINC AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
ORDER BY CLE_HORINC

 
		EndSQL 


	oSection:EndQuery() 
	oSection:SetParentQuery()
	oSection:Print()	 
Return


Static Function AjustaSX1(cPerg)

	
	u_InPutSX1(cPerg,"01",PADR("DT Bipagem:",20)+"?","","","mv_ch1","D",10,0,0,"G","","","","","mv_par01") 
	u_InPutSX1(cPerg,"02",PADR("DT Fim Bipagem:",20)+"?","","","mv_ch2","D",10,0,0,"G","","","","","mv_par02")
	//u_InPutSX1(cPerg,"03",PADR("De Componente:" ,20)+"?","","","mv_ch3","C",15,0,0,"G","","","","","mv_par03") 
	//u_InPutSX1(cPerg,"04",PADR("Ate Componente:",20)+"?","","","mv_ch4","C",15,0,0,"G","","","","","mv_par04")
	
	
	
Return
