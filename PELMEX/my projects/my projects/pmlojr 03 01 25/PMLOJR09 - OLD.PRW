User Function PMLOJR09()
	Local oReport
	Local cQuery
	Local cAlias      := getNextAlias()
	Private cPerg     := "PMLOJR09"

	AjustaSX1(cPerg)
	Pergunte(cPerg,.F.)

	oReport := ReportDef(cAlias,cPerg)
	oReport:PrintDialog()
Return                                        

Static Function ReportDef(cAlias,cPerg)
	Local oReport := Nil
	Local oSection:= Nil
	Local oBreak
	Local aOrdem      := {"FILIAL"}


	oReport := TReport():New(cPerg,"RELATÓRIO DE COMISSÕES ",cPerg,{|oReport| PrintReport(oReport,cAlias)}, )
	oReport:SetPortrait()      
	oReport:SetEnvironment(2)      

	//Primeira seção
	oSection := TRSection():New(oReport,"Comissão",{"SL1"},aOrdem) 


	TRCell():New(oSection,"L1_FILORI"		,"SL1","Fil.Origem",/*Mascara*/)
	TRCell():New(oSection,"L1_FILRES"		,"SL1","Fil.Destino",/*Mascara*/)
	TRCell():New(oSection,"L1_EMISNF"		,"SL1","Dt.Emissão",/*Mascara*/,) 
	TRCell():New(oSection,"L1_NUM"   		,"SL1","Orçamento",/*Mascara*/,) 
	TRCell():New(oSection,"L1_PEDRES"		,"SL1","Pedido",/*Mascara*/,)
	TRCell():New(oSection,"L1_DOCPED"		,"SL1","Titulo",/*Mascara*/,15)
	TRCell():New(oSection,"L1_SERPED"	    ,"SL1","Prefixo",/*Mascara*/,) 
	TRCell():New(oSection,"L1_NSUTEF"		,"SL1","NSUTEF","@E 99999999999",15) 
	TRCell():New(oSection,"L1_DOC"		    ,"SL1","Nota",/*Mascara*/,15)
	TRCell():New(oSection,"L1_SERIE"		,"SD1","Serie",/*Mascara*/,) 
	TRCell():New(oSection,"D1_DOC"    		,"SD1","NF.Devolução",/*Mascara*/,)
	TRCell():New(oSection,"D1_SERIE"        ,"SD1","Serie",/*Mascara*/,)
	TRCell():New(oSection,"D1_EMISSAO"		,"SD1","Dt.Devolução",/*Mascara*/,)  
	TRCell():New(oSection,"L1_CLIENTE"		,"SL1","Cliente",/*Mascara*/,/*Tamanho*/) 
	TRCell():New(oSection,"A1_NOME" 		,"SA1","Nome do Cliente",,/*Tamanho*/) 
	TRCell():New(oSection,"L2_PRODUTO"   	,"SL2","Produto",/*Mascara*/,20) 
	TRCell():New(oSection,"L2_DESCRI"       ,"SL2","Descrição do produto",,/*Tamanho*/)
	TRCell():New(oSection,"L2_VLRITEM"      ,"SL2","Valor Venda","@E 999,999,999.99",/*Tamanho*/)
	TRCell():New(oSection,"B1_COMIS"		,"SB1","% Comissao","!@",8)
	TRCell():New(oSection,"B1_TOTAL"		,"SB1","Valor Comissão","@E 999,999,999.99",10)
	TRCell():New(oSection,"A3_COD"		    ,"SA3","Cod.Vendedor",/*Mascara*/,/*Tamanho*/)
	TRCell():New(oSection,"A3_NOME"		    ,"SA3","Nome Vendedor",/*Mascara*/,/*Tamanho*/)
	TRCell():New(oSection,"TMP_JUSTIFICA"	,"TMP","Justificativa",/*Mascara*/,/*Tamanho*/)

 
	//Totalizador                                                                                  
	//TRFunction():New(oSection:Cell("L2_VLRITEM"),"TOTAL ","SUM",,,"@E 999,999,999.99",,.F.,.T.)
	//TRFunction():New(oSection:Cell("B1_TOTAL"),"TOTAL GERAL","SUM",,,"@E 999,999,999.99",,.F.,.T.)

	//Fim Quebra por Seção

	//Totalizador final





	//Totalizador                                                                                                          MIC

	/* 

	TRFunction():New(oSection:Cell("L1_VLRTOT"),"TOTAL GERAL","SUM",,,"@E 999,999,999.99",,.F.,.T.)                            MIC
	TRFunction():New(oSection:Cell("IR"),"TOTAL IR","SUM",,,"@E 999,999,999.99",,.F.,.T.)
	TRFunction():New(oSection:Cell("VALLIQ"),"TOTAL LIQUIDO","SUM",,,"@E 999,999,999.99",,.F.,.T.)
	*/
	//quebra  por seção (.T.) uma seção por pagina		
	
Return(oReport)



/*Inicia Logica Print Report */

Static Function PrintReport(oReport,cAlias)
	Local oSection  := oReport:Section(1)

	//if oReport:Section(1):GetOrder() == 1
	//	cOrdem := "A1_COD"                       ·
	//endif      


	oSection:BeginQuery()
	BeginSQL Alias cAlias
		%noparser%    

		SELECT L1_FILORI,L1_FILRES,L1_EMISNF,L1_NUM,L1_PEDRES,L1_DOCPED,L1_SERPED,L1_DOC,L1_SERIE,
		D1_DOC,D1_SERIE,D1_EMISSAO,L1_CLIENTE,A1_NOME,
		L2_PRODUTO,L2_DESCRI,
		L1_NSUTEF,L2_VLRITEM,B1_COMIS,
		A3_COD,A3_NOME,TMP_JUSTIFICA,(B1_COMIS*L2_VLRITEM)/100 B1_TOTAL,COMISSAO	
FROM (
		SELECT L1_FILORI,L1_FILRES,L1_EMISNF,L1_NUM,L1_PEDRES,L1_DOCPED,L1_SERPED,L1_DOC,L1_SERIE,
				D1_DOC,D1_SERIE,D1_EMISSAO,L1_CLIENTE,A1_NOME,
				L2_PRODUTO,L2_DESCRI,L2_VLRITEM,
				L1_NSUTEF,		
				CASE 
					WHEN L1_FILORI ='04' AND COMISSAO >=120000 THEN B1_COMIS+1 //Probel Manauara
					WHEN L1_FILORI ='04' AND COMISSAO >=150000 THEN B1_COMIS+2 //Probel Manauara
					WHEN L1_FILORI IN ('12','22') AND COMISSAO >=100000 THEN B1_COMIS+1 //Probel Amazonas shopping e grao para 
					WHEN L1_FILORI IN ('12','22') AND COMISSAO >=130000 THEN B1_COMIS+2 //Probel Amazonas shopping e grao para 
					WHEN L2_PRODUTO NOT LIKE 'C%' THEN 4 //ADICIONAL
					WHEN L2_PRODUTO LIKE '%CPROCPT%' THEN 10 //CONCEPT
					WHEN L1_FILORI NOT IN ('04','12') AND COMISSAO BETWEEN '0' AND '50000' THEN 4  //lojas
					WHEN L1_FILORI NOT IN ('04','12') AND COMISSAO BETWEEN '50001' AND '60000' THEN 5 //lojas
					WHEN L1_FILORI NOT IN ('04','12') AND COMISSAO BETWEEN '60001' AND '70000' THEN 6  //lojas
					WHEN L1_FILORI NOT IN ('04','12') AND COMISSAO BETWEEN '70000' AND '100000' THEN 7 //lojas
					WHEN L1_FILORI NOT IN ('04','12') AND COMISSAO  > '100000' THEN 8 //lojas
					ELSE B1_COMIS END B1_COMIS,
				A3_COD,A3_NOME,TMP_JUSTIFICA,COMISSAO
		FROM (
				SELECT ISNULL(L1_FILORI,L1_FILRES)L1_FILORI,L1_FILRES,L1_EMISNF,L1_NUM,L1_PEDRES,L1_DOCPED,L1_SERPED,L1_DOC,L1_SERIE,
				D1_DOC,D1_SERIE,D1_EMISSAO,L1_CLIENTE,A1_NOME,
				L2_PRODUTO,L2_DESCRI,L2_VLRITEM,
				L1_NSUTEF,		
				B1_COMIS,
				A3_COD,A3_NOME,TMP_JUSTIFICA,
				(SELECT SUM(L2_VLRITEM) L2_VLRITEM
					FROM (
					
						//CUPOM
						SELECT SL1.L1_FILIAL L1_FILORI,SL1.L1_FILIAL L1_FILRES,SL1.L1_EMISNF,SL1.L1_NUM,SL1.L1_PEDRES,SL1.L1_DOCPED,SL1.L1_SERPED,SL1.L1_DOC,SL1.L1_SERIE,
						ISNULL(D1_DOC,'')D1_DOC,ISNULL(D1_SERIE,'')D1_SERIE,ISNULL(D1_EMISSAO,'')D1_EMISSAO,
						SL1.L1_CLIENTE,SA1.A1_NOME,
						SL2.L2_ITEM,SL2.L2_PRODUTO,SL2.L2_DESCRI,
						CASE WHEN ISNULL(D1_EMISSAO,'') = '' THEN SL2.L2_VLRITEM ELSE SL2.L2_VLRITEM*-1 END  L2_VLRITEM,SL1.L1_NSUTEF,B1_COMIS,
						SA3.A3_COD,SA3.A3_NOME
						FROM %Table:SL1% SL1 (NOLOCK)
						INNER JOIN %Table:SL2% SL2 (NOLOCK) ON SL1.L1_FILIAL = SL2.L2_FILIAL AND SL1.L1_NUM = SL2.L2_NUM AND SL1.L1_DOC != ''
						AND SL1.D_E_L_E_T_ = '' AND SL2.D_E_L_E_T_ = ''
						INNER JOIN %Table:SB1% SB1 (NOLOCK) ON SL2.L2_PRODUTO = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA1% SA1 (NOLOCK) ON SL1.L1_CLIENTE = SA1.A1_COD AND SL1.L1_LOJA = SA1.A1_LOJA AND SA1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA3% SA3 (NOLOCK) ON SL1.L1_VEND = SA3.A3_COD AND SA3.D_E_L_E_T_ = '' AND SA3.A3_MSBLQL != '1'
						LEFT JOIN  %Table:SD1% SD1 (NOLOCK) ON SL1.L1_FILIAL = SD1.D1_FILIAL AND SL1.L1_DOC = SD1.D1_NFORI AND SL1.L1_SERIE = SD1.D1_SERIORI AND SL2.L2_ITEM = SD1.D1_ITEMORI AND SL2.L2_PRODUTO = SD1.D1_COD AND SD1.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SF2% SF2 (NOLOCK) ON SD1.D1_FILORI = SF2.F2_FILIAL AND SF2.F2_DOC = D1_NFORI AND SF2.F2_SERIE = D1_SERIORI
						WHERE SL1.L1_FILIAL BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
						AND SA3.A3_COD BETWEEN TB.A3_COD AND TB.A3_COD
						AND SL1.L1_EMISNF BETWEEN %Exp:MV_PAR03% AND %Exp:MV_PAR04%
						AND SL1.L1_CLIENTE BETWEEN %Exp:MV_PAR11% AND %Exp:MV_PAR12%
						AND SL1.L1_DOC BETWEEN %Exp:MV_PAR07% AND %Exp:MV_PAR08%
						AND SL1.L1_SERIE BETWEEN %Exp:MV_PAR09% AND %Exp:MV_PAR10%
						AND SL1.L1_TIPO = 'V'

						UNION


						//PRODUCAO
						SELECT  SL1.L1_FILIAL L1_FILORI,SL11.L1_FILIAL L1_FILRES,SL1.L1_EMISNF,SL1.L1_NUM,
						CASE WHEN SL1.L1_PEDRES = '' THEN SC5.C5_NUM ELSE SL1.L1_PEDRES END L1_PEDRES,
						SL1.L1_DOCPED,SL1.L1_SERPED,SC5.C5_NOTA L1_DOC,SC5.C5_SERIE L1_SERIE,
						ISNULL(D1_DOC,'')D1_DOC,ISNULL(D1_SERIE,'')D1_SERIE,ISNULL(D1_EMISSAO,'')D1_EMISSAO,
						SL1.L1_CLIENTE,SA1.A1_NOME,
						SC6.C6_ITEM L2_ITEM,SC6.C6_PRODUTO L2_PRODUTO,SC6.C6_DESCRI L2_DESCRI,
						CASE WHEN ISNULL(D1_EMISSAO,'') = '' THEN SC6.C6_VALOR ELSE SC6.C6_VALOR*-1 END  L2_VLRITEM,SL1.L1_NSUTEF,B1_COMIS,
						SA3.A3_COD,SA3.A3_NOME 
						FROM %Table:SL1% SL11 (NOLOCK)
						INNER JOIN %Table:SL1% SL1 (NOLOCK) ON SL11.L1_ORCRES = SL1.L1_NUM  AND SL11.L1_FILRES = SL1.L1_FILIAL AND SL1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SC5% SC5 (NOLOCK) ON SL1.L1_FILIAL = SC5.C5_XFILRES AND SL1.L1_NUM = SC5.C5_XORCRES AND SC5.D_E_L_E_T_ = ''
						INNER JOIN %Table:SC6% SC6 (NOLOCK) ON SC5.C5_FILIAL = SC6.C6_FILIAL AND SC5.C5_NUM = SC6.C6_NUM AND SC6.D_E_L_E_T_ = ''
						INNER JOIN %Table:SB1% SB1 (NOLOCK) ON SC6.C6_PRODUTO = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA1% SA1 (NOLOCK) ON SL1.L1_CLIENTE = SA1.A1_COD AND SL1.L1_LOJA = SA1.A1_LOJA AND SA1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA3% SA3 (NOLOCK) ON SL1.L1_VEND = SA3.A3_COD AND SA3.D_E_L_E_T_ = '' AND SA3.A3_MSBLQL != '1'
						LEFT JOIN  %Table:SD1% SD1 (NOLOCK) ON SC6.C6_FILIAL = SD1.D1_FILIAL AND SC6.C6_NOTA = SD1.D1_NFORI AND SC6.C6_SERIE = SD1.D1_SERIORI AND SC6.C6_ITEM = SD1.D1_ITEMORI AND SC6.C6_PRODUTO = SD1.D1_COD AND SD1.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SF2% SF2 (NOLOCK) ON SD1.D1_FILORI = SF2.F2_FILIAL AND SF2.F2_DOC = D1_NFORI AND SF2.F2_SERIE = D1_SERIORI
						WHERE SL1.L1_FILIAL BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
						AND SA3.A3_COD BETWEEN TB.A3_COD AND TB.A3_COD
						AND SL1.L1_EMISNF BETWEEN %Exp:MV_PAR03% AND %Exp:MV_PAR04%
						AND SL1.L1_CLIENTE BETWEEN %Exp:MV_PAR11% AND %Exp:MV_PAR12%
						AND SC6.C6_NOTA BETWEEN %Exp:MV_PAR07% AND %Exp:MV_PAR08%
						AND SC6.C6_SERIE BETWEEN %Exp:MV_PAR09% AND %Exp:MV_PAR10%
						AND SL1.L1_RESERVA = 'S'
						AND SL11.L1_XRES = '1'                                    
						AND SC6.C6_TES NOT IN ('561','723')
						AND SL1.L1_VEND = A3_COD
						
						
						UNION

						//RESERVA DE LOJA
						SELECT  SL11.L1_FILIAL L1_FILORI,SL1.L1_FILIAL L1_FILRES,SL1.L1_EMISNF,SL11.L1_NUM,
						CASE WHEN SC5.C5_NUM IS NULL THEN SL1.L1_ORCRES ELSE SC5.C5_NUM END L1_PEDRES,
						SL11.L1_DOCPED,SL11.L1_SERPED,
						CASE WHEN SC5.C5_NOTA IS NULL THEN SL1.L1_DOC ELSE SC5.C5_NOTA END L1_DOC,
						CASE WHEN SC5.C5_SERIE IS NULL THEN SL1.L1_SERIE ELSE SC5.C5_SERIE END L1_SERIE,
						ISNULL(D1_DOC,'')D1_DOC,ISNULL(D1_SERIE,'')D1_SERIE,ISNULL(D1_EMISSAO,'')D1_EMISSAO,
						SL1.L1_CLIENTE,SA1.A1_NOME,
						SL2.L2_ITEM,SL2.L2_PRODUTO,SL2.L2_DESCRI,
						CASE WHEN ISNULL(D1_EMISSAO,'') = '' THEN SL2.L2_VLRITEM ELSE SL2.L2_VLRITEM*-1 END L2_VLRITEM,SL11.L1_NSUTEF,
						B1_COMIS,SA3.A3_COD,SA3.A3_NOME
						FROM %Table:SL1% SL1 (NOLOCK)
						LEFT JOIN %Table:SL1% SL11 (NOLOCK) ON SL1.L1_ORCRES = SL11.L1_NUM  AND SL1.L1_FILRES = SL11.L1_FILIAL AND SL11.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SC5% SC5 (NOLOCK) ON SL11.L1_FILIAL = SC5.C5_XFILRES AND SL11.L1_NUM = SC5.C5_XORCRES AND SC5.D_E_L_E_T_ = ''
						INNER JOIN %Table:SL2% SL2 (NOLOCK) ON SL1.L1_FILIAL = SL2.L2_FILIAL AND SL1.L1_NUM = SL2.L2_NUM AND SL1.D_E_L_E_T_ = '' AND SL2.D_E_L_E_T_ = ''
						INNER JOIN %Table:SB1% SB1 (NOLOCK) ON SL2.L2_PRODUTO = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA1% SA1 (NOLOCK) ON SL1.L1_CLIENTE = SA1.A1_COD AND SL1.L1_LOJA = SA1.A1_LOJA AND SA1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA3% SA3 (NOLOCK) ON SL1.L1_VEND = SA3.A3_COD AND SA3.D_E_L_E_T_ = '' AND SA3.A3_MSBLQL != '1'
						LEFT JOIN  %Table:SD1% SD1 (NOLOCK) ON SL1.L1_FILIAL = SD1.D1_FILIAL AND SL1.L1_DOC = SD1.D1_NFORI AND SL1.L1_SERIE = SD1.D1_SERIORI AND SL2.L2_ITEM = SD1.D1_ITEMORI AND SL2.L2_PRODUTO = SD1.D1_COD AND SD1.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SF2% SF2 (NOLOCK) ON SD1.D1_FILORI = SF2.F2_FILIAL AND SF2.F2_DOC = D1_NFORI AND SF2.F2_SERIE = D1_SERIORI
						WHERE SL11.L1_FILIAL BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
						AND SA3.A3_COD BETWEEN TB.A3_COD AND TB.A3_COD
						AND SL11.L1_EMISNF BETWEEN %Exp:MV_PAR03% AND %Exp:MV_PAR04%
						AND SL11.L1_CLIENTE BETWEEN %Exp:MV_PAR11% AND %Exp:MV_PAR12%
						AND SL11.L1_DOC BETWEEN %Exp:MV_PAR07% AND %Exp:MV_PAR08%
						AND SL11.L1_SERIE BETWEEN %Exp:MV_PAR09% AND %Exp:MV_PAR10%
						AND SL11.L1_RESERVA = 'S'
						AND SL1.L1_VEND = A3_COD

						UNION 
						//ORCAMENTO DE RESERVA
						SELECT SL1.L1_FILIAL L1_FILORI,SL11.L1_FILIAL L1_FILRES,SL1.L1_EMISNF,SL1.L1_NUM,
						CASE WHEN SL1.L1_PEDRES = '' THEN SC5.C5_NUM ELSE SL1.L1_PEDRES END L1_PEDRES,
						SL1.L1_DOCPED,SL1.L1_SERPED,SC5.C5_NOTA L1_DOC,SC5.C5_SERIE L1_SERIE,
						ISNULL(D1_DOC,'')D1_DOC,ISNULL(D1_SERIE,'')D1_SERIE,ISNULL(D1_EMISSAO,'')D1_EMISSAO,
						SL1.L1_CLIENTE,SA1.A1_NOME,
						SC6.C6_ITEM,SC6.C6_PRODUTO,SC6.C6_DESCRI,
						CASE WHEN ISNULL(D1_EMISSAO,'') = '' THEN SC6.C6_VALOR ELSE SC6.C6_VALOR*-1 END  L2_VLRITEM,SL1.L1_NSUTEF,
						B1_COMIS,SA3.A3_COD,SA3.A3_NOME                     
						FROM %Table:SL1% SL11 (NOLOCK)
						INNER JOIN %Table:SL1% SL1 (NOLOCK) ON SL11.L1_ORCRES = SL1.L1_NUM  AND SL11.L1_FILRES = SL1.L1_FILIAL AND SL11.L1_DOC = '' AND SL1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SC5% SC5 (NOLOCK) ON SL1.L1_FILIAL = SC5.C5_XFILRES AND SL1.L1_NUM = SC5.C5_XORCRES AND SC5.D_E_L_E_T_ = ''
						INNER JOIN %Table:SC6% SC6 (NOLOCK) ON SC5.C5_FILIAL = SC6.C6_FILIAL AND SC5.C5_NUM = SC6.C6_NUM AND SC6.D_E_L_E_T_ = ''
						INNER JOIN %Table:SB1% SB1 (NOLOCK) ON SC6.C6_PRODUTO = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA1% SA1 (NOLOCK) ON SL1.L1_CLIENTE = SA1.A1_COD AND SL1.L1_LOJA = SA1.A1_LOJA AND SA1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA3% SA3 (NOLOCK) ON SL1.L1_VEND = SA3.A3_COD AND SA3.D_E_L_E_T_ = '' AND SA3.A3_MSBLQL != '1'
						LEFT JOIN  %Table:SD1% SD1 (NOLOCK) ON SC6.C6_FILIAL = SD1.D1_FILIAL AND SC6.C6_NOTA = SD1.D1_NFORI AND SC6.C6_SERIE = SD1.D1_SERIORI AND SC6.C6_ITEM = SD1.D1_ITEMORI AND SC6.C6_PRODUTO = SD1.D1_COD AND SD1.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SF2% SF2 (NOLOCK) ON SD1.D1_FILORI = SF2.F2_FILIAL AND SF2.F2_DOC = D1_NFORI AND SF2.F2_SERIE = D1_SERIORI
						
						WHERE SL1.L1_FILIAL BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
						AND SD1.D1_EMISSAO BETWEEN %Exp:MV_PAR03% AND %Exp:MV_PAR04%
						AND SA3.A3_COD BETWEEN TB.A3_COD AND TB.A3_COD
						AND SD1.D1_FORNECE BETWEEN %Exp:MV_PAR11% AND %Exp:MV_PAR12%
						AND SD1.D1_NFORI BETWEEN %Exp:MV_PAR07% AND %Exp:MV_PAR08%
						AND SD1.D1_SERIORI BETWEEN %Exp:MV_PAR09% AND %Exp:MV_PAR10%
						AND SL1.L1_RESERVA = 'S'
						AND SL1.L1_XRES = '1'
						and SD1.D1_TIPO = 'D'
						AND SC6.C6_TES NOT IN ('561','723')
						AND SL1.L1_VEND = A3_COD
						
						
						UNION						
						//DEVOLUÇÃO
						
						SELECT SL1.L1_FILIAL L1_FILORI,SL1.L1_FILIAL L1_FILRES,SL1.L1_EMISNF,SL1.L1_NUM,
						CASE WHEN SL1.L1_PEDRES = '' THEN SC5.C5_NUM ELSE SL1.L1_PEDRES END L1_PEDRES,
						SL1.L1_DOCPED,SL1.L1_SERPED,SC5.C5_NOTA L1_DOC,SC5.C5_SERIE L1_SERIE,
						ISNULL(D1_DOC,'')D1_DOC,ISNULL(D1_SERIE,'')D1_SERIE,ISNULL(D1_EMISSAO,'')D1_EMISSAO,
						SL1.L1_CLIENTE,SA1.A1_NOME,
						SD1.D1_ITEMORI,SD1.D1_COD,SB1.B1_DESC,
						CASE WHEN D1_EMISSAO = '' THEN SD1.D1_BASEICM ELSE SD1.D1_BASEICM*-1 END L2_VLRITEM,SL1.L1_NSUTEF,
						B1_COMIS,SA3.A3_COD,SA3.A3_NOME                        
						 FROM %Table:SD1% SD1 (NOLOCK)
						LEFT JOIN %Table:SL1% SL1 (NOLOCK) ON SL1.L1_FILIAL = SD1.D1_FILIAL AND SL1.L1_DOC = SD1.D1_NFORI AND SL1.L1_SERIE = SD1.D1_SERIORI 
						LEFT JOIN %Table:SC5% SC5 (NOLOCK) ON SD1.D1_FILIAL = SC5.C5_FILIAL AND SD1.D1_NFORI = SC5.C5_NOTA AND D1_SERIE = SC5.C5_SERIE AND SC5.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SF2% SF2 (NOLOCK) ON SD1.D1_FILORI = SF2.F2_FILIAL AND SF2.F2_DOC = D1_NFORI AND SF2.F2_SERIE = D1_SERIORI
						INNER JOIN %Table:SB1% SB1 (NOLOCK) ON SD1.D1_COD = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA1% SA1 (NOLOCK) ON SL1.L1_CLIENTE = SA1.A1_COD AND SL1.L1_LOJA = SA1.A1_LOJA AND SA1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA3% SA3 (NOLOCK) ON SL1.L1_VEND = SA3.A3_COD AND SA3.D_E_L_E_T_ = '' AND SA3.A3_MSBLQL != '1'
						WHERE SL1.L1_FILIAL BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
						AND SD1.D1_EMISSAO BETWEEN %Exp:MV_PAR03% AND %Exp:MV_PAR04%
						AND SL1.L1_VEND BETWEEN TB.A3_COD AND TB.A3_COD
						AND SD1.D1_FORNECE BETWEEN %Exp:MV_PAR11% AND %Exp:MV_PAR12%
						AND SD1.D1_NFORI BETWEEN %Exp:MV_PAR07% AND %Exp:MV_PAR08%
						AND SD1.D1_SERIORI BETWEEN %Exp:MV_PAR09% AND %Exp:MV_PAR10%
						AND SD1.D1_TIPO = 'D'
						
		
						 )TB
				)COMISSAO

		
						FROM(     
						//CUPOM                                                                                                 
						SELECT SL1.L1_FILIAL L1_FILORI,SL1.L1_FILIAL L1_FILRES,SL1.L1_EMISNF,SL1.L1_NUM,SL1.L1_PEDRES,SL1.L1_DOCPED,SL1.L1_SERPED,SL1.L1_DOC,SL1.L1_SERIE,
						ISNULL(D1_DOC,'')D1_DOC,ISNULL(D1_SERIE,'')D1_SERIE,ISNULL(D1_EMISSAO,'')D1_EMISSAO,
						SL1.L1_CLIENTE,SA1.A1_NOME,
						SL2.L2_ITEM,SL2.L2_PRODUTO,SL2.L2_DESCRI,
						CASE WHEN ISNULL(D1_EMISSAO,'') = '' THEN SL2.L2_VLRITEM ELSE SL2.L2_VLRITEM*-1 END  L2_VLRITEM,SL1.L1_NSUTEF,B1_COMIS,
						SA3.A3_COD,SA3.A3_NOME
						FROM %Table:SL1% SL1 (NOLOCK)
						INNER JOIN %Table:SL2% SL2 (NOLOCK) ON SL1.L1_FILIAL = SL2.L2_FILIAL AND SL1.L1_NUM = SL2.L2_NUM AND SL1.L1_DOC != ''
						AND SL1.D_E_L_E_T_ = '' AND SL2.D_E_L_E_T_ = ''
						INNER JOIN %Table:SB1% SB1 (NOLOCK) ON SL2.L2_PRODUTO = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA1% SA1 (NOLOCK) ON SL1.L1_CLIENTE = SA1.A1_COD AND SL1.L1_LOJA = SA1.A1_LOJA AND SA1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA3% SA3 (NOLOCK) ON SL1.L1_VEND = SA3.A3_COD AND SA3.D_E_L_E_T_ = '' AND SA3.A3_MSBLQL != '1'
						LEFT JOIN  %Table:SD1% SD1 (NOLOCK) ON SL1.L1_FILIAL = SD1.D1_FILIAL AND SL1.L1_DOC = SD1.D1_NFORI AND SL1.L1_SERIE = SD1.D1_SERIORI AND SL2.L2_ITEM = SD1.D1_ITEMORI AND SL2.L2_PRODUTO = SD1.D1_COD AND SD1.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SF2% SF2 (NOLOCK) ON SD1.D1_FILORI = SF2.F2_FILIAL AND SF2.F2_DOC = D1_NFORI AND SF2.F2_SERIE = D1_SERIORI
						WHERE SL1.L1_FILIAL BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
						AND SA3.A3_COD BETWEEN %Exp:MV_PAR05% AND %Exp:MV_PAR06%
						AND SL1.L1_EMISNF BETWEEN %Exp:MV_PAR03% AND %Exp:MV_PAR04%
						AND SL1.L1_CLIENTE BETWEEN %Exp:MV_PAR11% AND %Exp:MV_PAR12%
						AND SL1.L1_DOC BETWEEN %Exp:MV_PAR07% AND %Exp:MV_PAR08%
						AND SL1.L1_SERIE BETWEEN %Exp:MV_PAR09% AND %Exp:MV_PAR10%
						AND SL1.L1_TIPO = 'V'


						UNION

						//PRODUCAO
						SELECT SL1.L1_FILIAL L1_FILORI,SL11.L1_FILIAL L1_FILRES,SL1.L1_EMISNF,SL1.L1_NUM,
						CASE WHEN SL1.L1_PEDRES = '' THEN SC5.C5_NUM ELSE SL1.L1_PEDRES END L1_PEDRES,
						SL1.L1_DOCPED,SL1.L1_SERPED,SC5.C5_NOTA L1_DOC,SC5.C5_SERIE L1_SERIE,
						ISNULL(D1_DOC,'')D1_DOC,ISNULL(D1_SERIE,'')D1_SERIE,ISNULL(D1_EMISSAO,'')D1_EMISSAO,
						SL1.L1_CLIENTE,SA1.A1_NOME,
						SC6.C6_ITEM L2_ITEM,SC6.C6_PRODUTO L2_PRODUTO,SC6.C6_DESCRI L2_DESCRI,
						CASE WHEN ISNULL(D1_EMISSAO,'') = '' THEN SC6.C6_VALOR ELSE SC6.C6_VALOR*-1 END  L2_VLRITEM,SL1.L1_NSUTEF,B1_COMIS,
						SA3.A3_COD,SA3.A3_NOME
						FROM %Table:SL1% SL11 (NOLOCK)
						INNER JOIN %Table:SL1% SL1 (NOLOCK) ON SL11.L1_ORCRES = SL1.L1_NUM  AND SL11.L1_FILRES = SL1.L1_FILIAL AND SL1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SC5% SC5 (NOLOCK) ON SL1.L1_FILIAL = SC5.C5_XFILRES AND SL1.L1_NUM = SC5.C5_XORCRES AND SC5.D_E_L_E_T_ = ''
						INNER JOIN %Table:SC6% SC6 (NOLOCK) ON SC5.C5_FILIAL = SC6.C6_FILIAL AND SC5.C5_NUM = SC6.C6_NUM AND SC6.D_E_L_E_T_ = ''
						INNER JOIN %Table:SB1% SB1 (NOLOCK) ON SC6.C6_PRODUTO = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA1% SA1 (NOLOCK) ON SL1.L1_CLIENTE = SA1.A1_COD AND SL1.L1_LOJA = SA1.A1_LOJA AND SA1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA3% SA3 (NOLOCK) ON SL1.L1_VEND = SA3.A3_COD AND SA3.D_E_L_E_T_ = '' AND SA3.A3_MSBLQL != '1'
						LEFT JOIN  %Table:SD1% SD1 (NOLOCK) ON SC6.C6_FILIAL = SD1.D1_FILIAL AND SC6.C6_NOTA = SD1.D1_NFORI AND SC6.C6_SERIE = SD1.D1_SERIORI AND SC6.C6_ITEM = SD1.D1_ITEMORI AND SC6.C6_PRODUTO = SD1.D1_COD AND SD1.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SF2% SF2 (NOLOCK) ON SD1.D1_FILORI = SF2.F2_FILIAL AND SF2.F2_DOC = D1_NFORI AND SF2.F2_SERIE = D1_SERIORI
						WHERE SL1.L1_FILIAL BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
						AND SA3.A3_COD BETWEEN %Exp:MV_PAR05% AND %Exp:MV_PAR06%
						AND SL1.L1_EMISNF BETWEEN %Exp:MV_PAR03% AND %Exp:MV_PAR04%
						AND SL1.L1_CLIENTE BETWEEN %Exp:MV_PAR11% AND %Exp:MV_PAR12%
						AND SC6.C6_NOTA BETWEEN %Exp:MV_PAR07% AND %Exp:MV_PAR08%
						AND SC6.C6_SERIE BETWEEN %Exp:MV_PAR09% AND %Exp:MV_PAR10%
						AND SL1.L1_RESERVA = 'S'
						AND SL11.L1_XRES = '1'                                    
						AND SC6.C6_TES NOT IN ('561','723')

						UNION
		
						//RESERVA DE LOJA
						SELECT SL11.L1_FILIAL L1_FILORI,SL1.L1_FILIAL L1_FILRES,SL1.L1_EMISNF,SL11.L1_NUM,
						CASE WHEN SC5.C5_NUM IS NULL THEN SL1.L1_ORCRES ELSE SC5.C5_NUM END L1_PEDRES,
						SL11.L1_DOCPED,SL11.L1_SERPED,
						CASE WHEN SC5.C5_NOTA IS NULL THEN SL1.L1_DOC ELSE SC5.C5_NOTA END L1_DOC,
						CASE WHEN SC5.C5_SERIE IS NULL THEN SL1.L1_SERIE ELSE SC5.C5_SERIE END L1_SERIE,
						ISNULL(D1_DOC,'')D1_DOC,ISNULL(D1_SERIE,'')D1_SERIE,ISNULL(D1_EMISSAO,'')D1_EMISSAO,
						SL1.L1_CLIENTE,SA1.A1_NOME,
						SL2.L2_ITEM,SL2.L2_PRODUTO,SL2.L2_DESCRI,
						CASE WHEN ISNULL(D1_EMISSAO,'') = '' THEN L2_VLRITEM ELSE L2_VLRITEM*-1 END  L2_VLRITEM,SL11.L1_NSUTEF,
						B1_COMIS,SA3.A3_COD,SA3.A3_NOME
						FROM %Table:SL1% SL1 (NOLOCK)
						LEFT JOIN %Table:SL1% SL11 (NOLOCK) ON SL1.L1_ORCRES = SL11.L1_NUM  AND SL1.L1_FILRES = SL11.L1_FILIAL AND SL11.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SC5% SC5 (NOLOCK) ON SL11.L1_FILIAL = SC5.C5_XFILRES AND SL11.L1_NUM = SC5.C5_XORCRES AND SC5.D_E_L_E_T_ = ''
						INNER JOIN %Table:SL2% SL2 (NOLOCK) ON SL1.L1_FILIAL = SL2.L2_FILIAL AND SL1.L1_NUM = SL2.L2_NUM
						AND SL1.D_E_L_E_T_ = '' AND SL2.D_E_L_E_T_ = ''
						INNER JOIN %Table:SB1% SB1 (NOLOCK) ON SL2.L2_PRODUTO = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA1% SA1 (NOLOCK) ON SL1.L1_CLIENTE = SA1.A1_COD AND SL1.L1_LOJA = SA1.A1_LOJA AND SA1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA3% SA3 (NOLOCK) ON SL1.L1_VEND = SA3.A3_COD AND SA3.D_E_L_E_T_ = '' AND SA3.A3_MSBLQL != '1'
						LEFT JOIN  %Table:SD1% SD1 (NOLOCK) ON SL1.L1_FILIAL = SD1.D1_FILIAL AND SL1.L1_DOC = SD1.D1_NFORI AND SL1.L1_SERIE = SD1.D1_SERIORI AND SL2.L2_ITEM = SD1.D1_ITEMORI AND SL2.L2_PRODUTO = SD1.D1_COD AND SD1.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SF2% SF2 (NOLOCK) ON SD1.D1_FILORI = SF2.F2_FILIAL AND SF2.F2_DOC = D1_NFORI AND SF2.F2_SERIE = D1_SERIORI
						WHERE SL11.L1_FILIAL BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
						AND SA3.A3_COD BETWEEN %Exp:MV_PAR05% AND %Exp:MV_PAR06%
						AND SL11.L1_EMISNF BETWEEN %Exp:MV_PAR03% AND %Exp:MV_PAR04%
						AND SL11.L1_CLIENTE BETWEEN %Exp:MV_PAR11% AND %Exp:MV_PAR12%
						AND SL11.L1_DOC BETWEEN %Exp:MV_PAR07% AND %Exp:MV_PAR08%
						AND SL11.L1_SERIE BETWEEN %Exp:MV_PAR09% AND %Exp:MV_PAR10%
						AND SL11.L1_RESERVA = 'S'


						UNION 
						
						//ORCAMENTO DE RESERVA
						SELECT SL1.L1_FILIAL L1_FILORI,SL11.L1_FILIAL L1_FILRES,SL1.L1_EMISNF,SL1.L1_NUM,
						CASE WHEN SL1.L1_PEDRES = '' THEN SC5.C5_NUM ELSE SL1.L1_PEDRES END L1_PEDRES,
						SL1.L1_DOCPED,SL1.L1_SERPED,SC5.C5_NOTA L1_DOC,SC5.C5_SERIE L1_SERIE,
						ISNULL(D1_DOC,'')D1_DOC,ISNULL(D1_SERIE,'')D1_SERIE,ISNULL(D1_EMISSAO,'')D1_EMISSAO,
						SL1.L1_CLIENTE,SA1.A1_NOME,
						SC6.C6_ITEM,SC6.C6_PRODUTO,SC6.C6_DESCRI,
						CASE WHEN ISNULL(D1_EMISSAO,'') = '' THEN SC6.C6_VALOR ELSE SC6.C6_VALOR*-1 END  L2_VLRITEM,SL1.L1_NSUTEF,
						B1_COMIS,SA3.A3_COD,SA3.A3_NOME                       
						FROM %Table:SL1% SL11 (NOLOCK)
						INNER JOIN %Table:SL1% SL1 (NOLOCK) ON SL11.L1_ORCRES = SL1.L1_NUM  AND SL11.L1_FILRES = SL1.L1_FILIAL AND SL11.L1_DOC = '' AND SL1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SC5% SC5 (NOLOCK) ON SL1.L1_FILIAL = SC5.C5_XFILRES AND SL1.L1_NUM = SC5.C5_XORCRES AND SC5.D_E_L_E_T_ = ''
						INNER JOIN %Table:SC6% SC6 (NOLOCK) ON SC5.C5_FILIAL = SC6.C6_FILIAL AND SC5.C5_NUM = SC6.C6_NUM AND SC6.D_E_L_E_T_ = ''
						INNER JOIN %Table:SB1% SB1 (NOLOCK) ON SC6.C6_PRODUTO = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA1% SA1 (NOLOCK) ON SL1.L1_CLIENTE = SA1.A1_COD AND SL1.L1_LOJA = SA1.A1_LOJA AND SA1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA3% SA3 (NOLOCK) ON SL1.L1_VEND = SA3.A3_COD AND SA3.D_E_L_E_T_ = '' AND SA3.A3_MSBLQL != '1'
						LEFT JOIN  %Table:SD1% SD1 (NOLOCK) ON SC6.C6_FILIAL = SD1.D1_FILIAL AND SC6.C6_NOTA = SD1.D1_NFORI AND SC6.C6_SERIE = SD1.D1_SERIORI 
						AND SC6.C6_ITEM = SD1.D1_ITEMORI AND SC6.C6_PRODUTO = SD1.D1_COD AND SD1.D_E_L_E_T_ = ''
						LEFT JOIN %Table:SF2% SF2 (NOLOCK) ON SD1.D1_FILORI = SF2.F2_FILIAL AND SF2.F2_DOC = D1_NFORI AND SF2.F2_SERIE = D1_SERIORI
						WHERE SL1.L1_FILIAL BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
						AND SD1.D1_EMISSAO BETWEEN %Exp:MV_PAR03% AND %Exp:MV_PAR04%
						AND SA3.A3_COD BETWEEN %Exp:MV_PAR05% AND %Exp:MV_PAR06%
						AND SD1.D1_FORNECE BETWEEN %Exp:MV_PAR11% AND %Exp:MV_PAR12%
						AND SD1.D1_NFORI BETWEEN %Exp:MV_PAR07% AND %Exp:MV_PAR08%
						AND SD1.D1_SERIORI BETWEEN %Exp:MV_PAR09% AND %Exp:MV_PAR10%
						AND SL1.L1_RESERVA = 'S'
						AND SL1.L1_XRES = '1'
						and SD1.D1_TIPO = 'D'
						AND SC6.C6_TES NOT IN ('561','723')
						
						UNION 
						
						//DEVOLUÇÃO
						SELECT SL1.L1_FILIAL L1_FILORI,SL1.L1_FILIAL L1_FILRES,SL1.L1_EMISNF,SL1.L1_NUM,
						CASE WHEN SL1.L1_PEDRES = '' THEN SC5.C5_NUM ELSE SL1.L1_PEDRES END L1_PEDRES,
						SL1.L1_DOCPED,SL1.L1_SERPED,SC5.C5_NOTA L1_DOC,SC5.C5_SERIE L1_SERIE,
						ISNULL(D1_DOC,'')D1_DOC,ISNULL(D1_SERIE,'')D1_SERIE,ISNULL(D1_EMISSAO,'')D1_EMISSAO,
						SL1.L1_CLIENTE,SA1.A1_NOME,
						SD1.D1_ITEMORI,SD1.D1_COD,SB1.B1_DESC,
						CASE WHEN D1_EMISSAO = '' THEN SD1.D1_BASEICM ELSE SD1.D1_BASEICM*-1 END L2_VLRITEM,SL1.L1_NSUTEF,
						B1_COMIS,SA3.A3_COD,SA3.A3_NOME                        
						FROM %Table:SD1% SD1 (NOLOCK)
						INNER JOIN %Table:SL1% SL1 (NOLOCK) ON SL1.L1_FILIAL = SD1.D1_FILIAL AND SL1.L1_DOC = SD1.D1_NFORI AND SL1.L1_SERIE = SD1.D1_SERIORI 
						INNER JOIN %Table:SC5% SC5 (NOLOCK) ON SD1.D1_FILIAL = SC5.C5_FILIAL AND SD1.D1_NFORI = SC5.C5_NOTA AND D1_SERIE = SC5.C5_SERIE AND SC5.D_E_L_E_T_ = ''
						INNER JOIN %Table:SB1% SB1 (NOLOCK) ON SD1.D1_COD = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA1% SA1 (NOLOCK) ON SL1.L1_CLIENTE = SA1.A1_COD AND SL1.L1_LOJA = SA1.A1_LOJA AND SA1.D_E_L_E_T_ = ''
						INNER JOIN %Table:SA3% SA3 (NOLOCK) ON SL1.L1_VEND = SA3.A3_COD AND SA3.D_E_L_E_T_ = '' AND SA3.A3_MSBLQL != '1'
						LEFT JOIN %Table:SF2% SF2 (NOLOCK) ON SD1.D1_FILORI = SF2.F2_FILIAL AND SF2.F2_DOC = D1_NFORI AND SF2.F2_SERIE = D1_SERIORI
						WHERE SL1.L1_FILIAL BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
						AND SD1.D1_EMISSAO BETWEEN %Exp:MV_PAR03% AND %Exp:MV_PAR04%
						AND SA3.A3_COD BETWEEN %Exp:MV_PAR05% AND %Exp:MV_PAR06%
						AND SD1.D1_FORNECE BETWEEN %Exp:MV_PAR11% AND %Exp:MV_PAR12%
						AND SD1.D1_NFORI BETWEEN %Exp:MV_PAR07% AND %Exp:MV_PAR08%
						AND SD1.D1_SERIORI BETWEEN %Exp:MV_PAR09% AND %Exp:MV_PAR10%
						AND SD1.D1_TIPO = 'D'
						
				)TB
						LEFT JOIN TMPCOMI TC ON TB.L1_FILORI = TC.TMP_FILORI AND TB.L1_FILRES = TC.TMP_FILRES AND TB.L1_NUM = TC.TMP_NUM AND TB.L1_CLIENTE = TC.TMP_CLIENTE
		)TB2
)TB3
ORDER BY L1_FILORI,L1_EMISNF,L1_DOCPED,L1_SERPED,L1_DOC,L1_SERIE,L2_PRODUTO
		
	
	EndSQL 

	oSection:EndQuery() 
	oSection:SetParentQuery()
	oSection:Print()	 
Return


Static Function AjustaSX1(cPerg)


	u_InPutSX1(cPerg,"01",PADR("Filial De      ",20)+"?","","","mv_ch1","C",2,0,0,"G","","SM0","","","mv_par01") 
	u_InPutSX1(cPerg,"02",PADR("Filial Até     ",20)+"?","","","mv_ch2","C",2,0,0,"G","","SM0","","","mv_par02") 
	u_InPutSX1(cPerg,"03",PADR("Emissao De     ",20)+"?","","","mv_ch3","D",8,0,0,"G","","","","","mv_par03") 
