User Function LJ7030()

	IF !SA6->A6_DATAABR=DDATABASE                
		Reclock("SA6",.F.)
		SA6->A6_DATAABR	:=DDATABASE
		SA6->A6_HORAABR	:= "05:00"
		SA6->A6_DATAFCH	:=CTOD("")
		SA6->A6_HORAFCH	:="" 
		SA6->(MsUnlock())
	ENDIF     

RETURN .T.