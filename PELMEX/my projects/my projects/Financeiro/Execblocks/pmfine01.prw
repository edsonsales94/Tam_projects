User Function natufornece(_cNatu,_cFor,_cLoja)
	local chist := ""
	chist := ALLTRIM(POSICIONE("SED",1,"  "+_cNatu,ALLTRIM("ED_DESCRIC")))+" "+ALLTRIM(POSICIONE("SA2",1,"  "+_cFor+_cLoja,alltrim("A2_NOME")))                                                       

Return chist



