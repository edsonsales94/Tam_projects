User Function PMPCPR84()
	Local oReport
	Local cQuery
	Local cAlias      := getNextAlias()      

	Private cPerg     := "PMPCPR84"

	AjustaSX1(cPerg)
	Pergunte(cPerg,.F.)

	oReport := ReportDef(cAlias,cPerg)
	oReport:PrintDialog()
Return


Static Function ReportDef(cAlias,cPerg)
	Local oReport
	Local oSection
	Local oBreak
	Local aOrdem      := {"FILIAL"}

	oReport := TReport():New(cPerg,"Status Plano Prod. por Volume",cPerg,{|oReport| PrintReport(oReport,cAlias)}, )
	oReport:SetPortrait()      
	oReport:SetEnvironment(2)      

	//Primeira se็ใo
	oSection := TRSection():New(oReport,"Status Plano Prod. por Volume",{"PED"},aOrdem)  
	


	TRCell():New(oSection,"DT_PRODUCAO"    							,"PED","Dt.Produ็ใo","@!",12)
	TRCell():New(oSection,"TOTAL_PROGRAMADO"   						,"PED","Total Programado","@E 999,999,999,999.99",)
	TRCell():New(oSection,"TOTAL_PRODUZIDO"							,"PED","Total Produzido","@E 999,999,999,999.99",)
	TRCell():New(oSection,"TOTAL_FATURADO"							,"SD2","Total Faturado","@E 999,999,999,999.99",)
	TRCell():New(oSection,"TOTAL_CANCELADO"							,"SAI","Total Cancelado","@E 999,999,999,999.99",)
	TRCell():New(oSection,"TOTAL_EXPEDIDO"	,"PED"                 ,"Total Expedido","@E 999,999,999,999.99",)
	TRCell():New(oSection,"DIF_TOTAL_PROGRAMADO_TOTAL_PRODUZIDO"		,"PED","Dif. Total Programado x Total Produzido","@E 999,999,999,999.99",)
    TRCell():New(oSection,"DIF_TOTAL_PRODUZIDO_TOTAL_FATURADO"		,"PED","Dif. Total Produzido x Total Faturado","@E 999,999,999,999.99",)
	TRCell():New(oSection,"DIF_TOTAL_FATURADO_TOTAL_EXPEDIDO"		,"SAI","Dif. Total Faturado x Total Expedido","@E 999,999,999,999.99",)
		
	/*TRCell():New(oSection,"C6_FILIAL"	  	,"SC2","FILIAL","@!",2)
	TRCell():New(oSection,"C6_QUANT"    	,"SC6","QUANTIDADE","@E 999,999,999,999",) 
	TRCell():New(oSection,"C6_PRCVEN"    	,"SC6","PREวO VEND","@E 999,999,999.999",)
	//Totalizador                                                                                  
	//TRFunction():New(oSection:Cell("ETIQUETA"),"Etiqueta:","SUM",,,"@E 999,999,999,999",,.F.,.T.)*/

Return oReport


/*Inicia Logica Print Report */

Static Function PrintReport(oReport,cAlias)
	Local oSection  := oReport:Section(1)

	//if oReport:Section(1):GetOrder() == 1
	//	cOrdem := "A1_COD"
	//endif      


	oSection:BeginQuery()
	BeginSQL Alias cAlias
		%noparser%

SELECT UPPER(DATENAME(DW,PED_DTPROPEL))DIA,PED_DTPROPEL DT_PRODUCAO,
       TOTAL_PROGRAMADO,TOTAL_PRODUZIDO,TOTAL_FATURADO,TOTAL_CANCELADO,TOTAL_EXPEDIDO,
       CAST(CAST(TOTAL_PROGRAMADO AS NUMERIC(15,2)) AS FLOAT)-(CAST(CAST(TOTAL_PRODUZIDO AS NUMERIC(15,2)) AS FLOAT)) DIF_TOTAL_PROGRAMADO_TOTAL_PRODUZIDO,
     CAST(CAST(TOTAL_PRODUZIDO AS NUMERIC(15,2)) AS FLOAT)-(CAST(CAST(TOTAL_FATURADO AS NUMERIC(15,2)) AS FLOAT)) DIF_TOTAL_PRODUZIDO_TOTAL_FATURADO,
     TOTAL_FATURADO-TOTAL_CANCELADO-TOTAL_EXPEDIDO DIF_TOTAL_FATURADO_TOTAL_EXPEDIDO
FROM(
SELECT PED_DTPROPEL,
       SUM(TOTAL_PROGRAMADO)TOTAL_PROGRAMADO,
     SUM(TOTAL_FATURADO)TOTAL_FATURADO,
     SUM(TOTAL_CANCELADO)TOTAL_CANCELADO,
     SUM(TOTAL_PRODUZIDO)TOTAL_PRODUZIDO,
     SUM(TOTAL_EXPEDIDO)TOTAL_EXPEDIDO
FROM(
SELECT PED_DTPROPEL,0 TOTAL_PEDIDO,SUM(PED_QUANT)TOTAL_PROGRAMADO,0 TOTAL_FATURADO,0 TOTAL_CANCELADO,0 TOTAL_PRODUZIDO,0 TOTAL_EXPEDIDO
FROM(
SELECT PED_DTPROPEL,CAST(SUM(PED_QUANT) AS FLOAT)PED_QUANT
FROM(
SELECT PED_DTPROPEL,PED_FILIAL,PED_NUM,PED_ITEM,PED_PRODUTO,PED_QUANT,C6_PRCVEN * PED_QUANT PED_TOTAL
FROM PED
INNER JOIN SC6100 SC6 (NOLOCK) ON PED_FILIAL = C6_FILIAL AND PED_NUM = C6_NUM AND PED_ITEM = C6_ITEM AND PED_PRODUTO = C6_PRODUTO AND PED_NOTA = ''
WHERE PED_STATUS != 'C'
AND PED_OP != ''
AND CONVERT(VARCHAR,CAST(PED_DTPROPEL AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
)TB
GROUP BY PED_DTPROPEL
UNION ALL
SELECT PED_DTPROPEL,CAST(SUM(PED_QUANT) AS FLOAT)PED_QUANT
FROM(
SELECT PED_DTPROPEL,PED_FILIAL,PED_NUM,PED_ITEM,PED_PRODUTO,PED_QUANT,D2_PRCVEN * PED_QUANT PED_TOTAL
FROM SD2100 SD2 (NOLOCK)
INNER JOIN PED ON D2_FILIAL = PED_FILIAL AND D2_DOC = PED_NOTA AND D2_SERIE = PED_SERIE AND D2_ITEMPV = PED_ITEM AND D2_COD = PED_PRODUTO
WHERE PED_STATUS != 'C'
AND PED_OP != ''
AND CONVERT(VARCHAR,CAST(PED_DTPROPEL AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
)TB
GROUP BY PED_DTPROPEL
)TB1
GROUP BY PED_DTPROPEL
UNION
SELECT PED_DTPROPEL,0 TOTAL_PEDIDO,0 TOTAL_PROGRAMADO,SUM(D2_QUANT)TOTAL_FATURADO,0 TOTAL_CANCELADO,0 TOTAL_PRODUZIDO,0 TOTAL_EXPEDIDO
FROM(
SELECT PED_DTPROPEL,SUM(D2_QUANT)D2_QUANT
FROM SD2100 SD2
LEFT JOIN SD1100 SD1 ON D2_FILIAL = D1_FILIAL AND D2_DOC = D1_NFORI AND D2_SERIE = D1_SERIORI AND D2_ITEM = D1_ITEMORI AND D2_COD = D1_COD AND SD1.D_E_L_E_T_ = ''
INNER JOIN PED ON D2_FILIAL = PED_FILIAL AND D2_PEDIDO = PED_NUM AND D2_ITEMPV = PED_ITEM AND D2_COD = PED_PRODUTO AND PED_NOTA = '' AND PED_STATUS = ''
WHERE SD2.D_E_L_E_T_ = ''
AND D2_FILIAL = '01'
AND D2_LOCAL = '20'
AND CONVERT(VARCHAR,CAST(PED_DTPROPEL AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
GROUP BY PED_DTPROPEL
UNION ALL
SELECT PED_DTPROPEL,SUM(D2_QUANT)D2_QUANT
FROM SD2100 SD2
LEFT JOIN SD1100 SD1 ON D2_FILIAL = D1_FILIAL AND D2_DOC = D1_NFORI AND D2_SERIE = D1_SERIORI AND D2_ITEM = D1_ITEMORI AND D2_COD = D1_COD AND SD1.D_E_L_E_T_ = ''
INNER JOIN PED ON D2_FILIAL = PED_FILIAL AND D2_DOC = PED_NOTA AND D2_SERIE = PED_SERIE AND D2_ITEMPV = PED_ITEM AND D2_COD = PED_PRODUTO AND PED_STATUS = ''
WHERE SD2.D_E_L_E_T_ = ''
AND D2_FILIAL = '01'
AND D2_LOCAL = '20'
AND CONVERT(VARCHAR,CAST(PED_DTPROPEL AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
GROUP BY PED_DTPROPEL
)TB
GROUP BY PED_DTPROPEL
UNION
SELECT PED_DTPROPEL,0 TOTAL_PEDIDO,0 TOTAL_PROGRAMADO,0 TOTAL_FATURADO,SUM(D2_QUANT)TOTAL_CANCELADO,0 TOTAL_PRODUZIDO,0 TOTAL_EXPEDIDO
FROM(
SELECT PED_DTPROPEL,SUM(D2_QUANT)D2_QUANT
FROM SD2100 SD2
LEFT JOIN SD1100 SD1 ON D2_FILIAL = D1_FILIAL AND D2_DOC = D1_NFORI AND D2_SERIE = D1_SERIORI AND D2_ITEM = D1_ITEMORI AND D2_COD = D1_COD AND SD1.D_E_L_E_T_ = ''
INNER JOIN PED ON D2_FILIAL = PED_FILIAL AND D2_PEDIDO = PED_NUM AND D2_ITEMPV = PED_ITEM AND D2_COD = PED_PRODUTO AND PED_NOTA = '' AND PED_STATUS = ''
WHERE SD2.D_E_L_E_T_ = ''
AND D2_FILIAL = '01'
AND D2_LOCAL = '20'
AND D1_DOC IS NOT NULL
AND CONVERT(VARCHAR,CAST(PED_DTPROPEL AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
GROUP BY PED_DTPROPEL
UNION ALL
SELECT PED_DTPROPEL,SUM(D2_QUANT)D2_QUANT
FROM SD2100 SD2

LEFT JOIN SD1100 SD1 ON D2_FILIAL = D1_FILIAL AND D2_DOC = D1_NFORI AND D2_SERIE = D1_SERIORI AND D2_ITEM = D1_ITEMORI AND D2_COD = D1_COD AND SD1.D_E_L_E_T_ = ''
INNER JOIN PED ON D2_FILIAL = PED_FILIAL AND D2_DOC = PED_NOTA AND D2_SERIE = PED_SERIE AND D2_ITEMPV = PED_ITEM AND D2_COD = PED_PRODUTO AND PED_STATUS = ''
WHERE SD2.D_E_L_E_T_ = ''
AND D2_FILIAL = '01'
AND D2_LOCAL = '20'
AND D1_DOC IS NOT NULL
AND CONVERT(VARCHAR,CAST(PED_DTPROPEL AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
GROUP BY PED_DTPROPEL
)TB
GROUP BY PED_DTPROPEL
UNION
SELECT PED_DTPROPEL,0 TOTAL_PEDIDO,0 TOTAL_PROGRAMADO,0 TOTAL_FATURADO,0 TOTAL_CANCELADO,CAST(SUM(Z1_QUANT) AS FLOAT)TOTAL_PRODUZIDO,0 TOTAL_EXPEDIDO
FROM(
SELECT PED_DTPROPEL,C2_PRODUTO,CASE WHEN B1_XJUNCAO = 'S' THEN 0.5 ELSE 1 END Z1_QUANT,C6_PRCVEN,
       CASE WHEN B1_XJUNCAO = 'S' THEN 0.5 ELSE 1 END * C6_PRCVEN Z1_VALOR
FROM SZ1100 SZ1(NOLOCK)
INNER JOIN SC2100 SC2 (NOLOCK) ON Z1_OP = C2_NUM+C2_ITEM+C2_SEQUEN AND SC2.D_E_L_E_T_ = ''
INNER JOIN SB1100 SB1 (NOLOCK) ON C2_PRODUTO = B1_COD AND SB1.D_E_L_E_T_ = ''
INNER JOIN PED (NOLOCK) ON C2_NUM = PED_OP AND C2_PRODUTO = PED_PRODUTO AND PED_STATUS = ''
INNER JOIN SC6100 SC6 (NOLOCK) ON PED_FILIAL = C6_FILIAL AND PED_NUM = C6_NUM AND PED_ITEM = C6_ITEM AND PED_PRODUTO = C6_PRODUTO
WHERE SZ1.D_E_L_E_T_ = ''
AND CONVERT(VARCHAR,CAST(PED_DTPROPEL AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
)TB
GROUP BY PED_DTPROPEL
UNION
SELECT PED_DTPROPEL,0 TOTAL_PEDIDO,0 TOTAL_PROGRAMADO,0 TOTAL_FATURADO,0 TOTAL_CANCELADO,0 TOTAL_PRODUZIDO,SUM(D2_QUANT)TOTAL_EXPEDIDO
FROM(
SELECT PED_DTPROPEL,SUM(D2_QUANT)D2_QUANT
FROM SD2100 SD2 (NOLOCK)
LEFT JOIN SD1100 (NOLOCK) SD1 ON D2_FILIAL = D1_FILIAL AND D2_DOC = D1_NFORI AND D2_SERIE = D1_SERIORI AND D2_ITEM = D1_ITEMORI AND D2_COD = D1_COD AND SD1.D_E_L_E_T_ = ''
INNER JOIN PED (NOLOCK) ON D2_FILIAL = PED_FILIAL AND D2_PEDIDO = PED_NUM AND D2_ITEMPV = PED_ITEM AND D2_COD = PED_PRODUTO AND PED_NOTA = '' AND PED_STATUS = ''
INNER JOIN CNF (NOLOCK) ON D2_FILIAL = CNF_FILIAL AND D2_DOC = CNF_DOC AND D2_SERIE = CNF_SERIE
WHERE SD2.D_E_L_E_T_ = ''
AND D2_FILIAL = '01'
AND D2_LOCAL = '20'
AND CONVERT(VARCHAR,CAST(PED_DTPROPEL AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
GROUP BY PED_DTPROPEL
UNION ALL
SELECT PED_DTPROPEL,SUM(D2_QUANT)D2_QUANT
FROM SD2100 SD2 (NOLOCK)
LEFT JOIN SD1100 SD1 (NOLOCK) ON D2_FILIAL = D1_FILIAL AND D2_DOC = D1_NFORI AND D2_SERIE = D1_SERIORI AND D2_ITEM = D1_ITEMORI AND D2_COD = D1_COD AND SD1.D_E_L_E_T_ = ''
INNER JOIN PED (NOLOCK) ON D2_FILIAL = PED_FILIAL AND D2_DOC = PED_NOTA AND D2_SERIE = PED_SERIE AND D2_ITEMPV = PED_ITEM AND D2_COD = PED_PRODUTO AND PED_STATUS = ''
INNER JOIN CNF (NOLOCK) ON D2_FILIAL = CNF_FILIAL AND D2_DOC = CNF_DOC AND D2_SERIE = CNF_SERIE
WHERE SD2.D_E_L_E_T_ = ''
AND D2_FILIAL = '01'
AND D2_LOCAL = '20'
AND CONVERT(VARCHAR,CAST(PED_DTPROPEL AS DATE),112) BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
GROUP BY PED_DTPROPEL
)TB
GROUP BY PED_DTPROPEL
)TB1
GROUP BY PED_DTPROPEL
)TB2
ORDER BY CONVERT(VARCHAR,CAST(PED_DTPROPEL AS DATE),112)
	EndSQL 


	oSection:EndQuery() 
	oSection:SetParentQuery()
	oSection:Print()	 
Return


Static Function AjustaSX1(cPerg)

	u_InPutSX1(cPerg,"01",PADR("De Dt.Produ็ใo:",20)+"?","","","mv_ch1","D",10,0,0,"G","","","","","mv_par01") 
	u_InPutSX1(cPerg,"02",PADR("Ate Dt.Produ็ใo:",20)+"?","","","mv_ch2","D",10,0,0,"G","","","","","mv_par02")
	
Return
