User Function PMPCPR49()
	Local oReport
	Local cQuery
	Local cAlias      := getNextAlias()      

	Private cPerg     := "PMPCPR49"

	AjustaSX1(cPerg)
	Pergunte(cPerg,.F.)

	oReport := ReportDef(cAlias,cPerg)
	oReport:PrintDialog()
Return


Static Function ReportDef(cAlias,cPerg)
	Local oReport
	Local oSection
	Local oBreak
	Local aOrdem      := {"FILIAL"}

	oReport := TReport():New(cPerg,"OPs Sem Empenho",cPerg,{|oReport| PrintReport(oReport,cAlias)}, )
	oReport:SetPortrait()      
	oReport:SetEnvironment(2)      

	//Primeira se็ใo
	oSection := TRSection():New(oReport,"OPs Sem Empenho",{"SC2"},aOrdem)  
	
	TRCell():New(oSection,"C2_NUM"	        ,"SC2","ORDEM PROD","@!",20)             
	TRCell():New(oSection,"C2_PRODUTO"      ,"SC2","PRODUTO","@!",20) 
	TRCell():New(oSection,"C2_QUANT"   	    ,"SC2","QUANTIDADE","@E 999,999,999,999",8)
	TRCell():New(oSection,"C2_QUJE"   	    ,"SC2","QTDE JE","@E 999,999,999,999",8)
	TRCell():New(oSection,"C2_EMISSAO"      ,"SC2","DT EMISSAO","@!",8)
	
	
	//Totalizador                                                                                  
	//TRFunction():New(oSection:Cell("ETIQUETA"),"Etiqueta:","SUM",,,"@E 999,999,999,999",,.F.,.T.)

Return oReport


/*Inicia Logica Print Report */

Static Function PrintReport(oReport,cAlias)
	Local oSection  := oReport:Section(1)

	//if oReport:Section(1):GetOrder() == 1
	//	cOrdem := "A1_COD"
	//endif      


	oSection:BeginQuery()
	BeginSQL Alias cAlias
		%noparser%

  SELECT C2_NUM,C2_PRODUTO,C2_QUANT,C2_QUJE,C2_EMISSAO
  FROM %Table:SC2% SC2
  	LEFT JOIN %Table:SD4% SD4 ON C2_NUM = SUBSTRING(D4_OP,1,6) AND SD4.D_E_L_E_T_ = ''
  	WHERE SC2.D_E_L_E_T_ = ''
  	AND C2_EMISSAO BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
  	AND D4_OP IS NULL
  	ORDER BY C2_NUM

	EndSQL 


	oSection:EndQuery() 
	oSection:SetParentQuery()
	oSection:Print()	 
Return


Static Function AjustaSX1(cPerg)

	u_InPutSX1(cPerg,"01",PADR("De Dt Emissใo:",20)+"?","","","mv_ch1","D",8,0,0,"G","","","","","mv_par01") 
	u_InPutSX1(cPerg,"02",PADR("Ate Dt Emissใo:",20)+"?","","","mv_ch2","D",8,0,0,"G","","","","","mv_par02")
	//u_InPutSX1(cPerg,"03",PADR("De Pedido:",20)+"?","","","mv_ch3","C",10,0,0,"G","","","","","mv_par03") 
	//u_InPutSX1(cPerg,"04",PADR("Ate Pedido:",20)+"?","","","mv_ch4","C",10,0,0,"G","","","","","mv_par04")
	

Return