User Function PMPCPR91()
	Local oReport
	Local cQuery
	Local cAlias      := getNextAlias()      

	Private cPerg     := "PMPCPR91"

	AjustaSX1(cPerg)
	Pergunte(cPerg,.F.)

	oReport := ReportDef(cAlias,cPerg)
	oReport:PrintDialog()
Return


Static Function ReportDef(cAlias,cPerg)
	Local oReport
	Local oSection
	Local oBreak
	Local aOrdem      := {"FILIAL"}

	oReport := TReport():New(cPerg,"Empenho por Periodo ",cPerg,{|oReport| PrintReport(oReport,cAlias)}, )
	oReport:SetPortrait()      
	oReport:SetEnvironment(2)      

	//Primeira seção
	oSection := TRSection():New(oReport,"Empenho por Periodo",{"SG1"},aOrdem) 

 
    TRCell():New(oSection,"EMISSAO"        ,"SC2","EMISSAO","@!",20)
	TRCell():New(oSection,"OP"		       ,"SD4","OP","@!",20)
	TRCell():New(oSection,"PRODUTO"		    ,"SC2","PRODUTO","@!",30) 
	TRCell():New(oSection,"DESCBLOCO"	    ,"SB1","DESCBLOCO","@!",40)   
	TRCell():New(oSection,"UM"	            ,"SB1","UM","@!",3)
    TRCell():New(oSection,"QTD_BASE"	    ,"SB1","QTDBASE","@E 999,999,999,999.99",)
    TRCell():New(oSection,"COMPONENTE"	     ,"SD4","COMPONENTE","@!",10)
    TRCell():New(oSection,"DESCOMP"	        ,"SB1","DESCOMP","@!",30)
	TRCell():New(oSection,"UMCOMP"	        ,"SB1","UMCOMP","@!",3)
	TRCell():New(oSection,"QTD_EMPENHADA"    ,"SD4","QTD_EMPENHADA","@E 999,999,999,999.99",)
    TRCell():New(oSection,"QTD_ESTRUTURA"    ,"SG1","QTDESTRUTURA","@E 999,999,999,999.99",)
	/*TRCell():New(oSection,"PENDENTE"	    ,"SC2","PENDENTE","@E 999,999,999,999.99",)      
	TRCell():New(oSection,"QTD_PRODUZIDA"  	,"CLA","QTD_PRODUZIDA","@E 999,999,999,999.99",)
	TRCell():New(oSection,"QTD_ENTRADA"	    ,"SZ1","QTD_ENTRADA","@E 999,999,999.999.99",)
	TRCell():New(oSection,"QTD_SAIDA"       ,"SAI","QTD_SAIDA","@E 999,999,999.999.99",)
	TRCell():New(oSection,"CARGA" 	        ,"SC2","CARGA","@!",15) 
	TRCell():New(oSection,"CLIENTE"	        ,"SC2","CLIENTE","@!",30) 
	TRCell():New(oSection,"SETOR"  			,"SB1","SETOR","@!",12)*/
	 
	
    
	
	//Totalizador                                                                                  
	//TRFunction():New(oSection:Cell("PED_QUANT"),"Total Etiqueta:","SUM",,,"@E 999,999,999.999",,.F.,.T.)

Return oReport


/*Inicia Logica Print Report */

Static Function PrintReport(oReport,cAlias)
	Local oSection  := oReport:Section(1)

	//if oReport:Section(1):GetOrder() == 1
	//	cOrdem := "A1_COD"
	//endif      


	oSection:BeginQuery()
	BeginSQL Alias cAlias
		%noparser% 
SELECT CONVERT(VARCHAR,CAST(C2_EMISSAO AS DATE),103)EMISSAO,D4_OP OP,C2_PRODUTO PRODUTO,SB1.B1_DESC DESCBLOCO,SB1.B1_UM UM,SB1.B1_QB QTD_BASE,D4_COD COMPONENTE,SB12.B1_DESC DESCOMP,SB12.B1_UM UMCOMP,D4_QTDEORI QTD_EMPENHADA,ISNULL(G1_QUANT,0)QTD_ESTRUTURA
FROM SD4200 SD4 (NOLOCK)
INNER JOIN SC2200 SC2 (NOLOCK) ON D4_OP = C2_NUM+C2_ITEM+C2_SEQUEN AND SC2.D_E_L_E_T_ = ''
INNER JOIN SB1200 SB1 (NOLOCK) ON C2_PRODUTO = SB1.B1_COD AND SB1.D_E_L_E_T_ = ''
INNER JOIN SB1200 SB12 (NOLOCK) ON D4_COD = SB12.B1_COD AND SB12.D_E_L_E_T_ = ''
LEFT JOIN SG1200 SG1 (NOLOCK) ON C2_PRODUTO = G1_COD AND D4_COD = G1_COMP AND D4_OP = C2_NUM+C2_ITEM+C2_SEQUEN AND D4_TRT = G1_TRT AND G1_FIM >= CONVERT(VARCHAR,GETDATE(),112) AND SG1.D_E_L_E_T_ = '' AND G1_COD  NOT LIKE 'MOD%'
WHERE SD4.D_E_L_E_T_ = ''
AND D4_COD NOT LIKE 'MOD%'
AND C2_EMISSAO BETWEEN %Exp:MV_PAR01% AND %Exp:MV_PAR02%
AND SB1.B1_DESC LIKE 'BL%'
ORDER BY C2_EMISSAO,D4_OP,SB1.B1_DESC,SB12.B1_DESC
EndSQL 


	oSection:EndQuery() 
	oSection:SetParentQuery()
	oSection:Print()	 
Return


Static Function AjustaSX1(cPerg)

	
	u_InPutSX1(cPerg,"01",PADR("De Emissao:",20)+"?","","","mv_ch1","D",10,0,0,"G","","","","","mv_par01") 
	u_InPutSX1(cPerg,"02",PADR("Ate Emissao:",20)+"?","","","mv_ch2","D",10,0,0,"G","","","","","mv_par02")
	//u_InPutSX1(cPerg,"03",PADR("De PA:" ,20)+"?","","","mv_ch3","C",15,0,0,"G","","","","","mv_par03") 
	//u_InPutSX1(cPerg,"04",PADR("Ate PA:",20)+"?","","","mv_ch4","C",15,0,0,"G","","","","","mv_par04")
	
	
	
Return
