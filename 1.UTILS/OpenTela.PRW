#Include "PROTHEUS.CH"
#Include "TBICONN.ch"
/*
Abrir Janela Principal do Sistema para teste de desenvolvimento.
*/
User Function OpenTela()
	ETNTESTE()
return

/*KABAC*/
Static Function ITVSXMLx()
//Local cCHVNF:="13130204180279000193550050000009321007011115"
	PREPARE ENVIRONMENT EMPRESA '01' FILIAL '01' MODULO 'COM'   USER "ADMIN" PASSWORD "Msiga@2027"
	DEFINE WINDOW oMainWnd FROM 001,001 TO 400,500 TITLE 'Janela Principal'
	ACTIVATE WINDOW oMainWnd MAXIMIZED ON INIT ( u_ITVSXML() , oMainWnd:End() )
	RESET ENVIRONMENT
Return nil
/*KABAC*/
Static Function ETNTESTE()
//Local cCHVNF:="13130204180279000193550050000009321007011115"
	PREPARE ENVIRONMENT EMPRESA '01' FILIAL '01' MODULO 'FAT'   USER "ADMIN" PASSWORD "Amazonas2027*!"
	DEFINE WINDOW oMainWnd FROM 001,001 TO 400,500 TITLE 'Janela Principal'
	ACTIVATE WINDOW oMainWnd MAXIMIZED ON INIT ( U_ETNAGE01() , oMainWnd:End() )
	RESET ENVIRONMENT
Return nil
